---
// /get.html: where every "Get the app" button leads (REDESIGN-BRIEF, "Get the
// app button behaviour").
//
// A phone goes straight on to its own store: the visitor tapped a button or
// scanned the QR code to get here. A desktop, or anything we can't place,
// never redirects: it gets the store badges, a QR code to scan with a phone,
// and what the app does.
//
// Every link that leads here says where it came from (?src=area, finder,
// club-unclaimed, club-claimed, how-it-works, header, follow, claim, dropin,
// qr), and that is passed on to the stores as campaign data so installs can
// be traced to each button: App Store `ct`, Google Play's install referrer.
// From a club page, ?club={id} names the club on the page. The app has no
// club deep link yet, so the page never says the club will open by itself.
//
// Not an App Links path: nothing in the app handles /get.
import Directory from '../layouts/Directory.astro';
import AppFeatures from '../components/directory/AppFeatures.astro';
import { PLAY_URL, APP_STORE_URL } from '../store-links';
import { getDirectory } from '../data/directory';

const dir = await getDirectory();
// Club names by id, for the "You came from" chip.
const clubNames = Object.fromEntries(dir.clubs.map((c) => [c.id, c.name]));
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Get the app', href: '/get.html' }];
const qrSvg = (await import('../../public/get-qr.svg?raw')).default;
---

<Directory
  title="Get NextFour"
  description="Download NextFour for Android or iPhone."
  ogDescription="Find a game near you, or run your club night."
  crumbs={crumbs}
  cta={false}
  footer="site"
>
  <style>
    .get { padding: clamp(28px, 5vw, 56px) 0 8px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; }
    .lead-col { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
    .lead-col .eyebrow { margin: 0; }
    h1 { font-size: clamp(38px, 6vw, 68px); line-height: 1; font-stretch: 114%; }
    .lead { margin: 0; max-width: 560px; font-size: 18px; color: var(--body); }
    .came {
      align-self: flex-start; display: flex; align-items: center; gap: 12px; padding: 10px 16px 10px 10px;
      border-radius: 16px; background: var(--surface); border: 1px solid var(--line);
    }
    .came[hidden] { display: none; }
    .came .mark { width: 40px; height: 40px; border-radius: 10px; background: #2C5873; color: #C8F135; display: flex; align-items: center; justify-content: center; flex: none; }
    .came span.txt { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
    .came small { font-size: 13px; color: var(--muted); }
    .came b { font-weight: 800; }
    /* The official badges at their minimum sizes: Apple's is 40px tall; Google's
       image carries its own clear space, so it is drawn taller to match. */
    .stores { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
    .stores a { display: inline-flex; align-items: center; min-height: 56px; border-radius: 10px; }
    .stores img.apple { height: 54px; width: auto; }
    .stores img.google { height: 80px; width: auto; margin: -12px; }
    .how { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 700; font-size: 15px; }
    figure.qr {
      flex: 1 1 300px; max-width: 380px; margin: 0; padding: 24px; border-radius: 20px; background: var(--surface);
      border: 1px solid var(--line); display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;
    }
    /* Always on white, even in dark mode, so phone cameras can read it. */
    .qr .code { padding: 16px; border-radius: 14px; background: #FFFFFF; border: 1px solid #DCE2D8; line-height: 0; }
    .qr .code :global(svg) { width: 208px; height: 208px; display: block; }
    figcaption { display: flex; flex-direction: column; gap: 4px; }
    figcaption b { font-size: 18px; font-weight: 800; }
    figcaption span { font-size: 14px; color: var(--muted); }
    @media (max-width: 640px) {
      figure.qr { display: none; }
    }
  </style>

  <section class="get" id="get" data-clubs={JSON.stringify(clubNames)}>
    <div class="lead-col">
      <div class="came" id="came" hidden>
        <span class="mark" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a3 3 0 0 0 3-3H9a3 3 0 0 0 3 3z"></path><path d="M9 18 5 4l7 3 7-3-4 14"></path><path d="M12 7v11"></path></svg></span>
        <span class="txt"><small>You came from</small><b id="came-name"></b></span>
      </div>
      <p class="eyebrow">Get the app</p>
      <h1>Find a game near you, or run your club night.</h1>
      <p class="lead" id="lead">On iPhone and Android. Free to start: join club nights, take your turn to pick, and see who’s going.</p>
      <div class="stores">
        {APP_STORE_URL && (
          <a id="ios" href={APP_STORE_URL} aria-label="Download on the App Store, for iPhone and iPad">
            <img class="apple" src="/badges/app-store.svg" alt="" width="162" height="54" />
          </a>
        )}
        {PLAY_URL && (
          <a id="android" href={PLAY_URL} aria-label="Get it on Google Play, for Android">
            <img class="google" src="/badges/google-play.png" alt="" width="207" height="80" />
          </a>
        )}
      </div>
      <a class="how" href="/how-it-works.html">
        How it works
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
    <figure class="qr">
      <div class="code" role="img" aria-label="QR code that opens the NextFour download page" set:html={qrSvg} />
      <figcaption>
        <b>Scan with your phone's camera</b>
        <span>It opens the right store for your phone.</span>
      </figcaption>
    </figure>
  </section>

  <AppFeatures band={false} />

  <script is:inline define:vars={{ PLAY_URL, APP_STORE_URL }}>
    (() => {
      const params = new URLSearchParams(location.search);
      // Sources are short words; anything else is dropped rather than passed on.
      const raw = params.get('src') ?? '';
      const src = /^[a-z0-9-]{1,32}$/.test(raw) ? raw : 'get-page';
      const ios = APP_STORE_URL && `${APP_STORE_URL}?ct=${encodeURIComponent(src)}`;
      const android = PLAY_URL && `${PLAY_URL}&referrer=${encodeURIComponent(`utm_source=nextfour_web&utm_campaign=${src}`)}`;
      if (ios) document.getElementById('ios').href = ios;
      if (android) document.getElementById('android').href = android;

      // A phone goes straight on to its store. iPadOS reports itself as a Mac,
      // so a Mac with a touch screen is an iPad. A desktop never redirects.
      const ua = navigator.userAgent;
      const isApple = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
      const target = /Android/.test(ua) ? android : isApple ? ios : null;
      if (target) { location.replace(target); return; }

      // Arrived from a club page: name the club.
      const clubs = JSON.parse(document.getElementById('get').dataset.clubs || '{}');
      const name = clubs[params.get('club') ?? ''];
      if (name) {
        document.getElementById('came-name').textContent = name;
        document.getElementById('came').hidden = false;
        document.getElementById('lead').textContent = `Install NextFour, then follow ${name} to see its sessions and who’s going.`;
      }
    })();
  </script>
</Directory>
