---
// One page per council area with at least two listings (clubs and venues
// with drop-in sessions): /badminton/<area>.html, written for "badminton in
// <town>" searches.
//
// Clubs first, then drop-in sessions: leisure operators' sessions anyone can
// book onto, listed by venue (DropInCard). One static list, never paginated.
// The night picker runs in the browser and only hides cards and dims rows,
// so every listing is in the HTML for crawlers.
import Directory from '../../layouts/Directory.astro';
import ClubCard from '../../components/directory/ClubCard.astro';
import DropInCard from '../../components/directory/DropInCard.astro';
import {
  getDirectory, nearbyLinks, weeklyNights, newestCheck, checkedText, weeklyDropIns, groupedRows, dropInRows,
  nextDate, fitTitle, fitDescription, DAY_NAMES, SHORT_DAYS, WEEK_ORDER, type Area,
} from '../../data/directory';

export async function getStaticPaths() {
  const dir = await getDirectory();
  return dir.areas.filter((a) => a.hasPage).map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props as { area: Area };
const dir = await getDirectory();
const nights = weeklyNights(area.clubs);
const dropIns = weeklyDropIns(area.dropIns);
// The night picker counts listings, as the finder does: how many clubs play
// each night, and how many venues hold a drop-in that night. A tile always
// gives its count a word ("5 clubs"), so it never reads as a date.
const clubsOn = [0, 1, 2, 3, 4, 5, 6].map((d) => area.clubs.filter((c) => groupedRows(c).some((r) => r.days.includes(d))).length);
const dropsOn = [0, 1, 2, 3, 4, 5, 6].map((d) => area.dropIns.filter((v) => dropInRows(v).some((r) => r.days.includes(d))).length);
const counted = (clubs: number, drops: number) => [
  clubs ? `${clubs} club${clubs === 1 ? '' : 's'}` : '',
  drops ? `${drops} drop-in${drops === 1 ? '' : 's'}` : '',
].filter(Boolean).join(' and ');
const tile = (d: number) => {
  const [c, v] = [clubsOn[d], dropsOn[d]];
  if (c) return { n: c, word: c === 1 ? 'club' : 'clubs', plus: v ? `+${v} drop-in${v === 1 ? '' : 's'}` : '' };
  if (v) return { n: v, word: v === 1 ? 'drop-in' : 'drop-ins', plus: '' };
  return { n: 0, word: 'none', plus: '' };
};
const nearby = nearbyLinks(dir, area);
const kmText = (km: number) => (km < 1 ? 'Under 1 km' : `${Math.round(km)} km`);
const site = Astro.site!;
const newest = newestCheck(area.clubs);
const checked = checkedText(newest);
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
// The week in one line, in place of a stat card: the night picker below already counts each day.
const facts = area.clubs.length > 0
  ? `${plural(area.clubs.length, 'club')} with ${plural(nights, 'night')} a week${dropIns > 0 ? `, plus ${plural(dropIns, 'drop-in session')}` : ''}`
  : dropIns > 0 ? `${plural(dropIns, 'drop-in session')} a week` : '';
const title = fitTitle(area.clubs.length
  ? [
    `Badminton in ${area.name}: ${area.clubs.length} clubs and club nights | NextFour`,
    `Badminton in ${area.name}: ${area.clubs.length} clubs | NextFour`,
    `Badminton in ${area.name} | NextFour`,
    `Badminton in ${area.name}`,
  ]
  : [`Badminton in ${area.name}: drop-in sessions | NextFour`, `Badminton in ${area.name} | NextFour`, `Badminton in ${area.name}`]);
const what = [
  area.clubs.length ? `${plural(area.clubs.length, 'club')} and ${plural(nights, 'club night')} a week` : '',
  dropIns ? `${plural(dropIns, 'drop-in session')} you can book` : '',
].filter(Boolean).join(', plus ');
const description = fitDescription([
  `Where to play badminton in ${area.name}: ${what}.`,
  'Days, times, venues and levels.',
  checked ? `Updated ${checked}.` : '',
]);

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Badminton clubs in ${area.name}`,
  numberOfItems: area.clubs.length,
  itemListElement: area.clubs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(c.url, site).href,
    name: c.name,
  })),
};

// Each weekly drop-in as an event series, with its price (the site rebuilds
// nightly, so the next date stays true).
const today = new Date();
const dropInLd = area.dropIns.flatMap((v) => v.sessions.flatMap((s) => s.night.days.map((d) => ({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${s.title} at ${v.venueName}`,
  sport: 'Badminton',
  startDate: `${nextDate(d, today)}T${s.night.start}`,
  ...(s.night.end ? { endDate: `${nextDate(d, today)}T${s.night.end}` } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventSchedule: {
    '@type': 'Schedule', repeatFrequency: 'P1W', byDay: `https://schema.org/${DAY_NAMES[d]}`,
    startTime: s.night.start, ...(s.night.end ? { endTime: s.night.end } : {}), scheduleTimezone: 'Europe/London',
  },
  location: {
    '@type': 'SportsActivityLocation', name: v.venueName,
    ...(v.venue.address ? { address: v.venue.address } : {}),
    geo: { '@type': 'GeoCoordinates', latitude: v.venue.lat, longitude: v.venue.lng },
  },
  ...(v.operators.length ? { organizer: { '@type': 'Organization', name: v.operators[0] } } : {}),
  ...(s.night.price ? {
    offers: {
      '@type': 'Offer', price: s.night.price.replace(/[^0-9.]/g, ''), priceCurrency: 'GBP',
      ...(s.bookingUrl ? { url: s.bookingUrl } : {}), availability: 'https://schema.org/InStock',
    },
  } : {}),
  url: new URL(v.venueUrl, site).href,
}))));

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Badminton', href: '/badminton.html' },
  { name: area.name, href: area.url },
];
const allHeading = `${plural(area.clubs.length, 'club')}, ${plural(nights, 'night')} a week`;
---

<Directory title={title} description={description} crumbs={crumbs} jsonLd={[...(area.clubs.length ? [listLd] : []), ...dropInLd]}>
  <style>
    h1 { font-size: clamp(44px, 7vw, 84px); line-height: 0.95; font-stretch: 118%; }
    /* The sport, as the heading's own first line: smaller, so the place leads. */
    .h1-lead { display: block; margin-bottom: 0.12em; font-size: 0.4em; font-weight: 700; font-stretch: 106%; line-height: 1.1; color: var(--eyebrow); }
    .week-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
    .week-top h2 { margin: 0; font-size: 18px; font-weight: 700; }
    .any {
      min-height: 44px; padding: 0 18px; border-radius: 999px; font-size: 15px; font-weight: 700; cursor: pointer;
      border: 1.5px solid var(--ink); background: var(--surface); color: var(--ink);
    }
    .any[aria-pressed='true'] { border-color: var(--sel-bg); background: var(--sel-bg); color: var(--sel-fg); }
    .days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
    .day {
      min-height: 92px; padding: 12px 4px; border-radius: 14px; cursor: pointer;
      display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 8px;
      border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--ink);
    }
    .day .short { font-size: 14px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .day .count { font-size: 28px; font-weight: 800; font-stretch: 112%; line-height: 1; font-variant-numeric: tabular-nums; }
    .day .unit { font-size: 13px; font-weight: 600; line-height: 1.1; }
    .day .plus { font-size: 12px; line-height: 1.1; color: var(--muted); }
    /* A night with nothing: solid colours, never faded, so it still reads. */
    .day.none { background: var(--bg); color: var(--empty-day); border-color: var(--line); border-style: dashed; }
    .day.none .count { visibility: hidden; }
    .day[aria-pressed='true'] { background: var(--sel-bg); color: var(--sel-fg); border-color: var(--sel-bg); }
    .day[aria-pressed='true'] .plus { color: inherit; }
    .results { padding: 40px 0 24px; }
    .results-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 20px; }
    .results-top p { margin: 0; font-size: 14px; color: var(--muted); }
    .clubs { display: flex; flex-direction: column; gap: 16px; }
    .empty {
      border: 1.5px dashed var(--line-strong); border-radius: 20px; padding: 40px 24px; text-align: center;
      background: var(--surface); margin-bottom: 16px;
    }
    .empty[hidden], #club-list[hidden], .dropins[hidden] { display: none; }
    .empty .what { margin: 0; font-size: 20px; font-weight: 700; }
    .empty .try { margin: 8px 0 20px; color: var(--muted); }
    .empty .go { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
    .dropins { padding: 8px 0 24px; }
    /* Nearby: area pages and, from areas too small for one, single clubs and venues, each with its distance. */
    .near-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; margin-bottom: 16px; }
    .near-top h2 { margin: 0; }
    .near-search { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 15px; min-height: 24px; }
    .near-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }
    .near-list a {
      height: 100%; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px;
      background: var(--surface); border: 1px solid var(--line); border-radius: 12px; text-decoration: none;
    }
    .near-list a:hover { border-color: var(--line-strong); }
    .near-list b { display: block; font-weight: 700; line-height: 1.3; }
    .near-list small { display: block; margin-top: 2px; font-size: 13px; color: var(--muted); }
    .near-list .dist {
      flex: 0 0 auto; font-size: 12px; font-weight: 800; padding: 3px 9px; border-radius: 999px;
      background: var(--tag-bg); color: var(--tag-fg); font-variant-numeric: tabular-nums; white-space: nowrap;
    }
    .dropins .lede { margin: 6px 0 20px; color: var(--body); max-width: 640px; }
    @media (max-width: 560px) {
      .days { gap: 5px; }
      .day { min-height: 78px; padding: 10px 2px; border-radius: 12px; }
      .day .short { font-size: 12px; }
      .day .count { font-size: 22px; }
      /* The word stays on a phone, set narrower; the drop-ins aside goes (the label and heading carry it). */
      .day .unit { font-size: 12px; font-stretch: 78%; }
      .day .plus { display: none; }
    }
  </style>

  <section class="hero">
    <div>
      <h1><span class="h1-lead">Badminton in</span> {area.name}</h1>
      <p class="intro">
        Where to play badminton in {area.name} this week.{' '}
        {area.clubs.length > 0 ? 'Every club below shows its nights, times, venue and playing level.' : 'Drop-in sessions below show their days, times and prices.'}
      </p>
      <p class="week-line">
        {facts && <span>{facts[0].toUpperCase() + facts.slice(1)}.</span>}
        {newest && <span>Last checked {newest.getDate()} {MONTHS[newest.getMonth()]} {newest.getFullYear()}.</span>}
      </p>
    </div>
  </section>

  <section class="panel" aria-labelledby="week-h">
    <div class="week-top">
      <h2 id="week-h">Pick a night</h2>
      <button type="button" class="any" data-day="" aria-pressed="true">Any day</button>
    </div>
    <div class="days">
      {WEEK_ORDER.map((d) => (
        <button type="button" class:list={['day', { none: clubsOn[d] + dropsOn[d] === 0 }]} data-day={d} aria-pressed="false"
          aria-label={`${DAY_NAMES[d]}: ${counted(clubsOn[d], dropsOn[d]) || 'nothing listed'}`}>
          <span class="short">{SHORT_DAYS[d]}</span>
          <span class="count">{tile(d).n}</span>
          <span class="unit">{tile(d).word}</span>
          {/* Every tile keeps the aside's line, so the counts sit level. */}
          <span class="plus">{tile(d).plus || ' '}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="results" aria-labelledby="results-h">
    {area.clubs.length > 0 && (
      <div class="results-top">
        <h2 class="h-results" id="results-h" aria-live="polite">{allHeading}</h2>
        <p id="sorted">Sorted by club name</p>
      </div>
    )}

    <div class="empty" id="empty" hidden>
      <p class="what">Nothing listed in {area.name} on <span id="empty-day"></span></p>
      <p class="try">Try another night, or somewhere nearby.</p>
      <div class="go">
        {nearby.slice(0, 3).map((a) => <a class="btn" href={a.url}>{a.name}</a>)}
      </div>
    </div>

    {area.clubs.length > 0 && (
      <div id="club-list">
        <div class="clubs">
          {area.clubs.map((c) => <ClubCard club={c} />)}
        </div>
        <p class="note">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
          Level bars run Beginner, Intermediate, Advanced. Times come from each club's published information.
        </p>
      </div>
    )}
  </section>

  {area.dropIns.length > 0 && (
    <section class="dropins" aria-labelledby="dropins-h">
      <h2 class="h-results" id="dropins-h">Drop-in sessions in {area.name}</h2>
      <p class="lede">Sessions you can turn up to without joining a club. Book and pay for each one with the venue.</p>
      <div class="clubs">
        {area.dropIns.map((v) => <DropInCard venue={v} />)}
      </div>
    </section>
  )}

  {nearby.length > 0 && (
    <section class="near" aria-labelledby="near-h">
      <div class="near-top">
        <h2 class="h-section" id="near-h">Badminton near {area.name}</h2>
        <a class="near-search" href={`/badminton.html#q=${encodeURIComponent(area.name)}`}>
          Search everything within 25 km
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <ul class="near-list">
        {nearby.map((l) => (
          <li><a href={l.url}><span><b>{l.name}</b><small>{l.sub}</small></span><span class="dist">{kmText(l.km)}</span></a></li>
        ))}
      </ul>
    </section>
  )}

  <script define:vars={{ allHeading, dayNames: DAY_NAMES }}>
    // The night picker: it only hides cards and dims rows, so every listing
    // stays in the HTML. The picked night lives in the URL (#day=4), so Back
    // from a club page and a shared link both bring it back.
    const buttons = document.querySelectorAll('button[data-day]');
    const heading = document.getElementById('results-h');
    const empty = document.getElementById('empty');
    const clubList = document.getElementById('club-list');
    const dropSection = document.querySelector('.dropins');
    const clubCards = clubList ? [...clubList.querySelectorAll('.club-card')] : [];
    const dropCards = dropSection ? [...dropSection.querySelectorAll('.club-card')] : [];
    const plays = (el, day) => (el.dataset.days ?? '').split(',').includes(day);
    const counted = (clubs, drops) => [
      clubs ? `${clubs} club${clubs === 1 ? '' : 's'}` : '',
      drops ? `${drops} drop-in${drops === 1 ? '' : 's'}` : '',
    ].filter(Boolean).join(' and ');

    function pick(day) {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.day === day)));
      let clubs = 0;
      let drops = 0;
      for (const c of [...clubCards, ...dropCards]) {
        const on = day === '' || plays(c, day);
        c.hidden = !on;
        if (on) { if (c.classList.contains('dropin')) drops++; else clubs++; }
        c.querySelectorAll('.night-line').forEach((l) => {
          const match = day === '' || plays(l, day);
          l.classList.toggle('dim', !match);
          l.classList.toggle('hl', match && day !== '');
          l.querySelectorAll('.ds-cell').forEach((cell) => cell.classList.toggle('hl', cell.dataset.d === day));
        });
      }
      // A section with nothing left in it goes, heading and all.
      if (clubList) clubList.hidden = clubs === 0;
      const sorted = document.getElementById('sorted');
      if (sorted) sorted.hidden = clubs === 0;
      if (dropSection) dropSection.hidden = dropCards.length > 0 && drops === 0;
      const name = day === '' ? '' : dayNames[Number(day)];
      if (heading) heading.textContent = day === '' ? allHeading : clubs + drops ? `${counted(clubs, drops)} on ${name}s` : `Nothing listed on ${name}s`;
      document.getElementById('empty-day').textContent = `${name}s`;
      empty.hidden = clubs + drops > 0;
      history.replaceState(history.state, '', `${location.pathname}${location.search}${day === '' ? '' : `#day=${day}`}`);
    }

    buttons.forEach((b) => b.addEventListener('click', () => pick(b.dataset.day ?? '')));
    const saved = new URLSearchParams(location.hash.slice(1)).get('day');
    if (saved && [...buttons].some((b) => b.dataset.day === saved)) pick(saved);
  </script>
</Directory>
