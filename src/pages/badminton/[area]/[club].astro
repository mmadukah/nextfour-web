---
// One page per published club: /badminton/<area>/<club>.html
//
// Shows what a player needs before turning up (nights, times, venue, level,
// visitor terms, whether it is taking new players) and when that was last
// checked. Contact details stay in the app; the club's own site and social
// pages are linked instead. The summary is written here from the facts,
// never the stored description, which can name where the club was found.
import Directory from '../../../layouts/Directory.astro';
import AppCta from '../../../components/directory/AppCta.astro';
import NightLine from '../../../components/directory/NightLine.astro';
import {
  getDirectory, clubDaysText, checkedText, shortDate, townOf, nearbyClubs, nextDate,
  sortedRows, clubPhoto, DAY_NAMES, type Club,
} from '../../../data/directory';

export async function getStaticPaths() {
  const dir = await getDirectory();
  return dir.clubs.map((club) => ({
    params: { area: club.areaSlug, club: club.slug },
    props: { club },
  }));
}

const { club } = Astro.props as { club: Club };
const dir = await getDirectory();
const area = dir.areas.find((a) => a.slug === club.areaSlug)!;
const town = townOf(club.venue, club.areaName);
const days = clubDaysText(club);
const checked = checkedText(club.lastChecked);
const nearby = nearbyClubs(dir, club);
const site = Astro.site!;
const pageUrl = new URL(club.url, site).href;

const venues = [...new Map(club.nights.map((n) => [n.venue.name, n.venue])).values()];
const otherVenues = venues.filter((v) => v.name !== club.venue.name);

const title = `${club.name}, ${town} | Badminton club nights and times`;
const description = [
  `${club.name} plays badminton at ${club.venue.name}${days ? ` on ${days}` : ''}.`,
  'Times, levels, visitor terms and how to join.',
  checked ? `Checked ${checked}.` : '',
].filter(Boolean).join(' ');

const summary = [
  `${club.name} is a badminton club in ${club.areaName}.`,
  `It plays at ${club.venue.name}${otherVenues.length ? ` and ${otherVenues.length === 1 ? otherVenues[0].name : `${otherVenues.length} other venues`}` : ''}${days ? ` on ${days}` : ''}.`,
  club.levels !== 'All levels' ? `Sessions are for ${club.levels.toLowerCase()} players.` : '',
  club.courts ? `It plays on ${club.courts} court${club.courts === 1 ? '' : 's'}.` : '',
].filter(Boolean).join(' ');

const rows = sortedRows(club);
const photo = clubPhoto(club.id);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${club.venue.lat},${club.venue.lng}`;
const correction = `mailto:clubs@nextfour.app?subject=${encodeURIComponent(`Correction: ${club.name}`)}&body=${encodeURIComponent(`Page: ${pageUrl}\n\nWhat needs changing:\n`)}`;

// schema.org: the club, where it plays, and each weekly night as an event
// series with its next date (the site rebuilds nightly, so it stays true).
const today = new Date();
const placeLd = (v: typeof club.venue) => ({
  '@type': 'SportsActivityLocation',
  name: v.name,
  ...(v.address ? { address: v.address } : {}),
  geo: { '@type': 'GeoCoordinates', latitude: v.lat, longitude: v.lng },
});
const clubLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  '@id': `${pageUrl}#club`,
  name: club.name,
  url: pageUrl,
  sport: 'Badminton',
  description: summary,
  location: placeLd(club.venue),
  ...(club.venue.address ? { address: club.venue.address } : {}),
  geo: { '@type': 'GeoCoordinates', latitude: club.venue.lat, longitude: club.venue.lng },
  ...(club.links.length ? { sameAs: club.links.map((l) => l.href) } : {}),
  areaServed: club.areaName,
};
const eventsLd = club.nights.filter((n) => n.days.length > 0).flatMap((n) => n.days.map((d) => ({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${club.name}: ${DAY_NAMES[d]} club night`,
  sport: 'Badminton',
  startDate: `${nextDate(d, today)}T${n.start}`,
  ...(n.end ? { endDate: `${nextDate(d, today)}T${n.end}` } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventSchedule: {
    '@type': 'Schedule',
    repeatFrequency: 'P1W',
    byDay: `https://schema.org/${DAY_NAMES[d]}`,
    startTime: n.start,
    ...(n.end ? { endTime: n.end } : {}),
    scheduleTimezone: 'Europe/London',
  },
  location: placeLd(n.venue),
  organizer: { '@type': 'SportsOrganization', name: club.name, url: pageUrl },
  url: pageUrl,
})));

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Badminton', href: '/badminton.html' },
  ...(area.hasPage ? [{ name: area.name, href: area.url }] : []),
  { name: club.name, href: club.url },
];
---

<Directory title={title} description={description} crumbs={crumbs} jsonLd={[clubLd, ...eventsLd]} cta={false}>
  <style>
    .badges { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; }
    .banner {
      display: block; width: 100%; height: 240px; object-fit: cover; border-radius: 18px; margin-top: 28px;
      border: 1px solid var(--border);
    }
    .lines { display: grid; gap: 8px; }
    .grid2 { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-top: 14px; }
    .grid2 h3 { margin: 0 0 10px; font-family: var(--head); font-weight: 800; font-size: 1.05rem; }
    dl { margin: 0; }
    dt { font-weight: 800; margin-top: 12px; }
    dt:first-child { margin-top: 0; }
    dd { margin: 2px 0 0; color: var(--muted); }
    .venue-actions { margin: 14px 0 0; }
    .contact { display: flex; flex-wrap: wrap; gap: 10px; }
    .run { margin-top: 14px; }
    @media (max-width: 640px) {
      .banner { height: 170px; }
    }
  </style>

  <section class="hero">
    <div>
      <p class="eyebrow">Badminton club · {club.areaName}</p>
      <h1 class="long">{club.name}</h1>
      <p class="lead">{summary}</p>
      <div class="badges">
        {club.claimed && <span class="tag lime">Runs its nights on NextFour</span>}
        {!club.takingNewPlayers && <span class="tag warn">Not taking new players right now</span>}
        {club.visitorPolicy ? <span class="tag ok">Visitor terms listed</span> : <span class="tag">No visitor info yet</span>}
      </div>
    </div>
    <div class="stats">
      <div><span>Nights a week</span><b>{rows.filter((r) => r.night.days.length).length}</b></div>
      {club.courts && <div><span>Courts</span><b>{club.courts}</b></div>}
      {club.lastChecked && <div><span>Checked</span><b class="text">{shortDate(club.lastChecked)}</b></div>}
    </div>
  </section>

  <img class="banner" src={photo.src} alt="" width="720" height="480" style={`object-position: ${photo.position}`} />

  <h2>Club nights</h2>
  <div class="card lines">
    {rows.map((row) => <NightLine row={row} clubVenue={club.venue.name} detail clubTakesNewPlayers={club.takingNewPlayers} />)}
  </div>
  <p class="note">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 11v6M12 7.5v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    Level bars run Beginner, Intermediate, Advanced.{checked ? ` Last checked ${checked}.` : ''}
  </p>

  <div class="grid2">
    <section class="card">
      <h3>Visitors and costs</h3>
      <dl>
        {!club.takingNewPlayers && (<><dt>New players</dt><dd>Not taking new players right now.</dd></>)}
        <dt>Visitors</dt><dd>{club.visitorPolicy ?? 'The club has not published visitor terms yet. Ask the club before you go.'}</dd>
        {club.fees && (<><dt>Costs</dt><dd>{club.fees}</dd></>)}
      </dl>
    </section>
    <section class="card">
      <h3>{venues.length === 1 ? 'Venue' : 'Venues'}</h3>
      <dl>
        {venues.map((v) => (
          <>
            <dt>{v.name}</dt>
            {v.address && <dd>{v.address}</dd>}
          </>
        ))}
      </dl>
      <p class="venue-actions"><a class="btn" href={mapsUrl} rel="noopener" target="_blank">Directions</a></p>
    </section>
  </div>

  {club.links.length > 0 && (
    <>
      <h2>Contact the club</h2>
      <p class="contact">
        {club.links.map((l) => <a class="btn" href={l.href} rel="noopener" target="_blank">{l.label}</a>)}
      </p>
    </>
  )}

  <AppCta
    heading={club.claimed ? `Join ${club.name} in the app.` : "See who's going before you go."}
    text={club.claimed
      ? "See who's going tonight, ask to join, and get your turn to pick on your phone. Find the club in the app after installing."
      : `Follow ${club.name} in the NextFour app to hear when it adds a session, and find other club nights near you.`}
  />
  <p class="muted small run">
    {club.claimed
      ? <>Run this club? Edit its nights in the NextFour app.</>
      : <>Run this club? Claim it in the app to keep these times right and run your club night with a digital pegboard. Running a pegboard night is free. <a href="/how-it-works.html">How it works</a></>}
  </p>

  {nearby.length > 0 && (
    <>
      <h2>Other badminton clubs nearby</h2>
      <nav class="links" aria-label="Nearby clubs">
        {nearby.map(({ club: c, km }) => (
          <a href={c.url}><span>{c.name}<small>{c.areaName}, {km < 1 ? 'under 1' : Math.round(km)} km</small></span></a>
        ))}
      </nav>
      {area.hasPage && <p><a href={area.url}>All badminton in {area.name}</a></p>}
    </>
  )}

  <p class="small muted" style="margin-top: 32px">
    Something wrong on this page? <a href={correction}>Suggest a correction</a>.
  </p>
</Directory>
