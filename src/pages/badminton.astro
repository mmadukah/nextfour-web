---
// /badminton.html: the club finder, and the hub every area page hangs off.
//
// Search runs in the browser over /badminton/search-index.json. A postcode is
// placed with /postcode-districts.json (shipped with the site, OGL), so it
// never leaves the visitor's device; "Near me" uses the browser's location
// prompt. Below the finder, every area and club is a plain link, so crawlers
// reach every page without running any script: the country tabs only hide
// the other countries once the script runs.
import Directory from '../layouts/Directory.astro';
import AppFeatures from '../components/directory/AppFeatures.astro';
import { getDirectory, weeklyNights, weeklyDropIns, TINTS as COURT_TINTS, type Area } from '../data/directory';

const dir = await getDirectory();
const withPage = dir.areas.filter((a) => a.hasPage);
const single = dir.areas.filter((a) => !a.hasPage).flatMap((a) => a.clubs).sort((a, b) => a.name.localeCompare(b.name));
const byLetter = (areas: Area[]) => {
  const groups = new Map<string, Area[]>();
  for (const a of areas) {
    const letter = a.name[0].toUpperCase();
    groups.set(letter, [...(groups.get(letter) ?? []), a]);
  }
  return [...groups].map(([letter, list]) => ({ letter, areas: list }));
};
const nations = ['England', 'Scotland', 'Wales', 'Northern Ireland']
  .map((n) => ({ name: n, groups: byLetter(withPage.filter((a) => a.nation === n)) }))
  .filter((n) => n.groups.length > 0);
const nights = weeklyNights(dir.clubs);
// Changes every build, so a browser never pairs this page with a cached index
// from an earlier build (the host lets browsers keep it for ten minutes).
const build = Date.now().toString(36);
const site = Astro.site!;

const title = 'Badminton clubs near you: find a club night | NextFour';
const description =
  `Find badminton near you: ${dir.clubs.length} clubs and ${nights} weekly club nights across the UK, ` +
  'with days, times, venues, levels and visitor terms. Search by postcode or town.';

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Badminton clubs in the UK',
  url: new URL('/badminton.html', site).href,
  description,
};
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Badminton', href: '/badminton.html' },
];
const NIGHTS = [['1', 'Mon'], ['2', 'Tue'], ['3', 'Wed'], ['4', 'Thu'], ['5', 'Fri'], ['6', 'Sat'], ['0', 'Sun']];
const LEVELS = [['', 'Any level'], ['1', 'Beginner'], ['2', 'Intermediate'], ['3', 'Upper intermediate'], ['4', 'Advanced']];
const KINDS = [['', 'Any'], ['club', 'Clubs'], ['dropin', 'Drop-in']];
const dropInCount = weeklyDropIns(dir.dropIns);
---

<Directory title={title} description={description} crumbs={crumbs} jsonLd={[siteLd]} cta={false} current="finder">
  <style>
    .top { padding: 28px 0 32px; }
    h1 { max-width: 820px; font-size: clamp(40px, 6.5vw, 76px); line-height: 0.98; font-stretch: 116%; }
    .intro { max-width: 620px; }
    form { margin-top: 32px; display: flex; flex-direction: column; gap: 20px; }
    .query { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; }
    .field { flex: 999 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
    .field label { font-size: 14px; font-weight: 700; }
    .box {
      display: flex; align-items: center; gap: 10px; height: 56px; padding: 0 6px 0 16px; border-radius: 14px;
      border: 1.5px solid var(--line-strong); background: var(--bg);
    }
    .box:focus-within { border-color: var(--eyebrow); }
    .box > svg { color: var(--muted); flex: 0 0 auto; }
    .box input {
      flex: 1 1 auto; min-width: 0; border: 0; outline: none; background: transparent; color: var(--ink);
      font-size: 17px; height: 100%;
    }
    /* A search box, not an address form: no autofill colouring, no clear button. */
    .box input:-webkit-autofill, .box input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0 100px var(--bg) inset; -webkit-text-fill-color: var(--ink); caret-color: var(--ink);
      transition: background-color 9999s;
    }
    .box input::-webkit-search-cancel-button { -webkit-appearance: none; }
    /* Near me sits inside the box, as an icon button. */
    .box .icon {
      position: relative; flex: none; width: 44px; height: 44px; border-radius: 10px; border: 0; padding: 0; cursor: pointer;
      display: grid; place-items: center; background: transparent; color: var(--ink);
    }
    .box .icon:hover { background: var(--row); }
    .box .icon:focus-visible { outline: 2px solid var(--eyebrow); outline-offset: 1px; }
    /* Filters: a square beside the box that opens the filters below it. */
    #filters-btn {
      position: relative; flex: none; width: 56px; height: 56px; border-radius: 14px; padding: 0; cursor: pointer;
      display: grid; place-items: center; border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--ink);
    }
    #filters-btn:hover { border-color: var(--ink); }
    #filters-btn[aria-expanded='true'] { border-color: var(--sel-bg); }
    /* On: searching around the visitor's location; open: the filters showing. */
    #near[aria-pressed='true'], #filters-btn[aria-expanded='true'] { background: var(--sel-bg); color: var(--sel-fg); }
    #near[aria-busy='true'] { cursor: progress; }
    #near[aria-busy='true'] svg { animation: near-spin 1s linear infinite; }
    @keyframes near-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { #near[aria-busy='true'] svg { animation: none; } }
    #filters-n:empty { display: none; }
    #filters-n {
      position: absolute; top: -6px; right: -6px; min-width: 20px; height: 18px; padding: 0 4px; border-radius: 999px;
      height: 20px; background: var(--hl-bg); color: var(--hl-fg); font-size: 12px; font-weight: 800; display: grid; place-items: center;
      box-shadow: 0 0 0 2px var(--surface);
    }
    #search {
      flex: 1 1 120px; height: 56px; border-radius: 14px; cursor: pointer; white-space: nowrap;
      padding: 0 28px; border: 0; background: var(--hl-bg); color: var(--hl-fg); font-size: 16px; font-weight: 800;
    }
    /* The week: one tile per night with how many listings usually play it. */
    #refine { margin: 0 0 20px; display: flex; flex-direction: column; gap: 14px; }
    #refine[hidden] { display: none; }
    .week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
    .week[hidden] { display: none; }
    .night {
      min-height: 72px; padding: 8px 4px; border-radius: 14px; cursor: pointer; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 2px; border: 1.5px solid var(--line-strong);
      background: var(--surface); color: var(--ink); font-variant-numeric: tabular-nums;
    }
    .night b { font-size: 16px; font-weight: 800; font-stretch: 106%; }
    /* The count stays smaller than the night, and always has its word. */
    .night .tc { font-size: 13px; font-weight: 500; line-height: 1.15; text-align: center; }
    /* The count is written by the script, so outside this file's scope. */
    .night .tc :global(.tn) { font-weight: 800; }
    .night .tc :global(.tw) { white-space: nowrap; }
    /* Seven across a phone: a little less gap, and the word set narrower. */
    @media (max-width: 480px) {
      .week { gap: 4px; }
      .night { padding: 8px 2px; }
      .night .tc :global(.tw) { font-stretch: 78%; }
      .night .tc :global(.tn) { display: block; }
    }
    .night[aria-pressed='true'] { background: var(--sel-bg); border-color: var(--sel-bg); color: var(--sel-fg); }
    .night:disabled { cursor: default; background: transparent; border-style: dashed; color: var(--empty-day); }
    .night.zero .tc { font-weight: 600; }
    .usual { margin: 0; font-size: 14px; color: var(--muted); max-width: 62ch; }
    .filters { display: flex; flex-wrap: wrap; gap: 20px 32px; padding-top: 18px; border-top: 1px solid var(--line); }
    .filters[hidden] { display: none; }
    fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
    fieldset.levels { flex: 1 1 360px; }
    legend { font-size: 14px; font-weight: 700; margin-bottom: 10px; padding: 0; }
    .pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .pill {
      min-height: 44px; min-width: 52px; padding: 0 14px; border-radius: 999px; font-size: 14px; font-weight: 700; cursor: pointer;
      border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--ink);
    }
    .pill[aria-pressed='true'] { border-color: var(--sel-bg); background: var(--sel-bg); color: var(--sel-fg); }
    .switch-row { flex: 1 1 100%; display: flex; align-items: center; gap: 12px; }
    .switch-row label { font-size: 15px; font-weight: 600; cursor: pointer; }
    #open {
      width: 52px; height: 32px; border-radius: 999px; border: 0; padding: 3px; cursor: pointer;
      background: var(--seg-off); display: flex; justify-content: flex-start; flex: none;
    }
    #open span { width: 26px; height: 26px; border-radius: 999px; background: var(--surface); transition: transform 0.15s; }
    #open[aria-pressed='true'] { background: var(--seg-on); }
    #open[aria-pressed='true'] span { transform: translateX(20px); }

    #status { margin: 8px 0 16px; font-size: 22px; font-weight: 800; font-stretch: 106%; scroll-margin-top: 24px; }
    #status:focus { outline: none; }
    #status:empty { display: none; }
    /* The cards themselves: src/styles/club-card.css, shared with the area pages. */
    #results { list-style: none; padding: 0; margin: 0 0 48px; display: flex; flex-direction: column; gap: 16px; }
    #results:empty { display: none; }

    section.browse, section.more { padding: 32px 0 40px; border-top: 1px solid var(--line); }
    .browse-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
    .tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); }
    .tabs button {
      min-height: 40px; padding: 0 18px; border-radius: 999px; border: 0; font-size: 15px; font-weight: 700; cursor: pointer;
      background: transparent; color: var(--ink);
    }
    .tabs button[aria-pressed='true'] { background: var(--sel-bg); color: var(--sel-fg); }
    .nation { display: flex; flex-direction: column; gap: 28px; }
    .nation + .nation { margin-top: 40px; }
    .nation[hidden] { display: none; }
    .nation > h3 { margin: 0; font-size: 20px; font-weight: 800; }
    .group { display: flex; flex-wrap: wrap; gap: 12px 24px; }
    .letter { flex: 0 0 56px; font-size: 40px; font-weight: 800; font-stretch: 118%; line-height: 1; color: var(--eyebrow); }
    .group ul { flex: 999 1 400px; min-width: 0; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; }
    .group a {
      display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px;
      border-radius: 12px; background: var(--surface); border: 1px solid var(--line); text-decoration: none;
    }
    .group a span:first-child { font-weight: 600; min-width: 0; }
    .count {
      flex: 0 0 auto; font-size: 13px; font-weight: 700; padding: 2px 9px; border-radius: 999px;
      background: var(--row); color: var(--muted); font-variant-numeric: tabular-nums;
    }
    .more p { margin: 0 0 16px; color: var(--muted); font-size: 15px; }
    .more ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 0 32px; }
    .more li { border-bottom: 1px solid var(--line); }
    .more a { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 0; text-decoration: none; }
    .more a b { display: block; font-weight: 700; }
    .more a small { display: block; font-size: 14px; color: var(--muted); }
    #browse[hidden] { display: none; }
    @media (max-width: 400px) {
      .more ul { grid-template-columns: 1fr; }
    }
  </style>

  <section class="top">
    <p class="eyebrow">Badminton club finder</p>
    <h1>Find badminton near you</h1>
    <p class="intro">{dir.clubs.length} clubs and {nights} club nights a week across the UK, each with its days, times, venue and level{dropInCount > 0 ? `, plus ${dropInCount} drop-in sessions you can book` : ''}.</p>

    <form class="panel" id="find" role="search">
      <div class="query">
        <div class="field">
          <label for="q">Postcode, town or club name</label>
          <div class="box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input id="q" name="q" type="search" placeholder="e.g. SM1 or Sutton" autocomplete="off" spellcheck="false" data-lpignore="true" data-1p-ignore data-form-type="other" />
            <button type="button" class="icon" id="near" aria-pressed="false" aria-label="Near me" title="Near me">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
            </button>
          </div>
        </div>
        <button type="button" id="filters-btn" aria-expanded="false" aria-controls="filters" aria-label="Filters" title="Filters">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg>
          <span id="filters-n"></span>
        </button>
        <button type="submit" id="search">Search</button>
      </div>
      <div class="filters" id="filters" hidden>
        <fieldset class="levels">
          <legend>Level</legend>
          <div class="pills" data-filter="level">
            {LEVELS.map(([v, label]) => <button type="button" class="pill" data-value={v} aria-pressed={v === '' ? 'true' : 'false'}>{label}</button>)}
          </div>
        </fieldset>
        <fieldset class="kinds">
          <legend>Type</legend>
          <div class="pills" data-filter="kind">
            {KINDS.map(([v, label]) => <button type="button" class="pill" data-value={v} aria-pressed={v === '' ? 'true' : 'false'}>{label}</button>)}
          </div>
        </fieldset>
        <div class="switch-row">
          <button type="button" id="open" aria-pressed="false" aria-labelledby="open-label"><span></span></button>
          <label id="open-label" for="open">Only clubs taking new players</label>
        </div>
      </div>
    </form>
  </section>

  <p id="status" aria-live="polite" tabindex="-1"></p>

  <!-- After a search: the week. A night tile narrows the list to that night
       and a second press widens it again. -->
  <div id="refine" hidden>
    <div class="week" role="group" aria-label="Night">
      {NIGHTS.map(([v, label]) => (
        <button type="button" class="night" data-day={v} aria-pressed="false">
          <b>{label}</b><span class="tc" aria-hidden="true"></span>
        </button>
      ))}
    </div>
    <p class="usual">Clubs list the nights they usually play. Holidays and term breaks aren’t shown yet, so check with the club before your first visit.</p>
  </div>
  <ul id="results" data-tints={JSON.stringify(COURT_TINTS)} data-build={build}></ul>

  <div id="browse">
    <section class="browse" aria-labelledby="browse-h">
      <div class="browse-top">
        <h2 class="h-results" id="browse-h">Browse by area</h2>
        {nations.length > 1 && (
          <div class="tabs" role="group" aria-label="Country">
            {nations.map((n, i) => <button type="button" data-nation={n.name} aria-pressed={i === 0 ? 'true' : 'false'}>{n.name}</button>)}
          </div>
        )}
      </div>
      {nations.map((n) => (
        <div class="nation" data-nation={n.name}>
          <h3>Badminton in {n.name}</h3>
          {n.groups.map((g) => (
            <div class="group">
              <div class="letter" aria-hidden="true">{g.letter}</div>
              <ul>
                {g.areas.map((a) => (
                  <li><a href={a.url}><span>{a.name}</span><span class="count" aria-label={`${a.clubs.length} clubs${a.dropIns.length ? `, ${a.dropIns.length} drop-in venues` : ''}`}>{a.clubs.length + a.dropIns.length}</span></a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))}
    </section>

    {single.length > 0 && (
      <section class="more" aria-labelledby="more-h">
        <h2 class="h-section" id="more-h" style="margin-bottom: 6px">More clubs</h2>
        <p>Clubs in areas that don't have their own page yet.</p>
        <ul>
          {single.map((c) => (
            <li>
              <a href={c.url}>
                <span><b>{c.name}</b><small>{c.areaName}</small></span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 auto"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <AppFeatures search={false} src="finder" />

  <script>
    /** A grouped session row: days, one-off date, days in words, time, duration, level bars, level words, other venue. */
    type Line = [number[], string | null, string, string, string | null, [number, number], string, string | null, string | null];
    /** A drop-in row: days, one-off date, days in words, time, duration, price, level bars and words (or null). */
    type DropLine = [number[], string | null, string, string, string | null, string | null, [number, number] | null, string | null];
    type Row = { y?: 'd'; n: string; w?: string; j?: string | null; u: string | null; a: string; v: string; lat: number; lng: number; d: number[]; l: [number, number]; o: number; x: number; t: number; p: number; s: Line[] | DropLine[]; k: string | null };
    const WEEK = [1, 2, 3, 4, 5, 6, 0];
    const LETTERS = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
    const POSTCODE = /^([A-Z]{1,2}\d[A-Z\d]?)(\s*\d[A-Z]{2})?$/i;
    const RADIUS_KM = 25;

    const q = document.getElementById('q') as HTMLInputElement;
    const open = document.getElementById('open') as HTMLButtonElement;
    const status = document.getElementById('status')!;
    const results = document.getElementById('results')!;
    const tints: string[] = JSON.parse(results.dataset.tints ?? '[]');
    // The area lists are for browsing; a search hides them (they stay in the
    // HTML, so crawlers still follow every link).
    const browse = document.getElementById('browse')!;
    const refine = document.getElementById('refine')!;
    const weekEl = refine.querySelector<HTMLElement>('.week')!;
    const nightBtns = [...weekEl.querySelectorAll<HTMLButtonElement>('.night')];
    const filtersBtn = document.getElementById('filters-btn') as HTMLButtonElement;
    const filtersPanel = document.getElementById('filters')!;
    const filtersN = document.getElementById('filters-n')!;
    const filter = { day: '', level: '', kind: '' };
    const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    let rows: Row[] | null = null;
    let districts: [string, number, number, string][] | null = null;
    let areas: [string, number, number][] | null = null;
    let origin: { lat: number; lng: number; label: string } | null = null;

    /** A file the finder needs; a failed load throws, so the search can say so and the next one tries again. */
    async function load<T>(url: string): Promise<T> {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`${url}: ${res.status}`);
      return res.json();
    }
    async function index(): Promise<Row[]> {
      rows ??= await load<Row[]>(`/badminton/search-index.json?v=${results.dataset.build ?? ''}`);
      return rows;
    }
    async function postcodes() {
      districts ??= await load<[string, number, number, string][]>('/postcode-districts.json');
      return districts;
    }
    async function councils() {
      areas ??= await load<[string, number, number][]>(`/badminton/places.json?v=${results.dataset.build ?? ''}`);
      return areas;
    }
    function km(a: { lat: number; lng: number }, b: { lat: number; lng: number }) {
      const r = Math.PI / 180;
      const h = Math.sin(((b.lat - a.lat) * r) / 2) ** 2 +
        Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(((b.lng - a.lng) * r) / 2) ** 2;
      return 12742 * Math.asin(Math.sqrt(h));
    }
    function norm(s: string) { return s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, ' ').trim(); }
    function esc(s: string) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }

    /**
     * Where the text points: a postcode district, a council area with clubs,
     * a locality the district table names ("Croydon, Addiscombe, ..."), or
     * any council area or London, whether or not it has clubs of its own.
     */
    async function place(text: string) {
      const t = text.trim();
      const m = POSTCODE.exec(t.replace(/\s+/g, ' '));
      const list = await postcodes();
      if (m) {
        const hit = list.find((d) => d[0] === m[1].toUpperCase());
        if (hit) return { lat: hit[1], lng: hit[2], label: hit[0] };
      }
      const inArea = (await index()).filter((r) => norm(r.a) === norm(t));
      if (inArea.length) {
        return {
          lat: inArea.reduce((s, r) => s + r.lat, 0) / inArea.length,
          lng: inArea.reduce((s, r) => s + r.lng, 0) / inArea.length,
          label: inArea[0].a,
        };
      }
      const town = list.filter((d) => d[3].split(',').some((part) => norm(part) === norm(t)));
      if (town.length) {
        return {
          lat: town.reduce((s, d) => s + d[1], 0) / town.length,
          lng: town.reduce((s, d) => s + d[2], 0) / town.length,
          label: t.replace(/\b\w/g, (c) => c.toUpperCase()),
        };
      }
      const council = (await councils()).find((a) => norm(a[0]) === norm(t));
      if (council) return { lat: council[1], lng: council[2], label: council[0] };
      return null;
    }

    /** Whether a listing fits the filters; the week's counts leave the night out. */
    function passes(r: Row, withDay = true) {
      if (filter.kind === 'club' && r.y === 'd') return false;
      if (filter.kind === 'dropin' && r.y !== 'd') return false;
      if (withDay && filter.day !== '' && !r.d.includes(Number(filter.day))) return false;
      // Drop-ins publish no level, so a level filter leaves them out.
      if (filter.level !== '' && r.y === 'd') return false;
      if (filter.level !== '') {
        const l = Number(filter.level);
        if (l < r.l[0] || l > r.l[1]) return false;
      }
      return open.getAttribute('aria-pressed') !== 'true' || r.o === 1;
    }

    const PIN = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>';
    // The court, as CourtArt.astro draws it.
    const COURT_LINE = 'stroke="#FFFFFF" stroke-opacity="0.6" stroke-width="1.2"';
    const COURT = `<svg viewBox="0 0 160 120" width="160" height="120" fill="none" aria-hidden="true">
      <rect x="10" y="14" width="140" height="92" ${COURT_LINE}></rect>
      ${[[10, 21, 150, 21], [10, 99, 150, 99], [18, 14, 18, 106], [142, 14, 142, 106], [59, 14, 59, 106], [101, 14, 101, 106], [10, 60, 59, 60], [101, 60, 150, 60]]
        .map(([x1, y1, x2, y2]) => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" ${COURT_LINE}></line>`).join('')}
      <line x1="80" y1="8" x2="80" y2="112" stroke="#C8F135" stroke-width="2.4"></line>
    </svg>`;
    const PIN_SMALL = PIN.replace(/width="16" height="16"/, 'width="14" height="14"');
    const ARROW = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';

    /** One grouped row, as NightLine.astro draws it; a picked night leaves out rows without it and lights its cell. */
    function line([days, oneOff, daysText, time, duration, bars, levels, venue, grade]: Line) {
      const picked = filter.day === '' ? null : Number(filter.day);
      if (picked != null && !days.includes(picked)) return '';
      const state = picked == null ? '' : ' hl';
      const strip = oneOff
        ? `<span class="nl-day">${esc(oneOff)}</span>`
        : `<span class="day-strip" role="img" aria-label="${esc(daysText)}">${WEEK.map((d) => {
          const on = days.includes(d);
          return `<span class="ds-cell${on ? ' on' : ''}${on && d === picked ? ' hl' : ''}" aria-hidden="true">${LETTERS[d]}</span>`;
        }).join('')}</span>`;
      const segs = [1, 2, 3].map((b) => `<i class="${b >= bars[0] && b <= bars[1] ? 'on' : ''}"></i>`).join('');
      return `<li class="night-line${state}">
        ${strip}
        <span class="nl-time"><b>${esc(time)}</b>${duration ? `<small>${esc(duration)}</small>` : ''}</span>
        <span class="nl-level"><span class="nl-segs" aria-hidden="true">${segs}</span><span class="nl-level-text">${esc(levels)}</span></span>
        ${grade ? `<span class="nl-grade">${esc(grade)}</span>` : ''}
        ${venue ? `<span class="nl-note">${PIN_SMALL}At ${esc(venue)}</span>` : ''}
      </li>`;
    }

    /** A club, as ClubCard.astro draws it, with its distance from the search. */
    function card(r: Row, dist?: number) {
      return `<li><article class="club-card">
        <div class="cc-slot" style="background: ${tints[r.p] ?? tints[0]}">${COURT}</div>
        <div class="cc-body">
          <div class="cc-top">
            <div class="cc-who">
              <h3 class="cc-name"><a href="${esc(r.u)}">${esc(r.n)}</a></h3>
              <p class="cc-venue">${PIN}${esc(r.v)}, ${esc(r.a)}</p>
              ${r.k ? `<p class="cc-count">${esc(r.k)}</p>` : ''}
            </div>
            <div class="cc-tags">
              ${dist != null ? `<span class="tag">${dist < 1 ? 'Under 1' : Math.round(dist)} km away</span>` : ''}
              ${r.x ? '<span class="tag lime">Runs on NextFour</span>' : ''}
              ${r.o ? '' : '<span class="tag alert">Not taking new players</span>'}
              ${r.t ? '<span class="tag ok">Visitor terms listed</span>' : '<span class="tag">No visitor info yet</span>'}
            </div>
          </div>
          <ul class="cc-lines">${((r.s ?? []) as Line[]).map(line).join('')}</ul>
          <a class="cc-more" href="${esc(r.u)}">Club details and visitor info ${ARROW}</a>
        </div>
      </article></li>`;
    }

    // The building, as DropInCard.astro draws it.
    const BUILDING = '<svg width="88" height="88" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-opacity="0.75" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M4 21V10l8-5 8 5v11"></path><path d="M9 21v-5h6v5"></path><path d="M8 11h2M14 11h2"></path></svg>';

    /** A drop-in row, as DropInCard.astro draws it. */
    function dropLine([days, label, daysText, time, duration, price, bars, levels]: DropLine) {
      const picked = filter.day === '' ? null : Number(filter.day);
      if (picked != null && !days.includes(picked)) return '';
      const state = picked == null ? '' : ' hl';
      const strip = label
        ? `<span class="nl-day">${esc(label)}</span>`
        : `<span class="day-strip" role="img" aria-label="${esc(daysText)}">${WEEK.map((d) => {
          const on = days.includes(d);
          return `<span class="ds-cell${on ? ' on' : ''}${on && d === picked ? ' hl' : ''}" aria-hidden="true">${LETTERS[d]}</span>`;
        }).join('')}</span>`;
      const segs = bars ? [1, 2, 3].map((b) => `<i class="${b >= bars[0] && b <= bars[1] ? 'on' : ''}"></i>`).join('') : '';
      return `<li class="night-line${state}">
        ${strip}
        <span class="nl-time"><b>${esc(time)}</b>${duration ? `<small>${esc(duration)}</small>` : ''}</span>
        ${price ? `<span class="di-price"><b>${esc(price)}</b> per session</span>` : ''}
        ${bars ? `<span class="nl-level"><span class="nl-segs" aria-hidden="true">${segs}</span><span class="nl-level-text">${esc(levels ?? '')}</span></span>` : ''}
      </li>`;
    }

    /** A drop-in listing, as DropInCard.astro draws it, with the distance from the search. */
    function dropCard(r: Row, dist?: number) {
      const lines = r.s as DropLine[];
      return `<li><article class="club-card dropin">
        <div class="cc-slot" style="background: ${tints[r.p] ?? tints[0]}">${BUILDING}</div>
        <div class="cc-body">
          <div class="cc-top">
            <div class="cc-who">
              <h3 class="cc-name">${r.u ? `<a href="${esc(r.u)}">${esc(r.n)}</a>` : esc(r.n)}</h3>
              <p class="cc-venue">${PIN}${esc(r.w ?? '')}, ${esc(r.a)}</p>
              ${r.v ? `<p class="di-run">Run by ${esc(r.v)}</p>` : ''}
            </div>
            <div class="cc-tags">
              ${dist != null ? `<span class="tag">${dist < 1 ? 'Under 1' : Math.round(dist)} km away</span>` : ''}
              <span class="tag">Drop-in</span>
              ${r.x ? '<span class="tag ok">Runs on NextFour</span>' : ''}
            </div>
          </div>
          <ul class="cc-lines">${lines.map(dropLine).join('')}</ul>
          ${r.j ? `<a class="di-join" href="/open?session=${encodeURIComponent(r.j)}&amp;src=dropin">Join in the app</a>` : ''}
        </div>
      </article></li>`;
    }

    /** "12 clubs and 3 drop-ins": each kind counted on its own. */
    function counted(list: { r: Row }[]) {
      const venues = list.filter((x) => x.r.y === 'd').length;
      const clubs = list.length - venues;
      const parts = [
        clubs ? `${clubs} club${clubs === 1 ? '' : 's'}` : '',
        venues ? `${venues} drop-in${venues === 1 ? '' : 's'}` : '',
      ].filter(Boolean);
      return parts.join(' and ');
    }

    function render(list: { r: Row; dist?: number }[], heading: string) {
      status.textContent = heading;
      results.innerHTML = list.slice(0, 40).map(({ r, dist }) => (r.y === 'd' ? dropCard(r, dist) : card(r, dist))).join('');
    }

    /**
     * The week above the results: how many clubs around the place usually
     * play each night, given every filter but the night. A count always
     * carries its word ("8 clubs"), so it never reads as a date. A night with
     * only drop-ins counts those instead; a night with nothing cannot be
     * picked, unless it is the picked one, so it can be let go.
     */
    function week(base: Row[] | null) {
      weekEl.hidden = !base;
      for (const b of nightBtns) {
        const d = Number(b.dataset.day);
        const on = base ? base.filter((r) => r.d.includes(d)) : [];
        const drops = on.filter((r) => r.y === 'd').length;
        const clubs = on.length - drops;
        const [n, word] = clubs ? [clubs, clubs === 1 ? 'club' : 'clubs'] : drops ? [drops, drops === 1 ? 'drop-in' : 'drop-ins'] : [0, ''];
        const picked = filter.day === b.dataset.day;
        b.setAttribute('aria-pressed', String(picked));
        b.disabled = !on.length && !picked;
        b.classList.toggle('zero', !on.length);
        b.querySelector('.tc')!.innerHTML = n ? `<span class="tn">${n}</span> <span class="tw">${word}</span>` : 'none';
        b.setAttribute('aria-label', `${DAY_NAMES[d]}: ${n ? `${n} ${word}` : 'none listed'}`);
      }
    }

    // Each search counts itself, so a slow earlier one (still loading the
    // postcode table, say) never paints over the answer to a later one.
    let latest = 0;
    async function run() {
      const seq = ++latest;
      save();
      try {
        await search(() => seq !== latest);
      } catch {
        if (seq !== latest) return;
        status.textContent = 'The club list didn’t load. Check your connection and search again.';
        results.innerHTML = '';
        refine.hidden = true;
      }
    }

    async function search(stale: () => boolean) {
      const all = await index();
      if (stale()) return;
      const text = q.value.trim();
      browse.hidden = Boolean(text || origin);
      refine.hidden = !text && !origin;
      if (!text && !origin) { status.textContent = ''; results.innerHTML = ''; return; }
      const where = origin ?? (text ? await place(text) : null);
      if (stale()) return;
      if (where) {
        const around = all.filter((r) => passes(r, false))
          .map((r) => ({ r, dist: km(where, r) }))
          .filter((x) => x.dist <= RADIUS_KM)
          .sort((a, b) => a.dist - b.dist);
        const near = around.filter(({ r }) => passes(r));
        week(around.map(({ r }) => r));
        const usually = filter.day === '' ? '' : ` usually on ${DAY_NAMES[Number(filter.day)]}s`;
        render(near, near.length
          ? `${counted(near)}${usually} within ${RADIUS_KM} km of ${where.label}`
          : `Nothing within ${RADIUS_KM} km of ${where.label} matches. Try fewer filters.`);
        return;
      }
      // A name search has no place to count a week around.
      week(null);
      const words = norm(text).split(' ').filter(Boolean);
      const found = all.filter(passes).filter((r) => {
        const hay = norm(`${r.n} ${r.v} ${r.a}`);
        return words.every((w) => hay.includes(w));
      }).map((r) => ({ r }));
      render(found, found.length
        ? `${counted(found)} matching “${text}”`
        : `Nothing matches “${text}”. Try a postcode or a nearby town.`);
    }

    /**
     * The answer to a search the visitor asked for (Search, Return, Near me):
     * the results start below the form, off the screen on a phone, so bring
     * the line that heads them into view and put focus there, where a
     * keyboard carries on into the cards. Typing and the filters update in
     * place and leave the page where it is.
     */
    async function answer() {
      const seq = latest + 1;
      await run();
      if (seq !== latest || !status.textContent) return;
      status.focus({ preventScroll: true });
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      status.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'start' });
    }

    let timer: number | undefined;
    q.addEventListener('input', () => {
      setNear('off');
      clearTimeout(timer);
      timer = window.setTimeout(run, 250);
    });
    document.getElementById('find')!.addEventListener('submit', (e) => { e.preventDefault(); clearTimeout(timer); answer(); });

    // Level and type pills: one pressed per group.
    document.querySelectorAll<HTMLElement>('.pills').forEach((group) => {
      const key = group.dataset.filter as 'day' | 'level' | 'kind';
      group.querySelectorAll<HTMLButtonElement>('.pill').forEach((b) => b.addEventListener('click', () => {
        group.querySelectorAll('.pill').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        filter[key] = b.dataset.value ?? '';
        run();
      }));
    });
    open.addEventListener('click', () => {
      open.setAttribute('aria-pressed', String(open.getAttribute('aria-pressed') !== 'true'));
      run();
    });

    // A night tile narrows the list to that night; pressing it again widens it.
    for (const b of nightBtns) b.addEventListener('click', () => {
      filter.day = filter.day === b.dataset.day ? '' : b.dataset.day!;
      nightBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.day === filter.day)));
      run();
    });

    filtersBtn.addEventListener('click', () => {
      const show = filtersPanel.hidden;
      filtersPanel.hidden = !show;
      filtersBtn.setAttribute('aria-expanded', String(show));
    });

    // Country tabs: every country is in the HTML; the tabs show one at a time.
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tabs button');
    const nations = document.querySelectorAll<HTMLElement>('.nation');
    const showNation = (name: string) => {
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.nation === name)));
      nations.forEach((n) => { n.hidden = n.dataset.nation !== name; });
    };
    if (tabs.length) {
      tabs.forEach((t) => t.addEventListener('click', () => showNation(t.dataset.nation!)));
      showNation(tabs[0].dataset.nation!);
    }

    // Near me: off, finding the visitor, or on (searching around them). A press
    // while on turns it off again; typing a search does too.
    const nearBtn = document.getElementById('near') as HTMLButtonElement;
    function setNear(state: 'off' | 'finding' | 'on') {
      if (state !== 'on') origin = null;
      nearBtn.setAttribute('aria-pressed', String(state === 'on'));
      nearBtn.setAttribute('aria-busy', String(state === 'finding'));
      nearBtn.setAttribute('aria-label', state === 'finding' ? 'Locating…' : 'Near me');
      nearBtn.title = state === 'on' ? 'Near me (on)' : 'Near me';
    }
    nearBtn.addEventListener('click', () => {
      if (nearBtn.getAttribute('aria-pressed') === 'true') { setNear('off'); run(); return; }
      if (nearBtn.getAttribute('aria-busy') === 'true') return;
      if (!navigator.geolocation) { status.textContent = 'Your browser cannot share its location.'; return; }
      setNear('finding');
      status.textContent = 'Finding you…';
      navigator.geolocation.getCurrentPosition(
        (p) => {
          q.value = '';
          setNear('on');
          origin = { lat: p.coords.latitude, lng: p.coords.longitude, label: 'you' };
          answer();
        },
        () => { setNear('off'); status.textContent = 'Location was not shared. Try a postcode instead.'; },
        { maximumAge: 600000, timeout: 10000 },
      );
    });
    // The search lives in the URL's #fragment (#q=SE15&day=3), so Back from a
    // club page and a shared link both bring it back. A fragment never goes to
    // the server, which keeps the promise that a postcode stays on the device;
    // a ?q= from the home page's search box is moved into it for that reason.
    // Near me is left out: a link should not ask for someone's location.
    function save() {
      const state = new URLSearchParams();
      const text = q.value.trim();
      if (text) state.set('q', text);
      for (const key of ['day', 'level', 'kind'] as const) if (filter[key]) state.set(key, filter[key]);
      if (open.getAttribute('aria-pressed') === 'true') state.set('open', '1');
      // The Filters button counts what is set behind it.
      const set = [filter.level, filter.kind].filter(Boolean).length + (state.has('open') ? 1 : 0);
      filtersN.textContent = set ? String(set) : '';
      filtersBtn.setAttribute('aria-label', set ? `Filters, ${set} set` : 'Filters');
      const hash = state.toString();
      history.replaceState(history.state, '', `${location.pathname}${hash ? `#${hash}` : ''}`);
    }

    function restore() {
      const fromHash = new URLSearchParams(location.hash.slice(1));
      const state = fromHash.has('q') || fromHash.has('day') || fromHash.has('level') || fromHash.has('kind') || fromHash.has('open')
        ? fromHash
        : new URLSearchParams(location.search);
      q.value = state.get('q') ?? '';
      const day = state.get('day') ?? '';
      filter.day = nightBtns.some((b) => b.dataset.day === day) ? day : '';
      document.querySelectorAll<HTMLElement>('.pills').forEach((group) => {
        const key = group.dataset.filter as 'day' | 'level' | 'kind';
        const pills = [...group.querySelectorAll<HTMLButtonElement>('.pill')];
        // Only a value one of the pills offers; anything else is the group's "Any".
        const pick = pills.find((b) => b.dataset.value === (state.get(key) ?? '')) ?? pills[0];
        pills.forEach((b) => b.setAttribute('aria-pressed', String(b === pick)));
        filter[key] = pick.dataset.value ?? '';
      });
      open.setAttribute('aria-pressed', String(state.get('open') === '1'));
      if (q.value.trim()) run();
      else if (location.search) save();
    }
    restore();
  </script>
</Directory>
