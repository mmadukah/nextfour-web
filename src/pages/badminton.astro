---
// /badminton.html: the club finder, and the hub every area page hangs off.
//
// Search runs in the browser over /badminton/search-index.json. A postcode is
// placed with /postcode-districts.json (shipped with the site, OGL), so it
// never leaves the visitor's device; "Near me" uses the browser's location
// prompt. Below the finder, every area is a plain link, so crawlers reach
// every page without running any script.
import Directory from '../layouts/Directory.astro';
import { getDirectory, weeklyNights, PHOTOS } from '../data/directory';

const dir = await getDirectory();
const withPage = dir.areas.filter((a) => a.hasPage);
const single = dir.areas.filter((a) => !a.hasPage).flatMap((a) => a.clubs);
const nations = ['England', 'Scotland', 'Wales', 'Northern Ireland']
  .map((n) => ({ name: n, areas: withPage.filter((a) => a.nation === n) }))
  .filter((n) => n.areas.length > 0);
const nights = weeklyNights(dir.clubs);
const site = Astro.site!;

const title = 'Badminton clubs near you: find a club night | NextFour';
const description =
  `Find badminton near you: ${dir.clubs.length} clubs and ${nights} weekly club nights across the UK, ` +
  'with days, times, venues, levels and visitor terms. Search by postcode or town.';

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Badminton clubs in the UK',
  url: new URL('/badminton.html', site).href,
  description,
};
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Badminton', href: '/badminton.html' },
];
---

<Directory title={title} description={description} crumbs={crumbs} jsonLd={[siteLd]}>
  <style>
    .search { margin-top: 32px; display: grid; gap: 12px; }
    .row { display: flex; flex-wrap: wrap; gap: 10px; }
    .row > * { flex: 1 1 160px; }
    input[type='search'], select {
      font: inherit; color: var(--ink); background: var(--row);
      border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; min-width: 0;
    }
    input[type='search'] { flex: 3 1 260px; font-size: 1.05rem; }
    input[type='search']:focus, select:focus { outline: 2px solid var(--accent-ink); outline-offset: 1px; }
    .row > #near { flex: 0 0 auto; white-space: nowrap; }
    label.check { display: flex; align-items: center; gap: 8px; color: var(--muted); flex: 0 1 auto; }
    #status { font-family: var(--head); font-weight: 800; font-size: 1.25rem; margin: 32px 0 14px; letter-spacing: -0.01em; }
    #status:empty { display: none; }
    #results { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
    /* Result cards are written by the script below, so these rules are
       global: Astro's scoped selectors never match innerHTML. */
    :global(#results .hit) {
      position: relative; display: grid; grid-template-columns: 112px 1fr; overflow: hidden;
      background: var(--card); border: 1px solid var(--border); border-radius: 14px;
    }
    :global(#results .hit:hover) { border-color: var(--accent-ink); }
    :global(#results .hit img) { width: 100%; height: 100%; min-height: 104px; object-fit: cover; display: block; }
    :global(#results .hit-body) { padding: 14px 16px; display: grid; gap: 6px; min-width: 0; }
    :global(#results .hit-top) { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    :global(#results .hit-name) {
      font-family: var(--head); font-weight: 800; font-size: 1.05rem; line-height: 1.3; color: var(--ink); text-decoration: none;
    }
    /* The name is the only link; this stretches it over the whole card. */
    :global(#results .hit-name::after) { content: ''; position: absolute; inset: 0; }
    :global(#results .hit:hover .hit-name) { text-decoration: underline; }
    :global(#results .hit-name:focus-visible) { outline: none; }
    :global(#results .hit:has(.hit-name:focus-visible)) { outline: 2px solid var(--accent-ink); outline-offset: 2px; }
    :global(#results .hit-dist) { flex: none; font-size: 0.82rem; font-weight: 800; color: var(--muted); }
    :global(#results .hit-venue) { margin: 0; color: var(--muted); font-size: 0.92rem; }
    :global(#results .hit-tags) { display: flex; flex-wrap: wrap; gap: 6px; }
    :global(#results .hit-day) {
      background: var(--strong); color: var(--on-strong); border-radius: 6px; font-weight: 800; font-size: 0.75rem; padding: 2px 8px;
    }
    @media (max-width: 640px) {
      :global(#results .hit) { grid-template-columns: 84px 1fr; }
    }
  </style>

  <section class="hero">
    <div>
      <p class="eyebrow">Badminton club finder</p>
      <h1 class="long">Find badminton near you</h1>
      <p class="lead">
        Every club night in our UK directory with its days, times, venue and playing level. Search by postcode, town or club name.
      </p>
    </div>
    <div class="stats">
      <div><span>Clubs</span><b>{dir.clubs.length}</b></div>
      <div><span>Nights a week</span><b>{nights}</b></div>
      <div><span>Areas</span><b>{dir.areas.length}</b></div>
    </div>
  </section>

  <form class="card search" id="find" role="search" onsubmit="return false">
    <div class="row">
      <input type="search" id="q" name="q" placeholder="Postcode, town or club name" aria-label="Postcode, town or club name" autocomplete="postal-code" />
      <button type="button" class="btn dark" id="near">Near me</button>
    </div>
    <div class="row">
      <select id="day" aria-label="Day">
        <option value="">Any day</option>
        <option value="1">Monday</option><option value="2">Tuesday</option>
        <option value="3">Wednesday</option><option value="4">Thursday</option>
        <option value="5">Friday</option><option value="6">Saturday</option>
        <option value="0">Sunday</option>
      </select>
      <select id="level" aria-label="Level">
        <option value="">Any level</option>
        <option value="1">Beginner</option><option value="2">Intermediate</option>
        <option value="3">Upper intermediate</option><option value="4">Advanced</option>
      </select>
      <label class="check"><input type="checkbox" id="open" /> Taking new players</label>
    </div>
  </form>
  <p id="status" aria-live="polite"></p>
  <ul id="results" data-photos={JSON.stringify(PHOTOS)}></ul>

  <div id="browse">
    {nations.map((n) => (
      <>
        <h2>Badminton in {n.name}</h2>
        <nav class="links" aria-label={`Areas in ${n.name}`}>
          {n.areas.map((a) => <a href={a.url}><span>{a.name}<small>{a.clubs.length} clubs</small></span></a>)}
        </nav>
      </>
    ))}

    {single.length > 0 && (
      <>
        <h2>More clubs</h2>
        <nav class="links" aria-label="More clubs">
          {single.map((c) => <a href={c.url}><span>{c.name}<small>{c.areaName}</small></span></a>)}
        </nav>
      </>
    )}
  </div>

  <script>
    type Row = { n: string; u: string; a: string; v: string; lat: number; lng: number; d: number[]; l: [number, number]; o: number; x: number; t: number; p: number };
    const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const POSTCODE = /^([A-Z]{1,2}\d[A-Z\d]?)(\s*\d[A-Z]{2})?$/i;
    const RADIUS_KM = 25;

    const q = document.getElementById('q') as HTMLInputElement;
    const day = document.getElementById('day') as HTMLSelectElement;
    const level = document.getElementById('level') as HTMLSelectElement;
    const open = document.getElementById('open') as HTMLInputElement;
    const status = document.getElementById('status')!;
    const results = document.getElementById('results')!;
    const photos: { src: string; position: string }[] = JSON.parse(results.dataset.photos ?? '[]');
    // The area lists are for browsing; a search hides them (they stay in the
    // HTML, so crawlers still follow every link).
    const browse = document.getElementById('browse')!;

    let rows: Row[] | null = null;
    let districts: [string, number, number, string][] | null = null;
    let origin: { lat: number; lng: number; label: string } | null = null;

    async function index(): Promise<Row[]> {
      rows ??= await (await fetch('/badminton/search-index.json')).json();
      return rows!;
    }
    async function postcodes() {
      districts ??= await (await fetch('/postcode-districts.json')).json();
      return districts!;
    }
    function km(a: { lat: number; lng: number }, b: { lat: number; lng: number }) {
      const r = Math.PI / 180;
      const h = Math.sin(((b.lat - a.lat) * r) / 2) ** 2 +
        Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(((b.lng - a.lng) * r) / 2) ** 2;
      return 12742 * Math.asin(Math.sqrt(h));
    }
    function norm(s: string) { return s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, ' ').trim(); }
    function esc(s: string) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }

    /**
     * Where the text points: a postcode district, a council area with clubs,
     * or a locality the district table names ("Croydon, Addiscombe, ...").
     */
    async function place(text: string) {
      const t = text.trim();
      const m = POSTCODE.exec(t.replace(/\s+/g, ' '));
      const list = await postcodes();
      if (m) {
        const hit = list.find((d) => d[0] === m[1].toUpperCase());
        if (hit) return { lat: hit[1], lng: hit[2], label: hit[0] };
      }
      const inArea = (await index()).filter((r) => norm(r.a) === norm(t));
      if (inArea.length) {
        return {
          lat: inArea.reduce((s, r) => s + r.lat, 0) / inArea.length,
          lng: inArea.reduce((s, r) => s + r.lng, 0) / inArea.length,
          label: inArea[0].a,
        };
      }
      const town = list.filter((d) => d[3].split(',').some((part) => norm(part) === norm(t)));
      if (town.length) {
        return {
          lat: town.reduce((s, d) => s + d[1], 0) / town.length,
          lng: town.reduce((s, d) => s + d[2], 0) / town.length,
          label: t.replace(/\b\w/g, (c) => c.toUpperCase()),
        };
      }
      return null;
    }

    function passes(r: Row) {
      if (day.value !== '' && !r.d.includes(Number(day.value))) return false;
      if (level.value !== '') {
        const l = Number(level.value);
        if (l < r.l[0] || l > r.l[1]) return false;
      }
      return !open.checked || r.o === 1;
    }

    function render(list: { r: Row; dist?: number }[], heading: string) {
      status.textContent = heading;
      results.innerHTML = list.slice(0, 40).map(({ r, dist }) => {
        const photo = photos[r.p] ?? photos[0];
        return `
        <li class="hit">
          <img src="${photo.src}" alt="" loading="lazy" style="object-position: ${photo.position}" />
          <div class="hit-body">
            <div class="hit-top">
              <a class="hit-name" href="${esc(r.u)}">${esc(r.n)}</a>
              ${dist != null ? `<span class="hit-dist">${dist < 1 ? 'under 1' : Math.round(dist)} km</span>` : ''}
            </div>
            <p class="hit-venue">${esc(r.v)}, ${esc(r.a)}</p>
            <div class="hit-tags">
              ${[1, 2, 3, 4, 5, 6, 0].filter((d) => r.d.includes(d)).map((d) => `<span class="hit-day">${DAYS[d]}</span>`).join('')}
              ${r.x ? '<span class="tag lime">Runs on NextFour</span>' : ''}
              ${r.o ? '' : '<span class="tag warn">Not taking new players</span>'}
              ${r.t ? '<span class="tag ok">Visitor terms listed</span>' : ''}
            </div>
          </div>
        </li>`;
      }).join('');
    }

    async function run() {
      const all = await index();
      const text = q.value.trim();
      browse.hidden = Boolean(text || origin);
      if (!text && !origin) { status.textContent = ''; results.innerHTML = ''; return; }
      const where = origin ?? (text ? await place(text) : null);
      if (where) {
        const near = all.filter(passes)
          .map((r) => ({ r, dist: km(where, r) }))
          .filter((x) => x.dist <= RADIUS_KM)
          .sort((a, b) => a.dist - b.dist);
        render(near, near.length
          ? `${near.length} club${near.length === 1 ? '' : 's'} within ${RADIUS_KM} km of ${where.label}`
          : `No clubs within ${RADIUS_KM} km of ${where.label} match. Try fewer filters.`);
        return;
      }
      const words = norm(text).split(' ').filter(Boolean);
      const found = all.filter(passes).filter((r) => {
        const hay = norm(`${r.n} ${r.v} ${r.a}`);
        return words.every((w) => hay.includes(w));
      }).map((r) => ({ r }));
      render(found, found.length
        ? `${found.length} club${found.length === 1 ? '' : 's'} matching “${text}”`
        : `Nothing matches “${text}”. Try a postcode or a nearby town.`);
    }

    let timer: number | undefined;
    q.addEventListener('input', () => {
      origin = null;
      clearTimeout(timer);
      timer = window.setTimeout(run, 250);
    });
    [day, level, open].forEach((el) => el.addEventListener('change', run));
    document.getElementById('near')!.addEventListener('click', () => {
      if (!navigator.geolocation) { status.textContent = 'Your browser cannot share its location.'; return; }
      status.textContent = 'Finding you…';
      navigator.geolocation.getCurrentPosition(
        (p) => { origin = { lat: p.coords.latitude, lng: p.coords.longitude, label: 'you' }; q.value = ''; run(); },
        () => { status.textContent = 'Location was not shared. Try a postcode instead.'; },
        { maximumAge: 600000, timeout: 10000 },
      );
    });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { q.value = initial; run(); }
  </script>
</Directory>
