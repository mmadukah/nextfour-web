---
// Three segments, Beginner, Intermediate, Advanced, lit across the night's
// range, and the level in words. Styles: src/styles/club-card.css.
interface Props { range: [number, number]; label: string }
const { range, label } = Astro.props;
---

<span class="nl-level">
  <span class="nl-segs" aria-hidden="true">
    {[1, 2, 3].map((b) => <i class={b >= range[0] && b <= range[1] ? 'on' : ''} />)}
  </span>
  <span class="nl-level-text">{label}</span>
</span>
