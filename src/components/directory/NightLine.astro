---
// One session on one weekday: the day label, the time and how long, the
// level, and where it is when that differs from the club's usual venue. A
// night filter dims the rows on other days (.dim) and lights the day label of
// the ones that match (.hl). Styles: src/styles/club-card.css, shared with the
// finder's results, which build the same markup in its script.
import LevelBars from './LevelBars.astro';
import { durationText, timeRange, levelBars, type NightRow } from '../../data/directory';

interface Props {
  row: NightRow;
  /** The club's usual venue; a night elsewhere names its own. */
  clubVenue: string;
  /** Price and membership notes, on the club page. */
  detail?: boolean;
  clubTakesNewPlayers?: boolean;
}
const { row, clubVenue, detail = false, clubTakesNewPlayers = true } = Astro.props;
const n = row.night;
const duration = durationText(n);
const extras = [n.venue.name !== clubVenue ? n.venue.name : null, detail ? n.price : null].filter(Boolean);
const membersOnly = detail && clubTakesNewPlayers && !n.takingNewPlayers;
---

<li class="night-line" data-day={row.day ?? ''}>
  <span class="nl-day">{row.label}</span>
  <span class="nl-time"><b>{timeRange(n)}</b>{duration && <small>{duration}</small>}</span>
  <LevelBars range={levelBars(n)} label={n.levels} />
  {(extras.length > 0 || membersOnly) && (
    <span class="nl-extra">
      {extras.join(' · ')}
      {membersOnly && <span class="tag alert">Members only</span>}
    </span>
  )}
</li>
