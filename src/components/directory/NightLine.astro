---
// One session on one weekday: the day label, the time and how long, the
// level, and where it is when that differs from the club's usual venue. The
// area page's night picker dims the rows on other days (.dim) and lights the
// day label of the ones that match (.hl).
import LevelBars from './LevelBars.astro';
import { durationText, timeRange, levelBars, type NightRow } from '../../data/directory';

interface Props {
  row: NightRow;
  /** The club's usual venue; a night elsewhere names its own. */
  clubVenue: string;
  /** Price and membership notes, on the club page. */
  detail?: boolean;
  clubTakesNewPlayers?: boolean;
}
const { row, clubVenue, detail = false, clubTakesNewPlayers = true } = Astro.props;
const n = row.night;
const duration = durationText(n);
const extras = [n.venue.name !== clubVenue ? n.venue.name : null, detail ? n.price : null].filter(Boolean);
const membersOnly = detail && clubTakesNewPlayers && !n.takingNewPlayers;
---

<li class="line" data-day={row.day ?? ''}>
  <span class="day">{row.label}</span>
  <span class="time"><b>{timeRange(n)}</b>{duration && <small>{duration}</small>}</span>
  <LevelBars range={levelBars(n)} label={n.levels} />
  {(extras.length > 0 || membersOnly) && (
    <span class="extra">
      {extras.join(' · ')}
      {membersOnly && <span class="tag warn">Members only</span>}
    </span>
  )}
</li>

<style>
  .line {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; padding: 12px 14px;
    border-radius: 12px; background: var(--row); transition: opacity 0.15s;
  }
  .line:global(.dim) { opacity: 0.45; }
  .day {
    flex: 0 0 auto; min-width: 104px; font-weight: 800; font-size: 15px; padding: 4px 10px; border-radius: 8px;
    text-align: center; background: var(--chip-bg); color: var(--chip-fg); white-space: nowrap;
  }
  .line:global(.hl) .day { background: var(--hl-bg); color: var(--hl-fg); }
  .time { flex: 1 1 180px; display: flex; align-items: baseline; gap: 8px; font-variant-numeric: tabular-nums; }
  .time b { font-size: 17px; font-weight: 700; white-space: nowrap; }
  .time small { font-size: 13px; color: var(--muted); white-space: nowrap; }
  .extra { flex: 1 1 100%; font-size: 14px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
</style>
