---
// The venue map on club and venue pages, in the site's colours. Leaflet
// draws OpenStreetMap's tiles; an SVG filter turns each tile to grey and maps
// every shade onto the theme's palette (labels, water and buildings, land,
// roads), so the map reads as part of the page, with the design's lime pin.
// Leaflet (cdnjs) loads only when the map scrolls into view; without script
// the panel stays a plain tint, and the address and directions beside it
// still work.
interface Props { lat: number; lng: number; name: string }
const { lat, lng, name } = Astro.props;

// Brightness of an OpenStreetMap shade (0 black text .. 1 white roads) to the
// colour it becomes. Land sits near 0.94, roads at 1, water and buildings
// near 0.8: the stops are bunched there so those stay apart.
const STOPS = {
  light: [[0, '#2C3B33'], [0.55, '#9FAD9A'], [0.8, '#D3DACF'], [0.9, '#DCE2D8'], [0.94, '#EAEEE5'], [1, '#FFFFFF']],
  dark: [[0, '#C6CFD8'], [0.55, '#5A6878'], [0.8, '#2A3644'], [0.9, '#34404D'], [0.94, '#1A232D'], [1, '#3E4D5E']],
} as const;
const STEPS = 65;
function tables(stops: readonly (readonly [number, string])[]): string[] {
  const rgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
  const out: number[][] = [[], [], []];
  for (let k = 0; k < STEPS; k++) {
    const x = k / (STEPS - 1);
    const i = stops.findIndex(([x1], j) => j > 0 && x <= x1);
    const [[x0, c0], [x1, c1]] = [stops[i - 1], stops[i]];
    const t = (x - x0) / (x1 - x0);
    rgb(c0).forEach((v, ch) => out[ch].push(v + (rgb(c1)[ch] - v) * t));
  }
  return out.map((ch) => ch.map((v) => v.toFixed(3)).join(' '));
}
const filters = Object.entries(STOPS).map(([theme, stops]) => ({ id: `map-${theme}`, values: tables(stops) }));
---

<div class="venue-map" data-lat={lat} data-lng={lng} role="img" aria-label={`Map of ${name}`}></div>
<svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
  {filters.map((f) => (
    <filter id={f.id} color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues={f.values[0]} />
        <feFuncG type="table" tableValues={f.values[1]} />
        <feFuncB type="table" tableValues={f.values[2]} />
      </feComponentTransfer>
    </filter>
  ))}
</svg>

<style is:global>
  .venue-map { position: absolute; inset: 0; background: var(--row); }
  :root { --map-tiles: url(#map-light); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) { --map-tiles: url(#map-dark); }
  }
  :root[data-theme='dark'] { --map-tiles: url(#map-dark); }
  .venue-map .leaflet-tile-pane { filter: var(--map-tiles); }
  .venue-map.leaflet-container { background: var(--row); font-family: var(--font); }
  .venue-map .leaflet-bar { border: 1px solid var(--line-strong); box-shadow: none; }
  .venue-map .leaflet-bar a { background: var(--surface); color: var(--ink); border-bottom-color: var(--line); }
  .venue-map .leaflet-bar a:hover { background: var(--row); color: var(--ink); }
  .venue-map .leaflet-control-attribution { background: var(--surface); color: var(--muted); opacity: 0.9; font-size: 10px; }
  .venue-map .leaflet-control-attribution a { color: var(--muted); }
  .venue-pin { background: none; border: 0; }
</style>

<script is:inline>
  (() => {
    const el = document.querySelector('.venue-map');
    if (!el || !('IntersectionObserver' in window)) return;
    const BASE = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/';
    const PIN = '<svg width="36" height="36" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z" fill="#C8F135" stroke="#12261C" stroke-width="1.5"></path><circle cx="12" cy="10" r="2.5" fill="#12261C"></circle></svg>';
    const load = () => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = BASE + 'leaflet.min.css';
      document.head.appendChild(css);
      const js = document.createElement('script');
      js.src = BASE + 'leaflet.min.js';
      js.onload = () => {
        const L = window.L;
        const at = [Number(el.dataset.lat), Number(el.dataset.lng)];
        const map = L.map(el, { scrollWheelZoom: false, dragging: !L.Browser.mobile, tap: false }).setView(at, 15);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);
        L.marker(at, { icon: L.divIcon({ className: 'venue-pin', html: PIN, iconSize: [36, 36], iconAnchor: [18, 34] }), keyboard: false }).addTo(map);
      };
      document.head.appendChild(js);
    };
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { seen.disconnect(); load(); }
    }, { rootMargin: '200px' });
    seen.observe(el);
  })();
</script>
