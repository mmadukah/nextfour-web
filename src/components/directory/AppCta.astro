---
// The closing app banner on every directory page. Inverts to solid lime in
// dark mode (the --cta-* tokens).
interface Props {
  heading?: string;
  text?: string;
  /** The outlined second button; the finder itself leaves it off. */
  search?: boolean;
  getLabel?: string;
  secondLabel?: string;
  /** Where the visitor is, for the "Get the app" link's ?src= (tracking). */
  src?: string;
  /** A plain surface instead of the solid banner, for a page that should end on its own content. */
  quiet?: boolean;
}
const {
  heading = "See who's going before you go.",
  text = 'Get the NextFour app to join a club night, or search every club by postcode, town or name.',
  search = true,
  getLabel = 'Get the app',
  secondLabel = 'Search all clubs',
  src = 'banner',
  quiet = false,
} = Astro.props;
---

<section class:list={['cta', { quiet }]} aria-labelledby="cta-h">
  <div class="copy">
    <h2 id="cta-h">{heading}</h2>
    <p>{text}</p>
  </div>
  <div class="actions">
    <a class="go" href={`/get.html?src=${src}`}>{getLabel}</a>
    {search && <a class="ghost" href="/badminton.html">{secondLabel}</a>}
  </div>
</section>

<style>
  .cta {
    background: var(--cta-bg); border-radius: 24px; padding: clamp(28px, 5vw, 48px); margin-bottom: 56px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px;
  }
  .copy { flex: 999 1 420px; min-width: 0; }
  h2 {
    margin: 0; font-size: clamp(28px, 4vw, 40px); line-height: 1.05; font-weight: 800; font-stretch: 112%;
    letter-spacing: -0.02em; color: var(--cta-head);
  }
  p { margin: 12px 0 0; max-width: 520px; font-size: 17px; color: var(--cta-body); }
  .actions { flex: 1 1 260px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
  .go, .ghost { text-decoration: none; border-radius: 999px; min-height: 48px; display: inline-flex; align-items: center; }
  .go { background: var(--cta-btn-bg); color: var(--cta-btn-fg); font-weight: 800; padding: 0 24px; }
  .ghost { color: var(--cta-btn2); font-weight: 700; padding: 0 22px; border: 1.5px solid var(--cta-btn2); }
  .go:hover { color: var(--cta-btn-fg); opacity: 0.92; }
  .ghost:hover { color: var(--cta-btn2); opacity: 0.85; }
  .quiet { background: var(--surface); border: 1px solid var(--line); }
  .quiet h2 { color: var(--ink); font-size: clamp(24px, 3vw, 30px); }
  .quiet p { color: var(--body); text-wrap: pretty; }
  .quiet .go { background: var(--hl-bg); color: var(--hl-fg); }
  .quiet .go:hover { color: var(--hl-fg); }
  .quiet .ghost, .quiet .ghost:hover { color: var(--ink); border-color: var(--line-strong); }
  @media (max-width: 640px) {
    .actions { justify-content: flex-start; }
  }
</style>
