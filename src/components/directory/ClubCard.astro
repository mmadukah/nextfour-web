---
// A club on an area page: the venue image slot (the photo the app shows for
// the club, until venues have their own), name, venue and tags, one row per
// session, and the way to its own page. The finder's search results build
// this same markup in its script; keep the two in step. Styles:
// src/styles/club-card.css.
import NightLine from './NightLine.astro';
import { clubPhoto, sortedRows, type Club } from '../../data/directory';

interface Props { club: Club }
const { club } = Astro.props;
const photo = clubPhoto(club.id);
const rows = sortedRows(club);
const days = [...new Set(rows.map((r) => r.day).filter((d) => d != null))];
---

<article class="club-card" data-days={days.join(',')}>
  <div class="cc-slot">
    <img src={photo.src} alt="" loading="lazy" decoding="async" width="720" height="480" style={`object-position: ${photo.position}`} />
  </div>
  <div class="cc-body">
    <div class="cc-top">
      <div class="cc-who">
        <h3 class="cc-name"><a href={club.url}>{club.name}</a></h3>
        <p class="cc-venue">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
          {club.venue.name}
        </p>
      </div>
      <div class="cc-tags">
        {club.claimed && <span class="tag lime">Runs on NextFour</span>}
        {!club.takingNewPlayers && <span class="tag warn">Not taking new players</span>}
        {club.visitorPolicy ? <span class="tag ok">Visitor terms listed</span> : <span class="tag">No visitor info yet</span>}
      </div>
    </div>
    <ul class="cc-lines">
      {rows.map((row) => <NightLine row={row} clubVenue={club.venue.name} />)}
    </ul>
    <a class="cc-more" href={club.url}>
      Club details and visitor info
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
  </div>
</article>
