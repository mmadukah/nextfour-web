---
// A drop-in listing on an area page (REDESIGN-BRIEF, "Drop-in session
// cards"): a session run by a leisure operator, not a club, on the same card
// as the clubs so the list reads as one family. What tells it apart is the
// building icon, the tags, the price and the button, never a bright panel:
// the panel takes the clubs' rotating tints. The finder's results build the
// same markup in its script; keep the two in step. The title links to the
// venue's page, which has the booking links and the clubs in the same hall.
import LevelBars from './LevelBars.astro';
import {
  dropInRows, durationText, timeRange, daysPlural, levelBars, clubTint, openLink, claimedSessionId, DAY_LETTERS, WEEK_ORDER, type DropInVenue,
} from '../../data/directory';

interface Props { venue: DropInVenue }
const { venue } = Astro.props;
const rows = dropInRows(venue);
const days = [...new Set(rows.flatMap((r) => r.days))];
// Join in the app only where someone runs the session on NextFour: nobody
// can join one nobody runs. Otherwise the card opens the venue page, with Book.
const claimedId = claimedSessionId(venue);
const claimed = claimedId !== null;
---

<article class="club-card dropin" id={venue.anchor} data-days={days.join(',')}>
  <div class="cc-slot" style={`background: ${clubTint(venue.id)}`}>
    <svg width="88" height="88" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-opacity="0.75" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M4 21V10l8-5 8 5v11"></path><path d="M9 21v-5h6v5"></path><path d="M8 11h2M14 11h2"></path></svg>
  </div>
  <div class="cc-body">
    <div class="cc-top">
      <div class="cc-who">
        <h3 class="cc-name"><a href={venue.venueUrl}>{venue.name}</a></h3>
        <p class="cc-venue">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
          {venue.venueName}, {venue.areaName}
        </p>
        {venue.operators.length > 0 && <p class="di-run">Run by {venue.operators.join(' and ')}</p>}
      </div>
      <div class="cc-tags">
        <span class="tag">Drop-in</span>
        {claimed && <span class="tag ok">Runs on NextFour</span>}
      </div>
    </div>
    <ul class="cc-lines">
      {rows.map((row) => {
        const s = row.session;
        const n = s.night;
        const duration = durationText(n);
        return (
          <li class="night-line" data-days={row.days.join(',')}>
            {row.label
              ? <span class="nl-day">{row.label}</span>
              : (
                <span class="day-strip" role="img" aria-label={daysPlural(row.days)}>
                  {WEEK_ORDER.map((d) => <span class:list={['ds-cell', { on: row.days.includes(d) }]} data-d={d} aria-hidden="true">{DAY_LETTERS[d]}</span>)}
                </span>
              )}
            <span class="nl-time"><b>{timeRange(n)}</b>{duration && <small>{duration}</small>}</span>
            {n.price && <span class="di-price"><b>{n.price.replace(' a session', '')}</b> per session</span>}
            {s.levelKnown && <LevelBars range={levelBars(n)} label={n.levels} />}
          </li>
        );
      })}
    </ul>
    {claimedId && <a class="di-join" href={openLink('session', claimedId, 'dropin')}>Join in the app</a>}
  </div>
</article>
