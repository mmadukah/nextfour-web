---
// A venue's drop-in sessions on an area page: sessions run by a leisure
// operator, not a club, that anyone books onto and pays for each time. Built
// from the club card's pieces (src/styles/club-card.css) so the two read as
// one family, with what differs: a ticket instead of the court, who runs
// them, a price and a booking link on each row, and the claim line, since
// each session can be claimed by whoever runs it. The finder's results build
// the same markup in its script; keep the two in step.
import { dropInRows, durationText, timeRange, daysPlural, DAY_LETTERS, WEEK_ORDER, type DropInVenue } from '../../data/directory';

interface Props { venue: DropInVenue }
const { venue } = Astro.props;
const rows = dropInRows(venue);
const days = [...new Set(rows.flatMap((r) => r.days))];
const anyClaimed = venue.sessions.some((s) => s.claimed);
const anyUnclaimed = venue.sessions.some((s) => !s.claimed);
---

<article class="club-card dropin" id={venue.anchor} data-days={days.join(',')}>
  <div class="cc-slot di-slot">
    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a3 3 0 0 0 0 6v3a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-3a3 3 0 0 0 0-6V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1z"></path><path d="M14 5v2M14 11v2M14 17v2"></path></svg>
  </div>
  <div class="cc-body">
    <div class="cc-top">
      <div class="cc-who">
        <h3 class="cc-name">{venue.name}</h3>
        {venue.operators.length > 0 && <p class="cc-venue">Run by {venue.operators.join(' and ')}</p>}
      </div>
      <div class="cc-tags">
        <span class="tag">Drop-in</span>
        {anyClaimed && <span class="tag lime">Runs on NextFour</span>}
      </div>
    </div>
    <ul class="cc-lines">
      {rows.map((row) => {
        const s = row.session;
        const n = s.night;
        const duration = durationText(n);
        return (
          <li class="night-line" data-days={row.days.join(',')}>
            {row.label
              ? <span class="nl-day">{row.label}</span>
              : (
                <span class="day-strip" role="img" aria-label={daysPlural(row.days)}>
                  {WEEK_ORDER.map((d) => <span class:list={['ds-cell', { on: row.days.includes(d) }]} data-d={d} aria-hidden="true">{DAY_LETTERS[d]}</span>)}
                </span>
              )}
            <span class="nl-time"><b>{timeRange(n)}</b>{duration && <small>{duration}</small>}</span>
            <span class="di-what">{s.title}{n.price && <b> · {n.price.replace(' a session', '')}</b>}</span>
            {s.claimed
              ? <a class="di-book" href="/get.html">Join in the app</a>
              : s.bookingUrl && <a class="di-book" href={s.bookingUrl} rel="noopener nofollow" target="_blank">Book<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"></path></svg></a>}
          </li>
        );
      })}
    </ul>
    {anyUnclaimed && (
      <p class="di-claim">Run one of these sessions? <a href="/get.html">Claim it in the NextFour app</a> to take sign-ups and run the night with a digital pegboard.</p>
    )}
  </div>
</article>
