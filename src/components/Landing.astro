---
// The home page, rendered from a per-language strings table so the same
// markup serves / (en) and /fr/ (fr). Design: REDESIGN-BRIEF, "Home page",
// in the site's shared header (Directory.astro) with its own footer. The
// words are the table's; the design only adds the short labels marked below.
import Directory from '../layouts/Directory.astro';
import { PLAY_URL, APP_STORE_URL } from '../store-links';
import { INSTAGRAM_URL, FACEBOOK_URL } from '../social-links';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const locales = ['en', 'fr'] as const;
const localeNames: Record<string, string> = { en: 'English', fr: 'Français' };

type Step = { title: string; body: string };
type Path = { label: string; sub: string };
type Shot = { src: string; alt: string };
// One moment of the night, shown on the device it happens on.
type Beat = { time: string; title: string; body: string; shot: Shot; device: 'tablet' | 'phone' };
type Plan = { name: string; body: string };
type Strings = {
  title: string;
  description: string;
  ogDescription: string;
  heroLine1: string;
  heroLine2: string;
  lead: string;
  pathPlayers: Path;
  pathHosts: Path;
  heroBoard: Shot;
  heroPhone: Shot;
  ctaPlay: string;
  ctaAppStore: string;
  note: string;
  qr: { head: string; body: string; alt: string };
  players: {
    kicker: string;
    head: string;
    body: string;
    night: string;
    calloutHead: string;
    /** Link text for the badminton club finder (English-only pages). */
    find: string;
    calloutBody: string;
    shot: Shot;
  };
  hosts: {
    kicker: string;
    head: string;
    body: string;
    terminal: string;
    help: string;
    shot: Shot;
  };
  story: { head: string; sub: string; beats: Beat[]; ending: string };
  pricing: { head: string; sub: string; plans: Plan[]; note: string };
  stepsHead: string;
  stepsSub: string;
  steps: Step[];
  closingHead: string;
  closingSub: string;
  nav: { clubs: string; howItWorks: string; support: string; privacy: string; terms: string; delete: string };
  questions: string;
  copyright: string;
  // Labels the redesign adds.
  sportsLead: string;
  sportsLabel: string;
  sports: string[];
  findPlaceholder: string;
  storyLink: string;
  endingTitle: string;
  plansKicker: string;
  setupKicker: string;
};

const content: Record<string, Strings> = {
  en: {
    title: 'NextFour: Find a game, run your club night',
    description:
      'NextFour is the app for racket sport club nights. Find badminton, squash, tennis, padel and table tennis near you, or run your night with a digital pegboard.',
    ogDescription:
      'Find a game near you, or run your club night: live courts, a digital pegboard and fair picks, all in one app.',
    heroLine1: 'Find a game.',
    heroLine2: 'Run the night.',
    lead: 'NextFour is the app for racket sport club nights. Players find sessions near them. Organisers run the courts, the queue and the picks from one phone.',
    pathPlayers: { label: 'I want to play', sub: 'Find club nights near you' },
    pathHosts: { label: 'I run a club night', sub: 'Courts, queue and picks, sorted' },
    heroBoard: { src: '/screens/board-tablet.webp', alt: 'The live board on a tablet, with three courts in play' },
    heroPhone: { src: '/screens/pick-nudge.webp', alt: 'A phone showing the “Your turn to pick” prompt' },
    ctaPlay: 'Get it on Google Play',
    ctaAppStore: 'Download on the App Store',
    note: 'Free to get started. Built for badminton, squash, tennis, padel & table tennis.',
    qr: { head: 'On a computer?', body: 'Scan to get the app on your phone.', alt: 'QR code linking to the NextFour app' },
