const s = content[lang] ?? content.en;
const fr = lang === 'fr';
// Each store's badge in the page's language (Apple's French one is still to come).
const playBadge = fr ? '/badges/google-play-fr.png' : '/badges/google-play.png';
const localeHome = (loc: string) => (loc === 'en' ? '/' : `/${loc}/`);
const languages = locales.map((loc) => ({ lang: loc, label: localeNames[loc], href: localeHome(loc) }));
const site = Astro.site!;

// The players' and organisers' paragraphs as ticked points, sentence by sentence.
const sentences = (t: string) => t.split(/(?<=[.!?])\s+(?=[A-ZÀ-Ý])/);
const playerPoints = [...sentences(s.players.body), s.players.night];
const hostPoints = [s.hosts.body, s.hosts.terminal];
// "10:00pm. Everyone played, …": the time, then the rest.
const [, endTime, endText] = s.story.ending.match(/^(\S+)\.\s+(.*)$/) ?? ['', '', s.story.ending];

// Store links carry the "Get the app" tracking (REDESIGN-BRIEF): src=home.
const appStore = APP_STORE_URL && `${APP_STORE_URL}?ct=home`;
const play = PLAY_URL && `${PLAY_URL}&referrer=${encodeURIComponent('utm_source=nextfour_web&utm_campaign=home')}`;

const qrSvg = (await import('../../public/get-qr.svg?raw')).default;
const TICK = '<path d="m5 12 5 5 9-10"></path>';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NextFour',
  url: new URL('/', site).href,
  logo: new URL('/apple-touch-icon.png', site).href,
  email: 'support@nextfour.app',
  sameAs: [INSTAGRAM_URL, FACEBOOK_URL].filter(Boolean),
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NextFour',
  url: new URL('/', site).href,
  inLanguage: fr ? 'fr' : 'en-GB',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${new URL('/badminton.html', site).href}?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---

<Directory
  title={s.title}
  description={s.description}
  ogDescription={s.ogDescription}
  crumbs={[]}
  jsonLd={[orgLd, siteLd]}
  cta={false}
  lang={fr ? 'fr' : 'en'}
  languages={languages}
  footer="site"
  bare
>
  <!-- The hero is a club night, hour by hour: the product shown as the night it runs. -->
  <section class="x hero" aria-labelledby="night-h">
    <div class="hero-top">
      <h1 id="night-h">{s.story.head} <span class="accent">{s.story.accent}</span></h1>
      <div class="hero-side">
        <p class="lead">{s.story.sub}</p>
        <div class="stores">
          {appStore && <a href={appStore} aria-label={s.ctaAppStore}><img class="apple" src="/badges/app-store.svg" alt="" width="162" height="54" /></a>}
          {play && <a href={play} aria-label={s.ctaPlay}><img class="google" src={playBadge} alt="" width="207" height="80" /></a>}
        </div>
        <p class="note">{s.note}</p>
      </div>
    </div>
    <ol class="beats">
      {s.story.beats.map((b, i) => (
        <li>
          <span class="time">{b.time}</span>
          <h2 class="beat-h">{b.title}</h2>
          <p>{b.body}</p>
          {b.ways && <ul class="ways">{b.ways.map((w) => <li><b>{w.name}:</b> {w.body}</li>)}</ul>}
          <div class="shot">
            {b.device === 'tablet'
              ? <div class="tablet"><img src={b.shot.src} alt={b.shot.alt} width="720" height="430" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} /></div>
              : <div class="phone-crop"><div class="phone"><img src={b.shot.src} alt={b.shot.alt} width="540" height="1116" loading="lazy" /></div></div>}
          </div>
        </li>
      ))}
      <li class="done">
        <span class="time">{endTime}</span>
        <h2 class="beat-h">{s.endingTitle}</h2>
        <p>{endText}</p>
        <div class="shot" aria-hidden="true"><svg width="88" height="88" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path></svg></div>
      </li>
    </ol>
    <div class="hero-links">
      <a class="arrow" href="/badminton.html">{s.listed}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      <a class="arrow" href={fr ? '/fr/how-it-works.html' : '/how-it-works.html'}>{s.storyLink}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
  </section>

  <section class="band" id="players" aria-labelledby="pl-h">
    <div class="x split">
      <div class="phones">
        <div class="phone"><img src={s.players.shot.src} alt={s.players.shot.alt} width="508" height="1074" loading="lazy" /></div>
        <div class="phone raised"><img src={s.hosts.shot.src} alt={s.hosts.shot.alt} width="540" height="1116" loading="lazy" /></div>
      </div>
      <div class="copy">
        <h2 id="pl-h">{s.players.head}</h2>
        <ul class="ticks">{playerPoints.map((p) => <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={TICK} /><span>{p}</span></li>)}</ul>
        <form class="find" action="/badminton.html" method="get" role="search">
          <label for="hq">{s.players.calloutHead}</label>
          <div class="find-row">
            <input id="hq" name="q" type="search" placeholder={s.findPlaceholder} autocomplete="off" data-lpignore="true" data-1p-ignore data-form-type="other" />
            <button type="submit">{s.players.find}</button>
          </div>
          <p>{s.players.calloutBody}</p>
        </form>
      </div>
    </div>
  </section>

  <section class="x split org" id="organisers" aria-labelledby="org-h">
    <div class="copy">
      <h2 id="org-h">{s.hosts.head}</h2>
      <ul class="ticks">{hostPoints.map((p) => <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={TICK} /><span>{p}</span></li>)}</ul>
      {/* An organiser sent by their players ("show your organiser") finds the night they can claim. */}
      <a class="claim" href="/badminton.html">{s.hosts.claim}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      <p class="help">{s.hosts.help} <a href="mailto:support@nextfour.app">support@nextfour.app</a>.</p>
    </div>
    <div class="org-art"><div class="tablet"><img src={s.heroBoard.src} alt={s.heroBoard.alt} width="720" height="430" loading="lazy" /></div></div>
  </section>

  <section class="band" aria-labelledby="price-h">
    <div class="x">
      <div class="sec-top">
        <h2 id="price-h">{s.pricing.head}</h2>
        <p class="side">{s.pricing.sub} {s.pricing.note}</p>
      </div>
      <ul class="plans">
        {s.pricing.plans.map((p, i) => <li class:list={['plan', { featured: i === 0 }]}><b>{p.name}</b><p>{p.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="x setup" aria-labelledby="setup-h">
    <div class="setup-copy">
      <h2 id="setup-h">{s.stepsHead}</h2>
      <p class="sub">{s.stepsSub}</p>
    </div>
    <ol class="steps">
      {s.steps.map((st, i) => <li><span class="n">{i + 1}</span><span><b>{st.title}</b><span>{st.body}</span></span></li>)}
    </ol>
  </section>

  <section class="x closing-wrap" aria-labelledby="cta-h">
    <div class="closing">
      <div class="closing-copy">
        <h2 id="cta-h">{s.closingHead}</h2>
        <p>{s.closingSub}</p>
        <div class="stores">
          {appStore && <a href={appStore} aria-label={s.ctaAppStore}><img class="apple" src="/badges/app-store.svg" alt="" width="162" height="54" loading="lazy" /></a>}
          {play && <a href={play} aria-label={s.ctaPlay}><img class="google" src={playBadge} alt="" width="207" height="80" loading="lazy" /></a>}
        </div>
      </div>
      <figure class="qr">
        <div class="code" role="img" aria-label={s.qr.alt} set:html={qrSvg} />
        <figcaption><strong>{s.qr.head}</strong>{s.qr.body}</figcaption>
      </figure>
    </div>
  </section>

</Directory>

<style>
  .x { max-width: 1120px; margin: 0 auto; padding-left: var(--pad); padding-right: var(--pad); box-sizing: border-box; }
  .band { background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  h2 { margin: 0; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.02; font-weight: 800; font-stretch: 114%; letter-spacing: -0.03em; }
  h2 { text-wrap: balance; }
  .lead, .ticks, .beats p, .ways, .closing p { text-wrap: pretty; }
  #players, #organisers { scroll-margin-top: 12px; }

  /* Device frames around the real screenshots. */
  .tablet { width: 100%; box-sizing: border-box; padding: 7px; border-radius: 20px; background: #0B0F14; box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.45); }
  .phone { width: 100%; box-sizing: border-box; padding: 5px; border-radius: 28px; background: #0B0F14; box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.45); }
  .tablet img, .phone img { display: block; width: 100%; height: auto; }
  .tablet img { border-radius: 13px; }
  .phone img { border-radius: 23px; }

  /* The hero: the headline and the way in, then the night along a rail. */
  .hero { padding-top: clamp(28px, 5vw, 64px); padding-bottom: clamp(48px, 6vw, 80px); }
  .hero-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 56px; }
  h1 { flex: 999 1 560px; min-width: 0; margin: 0; font-size: clamp(46px, 7.4vw, 96px); line-height: 0.94; font-stretch: 118%; letter-spacing: -0.035em; text-wrap: balance; }
  .accent { display: block; color: var(--eyebrow); }
  .hero-side { flex: 1 1 320px; max-width: 420px; display: flex; flex-direction: column; gap: 16px; }
  .lead { margin: 0; font-size: 18px; color: var(--body); }
  .note { margin: 0; font-size: 14px; color: var(--muted); }
  .stores { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .stores a { display: inline-flex; align-items: center; min-height: 56px; }
  .stores img.apple { height: 54px; width: auto; }
  .stores img.google { height: 80px; width: auto; margin: -12px; }

  .split { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(48px, 7vw, 88px); }
  .phones { flex: 1 1 340px; min-width: 0; display: flex; justify-content: center; gap: 16px; align-items: flex-end; }
  .phones .phone { width: 46%; max-width: 230px; }
  .phones .phone.raised { margin-bottom: 40px; }
  .copy { flex: 999 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 17px; color: var(--body); }
  .ticks li { display: flex; gap: 10px; }
  .ticks svg { flex: 0 0 auto; margin-top: 3px; color: var(--eyebrow); }
  .find { margin-top: 6px; padding: 18px; border-radius: 18px; background: var(--bg); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; }
  .find label { font-weight: 800; }
  .find-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .find input {
    flex: 999 1 220px; min-width: 0; height: 52px; box-sizing: border-box; padding: 0 16px; border-radius: 12px;
    border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--ink); font: inherit; font-size: 16px;
  }
  .find input:focus { outline: none; border-color: var(--eyebrow); box-shadow: 0 0 0 1.5px var(--eyebrow); }
  .find input::placeholder { color: var(--muted); opacity: 1; }
  .find input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .find button { flex: 1 1 auto; height: 52px; padding: 0 22px; border-radius: 12px; border: 0; background: var(--hl-bg); color: var(--hl-fg); font: inherit; font-weight: 800; cursor: pointer; }
  .find p { margin: 0; font-size: 14px; color: var(--muted); }
  .org { padding-bottom: 32px; }
  .org-art { flex: 1 1 380px; min-width: 0; }
  .claim {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px;
    border-radius: 999px; background: var(--btn-bg); color: var(--btn-fg); font-weight: 800; text-decoration: none;
  }
  .claim:hover { color: var(--btn-fg); filter: brightness(1.08); }
  .help { margin: 0; font-size: 15px; color: var(--muted); }

  .arrow { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 700; }
  .sec-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; margin-bottom: 24px; }

  /* The night: four moments on a rail, each over the screen it happens on. */
  .beats { list-style: none; margin: clamp(36px, 5vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; position: relative; }
  .beats::before { content: ''; position: absolute; left: 8px; right: 8px; top: 15px; height: 2px; background: var(--line-strong); }
  .beats > li { position: relative; padding-top: 42px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .beats > li::before { content: ''; position: absolute; left: 0; top: 8px; width: 16px; height: 16px; border-radius: 999px; background: var(--ink); box-shadow: 0 0 0 4px var(--bg); }
  .beats > .done::before { background: var(--hl-bg); box-shadow: 0 0 0 4px var(--bg), 0 0 0 5px var(--ink); }
  .time { align-self: flex-start; font-size: 14px; font-weight: 800; padding: 3px 10px; border-radius: 999px; background: var(--chip-bg); color: var(--chip-fg); font-variant-numeric: tabular-nums; }
  .done .time { background: var(--hl-bg); color: var(--hl-fg); }
  .beat-h { margin: 0; font-size: 22px; line-height: 1.15; font-weight: 800; font-stretch: 106%; letter-spacing: 0; }
  .beats p { margin: 0; font-size: 15px; color: var(--body); }
  .ways { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: var(--body); }
  .ways li { padding-left: 12px; border-left: 1px solid var(--line-strong); }
  .ways b { color: var(--ink); }
  .beats .shot { margin-top: auto; height: 190px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 14px; background: var(--row); }
  .beats .shot .tablet { width: 90%; }
  .beats .done .shot { background: var(--hl-bg); color: var(--hl-fg); }
  /* Anchored to the foot of the phone, where the "Your turn to pick" bar sits. */
  .phone-crop { display: flex; justify-content: center; align-items: flex-end; width: 100%; height: 100%; background: var(--row); border-radius: 14px; padding-bottom: 14px; box-sizing: border-box; overflow: hidden; }
  .phone-crop .phone { width: 52%; }
  .hero-links { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 4px 28px; }
  /* Two by two on a tablet; on a phone the rail runs down the side and the words carry it. */
  @media (max-width: 980px) {
    .beats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 32px; }
    .beats::before { display: none; }
  }
  @media (max-width: 600px) {
    .beats { grid-template-columns: 1fr; row-gap: 0; padding-left: 30px; }
    .beats::before { display: block; left: 7px; right: auto; top: 10px; bottom: 10px; width: 2px; height: auto; }
    .beats > li { padding: 0 0 24px; }
    .beats > li::before { left: -30px; top: 4px; }
    .beats .shot { display: none; }
    .beats .done { padding-bottom: 0; }
  }

  .band > .x { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(48px, 7vw, 88px); }
  .side { margin: 0; max-width: 360px; font-size: 15px; color: var(--muted); }
  .plans { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 12px; }
  .plan { padding: 22px; border-radius: 20px; display: flex; flex-direction: column; gap: 12px; background: var(--surface); color: var(--body); border: 1.5px solid var(--line); font-size: 15px; }
  .plan b { font-size: 24px; font-weight: 800; font-stretch: 112%; color: var(--ink); }
  .plan p { margin: 0; }
  .plan.featured { background: var(--sel-bg); color: var(--sel-fg); border-color: var(--sel-bg); }
  .plan.featured b { color: inherit; }

  .setup { padding-top: clamp(48px, 7vw, 88px); padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 32px 48px; }
  .setup-copy { flex: 1 1 320px; min-width: 0; }
  .setup-copy .sub { margin: 16px 0 0; font-size: 17px; color: var(--body); }
  .steps { flex: 999 1 460px; min-width: 0; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .steps li { display: flex; gap: 16px; align-items: flex-start; padding: 20px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); }
  .steps .n { flex: 0 0 44px; height: 44px; border-radius: 999px; background: var(--hl-bg); color: var(--hl-fg); font-weight: 800; font-size: 18px; display: flex; align-items: center; justify-content: center; }
  .steps li > span:last-child { display: flex; flex-direction: column; gap: 4px; }
  .steps b { font-size: 18px; font-weight: 800; }
  .steps li > span:last-child > span { font-size: 15px; color: var(--body); }

  .closing-wrap { padding-top: 32px; padding-bottom: 64px; }
  .closing { background: var(--cta-bg); border-radius: 28px; padding: clamp(28px, 5vw, 56px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .closing-copy { flex: 999 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .closing h2 { color: var(--cta-head); }
  .closing p { margin: 0; max-width: 520px; font-size: 17px; color: var(--cta-body); }
  /* On white in either theme, so cameras read it. */
  .qr { flex: 0 0 auto; margin: 0; display: flex; align-items: center; gap: 16px; padding: 16px; border-radius: 18px; background: #FFFFFF; }
  .qr .code { line-height: 0; }
  .qr .code :global(svg) { width: 116px; height: 116px; display: block; }
  .qr figcaption { max-width: 130px; font-size: 14px; color: #12261C; line-height: 1.35; }
  .qr strong { display: block; }
  @media (max-width: 640px) {
    .qr { display: none; }
  }

</style>
