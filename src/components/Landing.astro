const s = content[lang] ?? content.en;
// Clean per-locale homepage paths: / for the default, /<loc>/ otherwise.
const localeHome = (loc: string) => (loc === 'en' ? '/' : `/${loc}/`);
const homeUrl = (loc: string) => new URL(localeHome(loc), Astro.site).href;
const alternates = [
  ...locales.map((loc) => ({ hreflang: loc, href: homeUrl(loc) })),
  { hreflang: 'x-default', href: homeUrl('en') },
];
---

<Base
  title={s.title}
  description={s.description}
  ogDescription={s.ogDescription}
  lang={lang}
>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nunito-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
  </Fragment>

  <style is:global>
    /* Fonts are self-hosted (latin subset, variable weight). Loading them
       from Google would send every visitor's IP address to Google. */
    @font-face {
      font-family: 'Montserrat';
      font-style: normal;
      font-weight: 800 900;
      font-display: swap;
      src: url(/fonts/montserrat-latin.woff2) format('woff2');
    }
    @font-face {
      font-family: 'Nunito Sans';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url(/fonts/nunito-sans-latin.woff2) format('woff2');
    }

    /* Brand kit: the same navy, card and lime as the app and the social
       posts, so a visitor arriving from either recognises the page. */
    :root {
      color-scheme: dark;
      --accent: #c8f135;
      --accent-dark: #b4dc22;
      --on-accent: #0f1923;
      --ink: #f2f5f7;
      --muted: #9aa7b5;
      --bg: #0f1923;
      --card: #192230;
      --card-2: #232f40;
      --border: #2a3a4a;
      --head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      margin: 0;
      line-height: 1.6;
      color: var(--ink);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); }
    h1, h2, h3 { font-family: var(--head); }
    .wrap { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem; }
    img { max-width: 100%; }

    /* ---------- Top bar ---------- */
    .topbar { display: flex; justify-content: space-between; align-items: center; padding-top: 1.25rem; }
    .brand {
      font-family: var(--head);
      font-weight: 800;
      letter-spacing: 0.35em;
      font-size: 0.85rem;
      color: var(--ink);
      text-transform: uppercase;
    }
    .langbar { display: flex; gap: 0.85rem; font-size: 0.85rem; }
    .langbar a { color: var(--muted); text-decoration: none; }
    .langbar a[aria-current="true"] { color: var(--ink); font-weight: 700; }

    /* ---------- Hero ---------- */
    .hero {
      background: radial-gradient(110% 90% at 85% 10%, #1b2a3a 0%, var(--bg) 60%);
      padding: 0 0 4.5rem;
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: center;
      padding-top: 3.5rem;
    }
    .hero h1 {
      font-size: clamp(2.5rem, 6vw, 4rem);
      line-height: 1.02;
      margin: 0 0 1.1rem;
      font-weight: 900;
      letter-spacing: -0.02em;
    }
    .hero h1 .accent { color: var(--accent); }
    .hero p.lead {
      font-size: clamp(1.05rem, 2.2vw, 1.2rem);
      color: var(--muted);
      max-width: 42ch;
      margin: 0 0 1.75rem;
    }
    .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.75rem; max-width: 30rem; }
    .path {
      display: block;
      padding: 0.95rem 1.1rem;
      border-radius: 14px;
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--ink);
      text-decoration: none;
      transition: border-color .15s ease, transform .08s ease;
    }
    .path:hover { border-color: var(--accent); }
    .path:active { transform: translateY(1px); }
    .path strong { display: block; font-size: 1rem; }
    .path strong::after { content: ' \2192'; color: var(--accent); }
    .path span { color: var(--muted); font-size: 0.88rem; }

    .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
    .btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-weight: 700; font-size: 0.95rem;
      padding: 0.75rem 1.25rem; border-radius: 10px;
      text-decoration: none; transition: transform .08s ease, background .2s ease;
    }
    .btn:active { transform: translateY(1px); }
    .btn-primary { background: var(--accent); color: var(--on-accent); }
    .btn-primary:hover { background: var(--accent-dark); }
    .btn-ghost { background: var(--card); color: var(--ink); border: 1px solid var(--border); }
    .btn-ghost:hover { background: var(--card-2); }
    .hero .note { color: var(--muted); font-size: 0.85rem; margin: 1.25rem 0 0; }

    /* ---------- Device frames ---------- */
    .devices { position: relative; padding-bottom: 3rem; }
    .tablet {
      border: 10px solid #05080c;
      border-radius: 22px;
      background: #05080c;
      box-shadow: 0 30px 60px rgba(0,0,0,0.5);
      overflow: hidden;
    }
    .tablet img { display: block; width: 100%; height: auto; border-radius: 10px; }
    .phone {
      width: 100%;
      max-width: 270px;
      border: 8px solid #05080c;
      border-radius: 34px;
      background: #05080c;
      box-shadow: 0 24px 50px rgba(0,0,0,0.55);
      overflow: hidden;
    }
    .phone img { display: block; width: 100%; height: auto; border-radius: 26px; }
    .devices .phone {
      position: absolute;
      right: -0.5rem;
      bottom: 0;
      width: 36%;
      outline: 1px solid var(--border);
    }

    /* ---------- Audience sections ---------- */
    section.audience { padding: 5rem 0 2rem; scroll-margin-top: 1rem; }
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 3.5rem;
      align-items: center;
    }
    .split.flip .shot { order: 2; }
    .split .shot .phone { margin: 0 auto; }
    .kicker {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.6rem;
    }
    .split h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.1; margin: 0 0 1rem; font-weight: 900; }
    .split p { color: var(--muted); margin: 0 0 1rem; font-size: 1.05rem; }
    .callout {
      margin-top: 1.5rem;
      padding: 1.1rem 1.25rem;
      border-radius: 14px;
      background: var(--card);
      border-left: 4px solid var(--accent);
    }
    .callout strong { display: block; color: var(--ink); margin-bottom: 0.25rem; }
    .callout p { margin: 0; font-size: 0.98rem; }

    .section-head { text-align: center; max-width: 40ch; margin: 0 auto 2.75rem; }
    .section-head h2 { font-size: clamp(1.6rem, 4vw, 2.1rem); margin: 0 0 0.6rem; letter-spacing: -0.01em; }
    .section-head p { color: var(--muted); margin: 0; }

    /* ---------- One night, start to finish ---------- */
    section.story { padding: 5rem 0 1rem; border-top: 1px solid var(--border); }
    .beat { margin-bottom: 4rem; }
    /* A tablet board takes the wider column: it is unreadable small. */
    .beat.wide { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
    .beat .time {
      font-family: var(--head);
      font-weight: 800;
      font-size: 0.95rem;
      color: var(--accent);
      margin-bottom: 0.4rem;
    }
    .beat h3 { font-size: clamp(1.4rem, 3vw, 1.8rem); line-height: 1.15; margin: 0 0 0.75rem; font-weight: 900; }
    .beat .shot .phone { max-width: 250px; }
    .ending {
      max-width: 36ch;
      margin: 0 auto;
      text-align: center;
      font-family: var(--head);
      font-weight: 800;
      font-size: clamp(1.15rem, 2.6vw, 1.45rem);
      line-height: 1.35;
    }

    /* ---------- Pricing ---------- */
    section.pricing { padding: 5rem 0 1rem; }
    .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
    .plan {
      border: 1px solid var(--border); border-radius: 14px;
      padding: 1.3rem 1.3rem 1.4rem; background: var(--card);
    }
    .plan h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
    .plan p { margin: 0; color: var(--muted); font-size: 0.96rem; }
    .plan:first-child { border-color: var(--accent); }
    .plans-note { text-align: center; color: var(--muted); font-size: 0.88rem; margin: 1.25rem 0 0; }

    /* ---------- QR for desktop visitors ---------- */
    /* Only on a wide screen with a mouse: on a phone the store buttons are
       the way in, and a QR there would be one more thing to scroll past.
       It sits under the closing buttons, not in the hero, to keep the top clean. */
    .qr { display: none; }
    @media (min-width: 821px) and (hover: hover) and (pointer: fine) {
      .qr {
        display: flex; align-items: center; gap: 0.9rem; text-align: left;
        margin: 2rem auto 0; padding: 0.75rem; max-width: 22rem;
        background: var(--card); border: 1px solid var(--border); border-radius: 14px;
      }
    }
    .qr img { width: 88px; height: 88px; border-radius: 8px; flex: none; }
    .qr strong { display: block; font-size: 0.95rem; }
    .qr span { color: var(--muted); font-size: 0.88rem; }

    /* ---------- How it works ---------- */
    section.steps { padding: 3.5rem 0; }
    .steps ol { counter-reset: step; list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); }
    .steps li { position: relative; padding: 1.3rem 1.3rem 1.3rem 3.5rem; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
    .steps li::before {
      counter-increment: step; content: counter(step);
      position: absolute; left: 1.1rem; top: 1.2rem;
      width: 1.7rem; height: 1.7rem; border-radius: 50%;
      background: var(--accent); color: var(--on-accent); font-weight: 800; font-size: 0.9rem;
      display: grid; place-items: center;
    }
    .steps li strong { display: block; margin-bottom: 0.2rem; }
    .steps li span { color: var(--muted); font-size: 0.95rem; }

    /* ---------- Closing CTA ---------- */
    section.closing { text-align: center; padding: 4rem 0 4.5rem; }
    section.closing h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0 0 0.5rem; }
    section.closing p { color: var(--muted); margin: 0 0 1.75rem; }
    section.closing .cta-row { justify-content: center; }

    /* ---------- Footer ---------- */
    footer { border-top: 1px solid var(--border); padding: 2.5rem 0 3rem; }
    footer .cols { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; align-items: center; }
    footer nav a { color: var(--ink); text-decoration: none; margin-right: 1.25rem; font-size: 0.92rem; opacity: 0.85; }
    footer nav a:hover { opacity: 1; text-decoration: underline; }
    footer .small { color: var(--muted); font-size: 0.85rem; margin-top: 1.5rem; }
    footer .social { display: flex; gap: 1rem; }
    footer .social a { color: var(--ink); opacity: 0.85; display: inline-flex; }
    footer .social a:hover { opacity: 1; }
    footer .social svg { width: 22px; height: 22px; fill: currentColor; }

    /* ---------- Narrow screens ---------- */
    @media (max-width: 820px) {
      .hero-grid, .split, .beat.wide { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
      .hero-grid { padding-top: 2.5rem; }
      .split.flip .shot { order: 0; }
      .split .shot .phone { max-width: 240px; }
      .devices { max-width: 560px; margin: 0 auto; width: 100%; }
    }
    @media (max-width: 420px) {
      .paths { grid-template-columns: minmax(0, 1fr); }
    }
  </style>

  <!-- ============ HERO ============ -->
  <!-- Two audiences, two doors: players find a game, organisers run the
       night. The devices show one of each: the board a club sees on the
       night, and the nudge a player gets on their phone. -->
  <header class="hero">
    <div class="wrap topbar">
      <div class="brand">NextFour</div>
      <nav class="langbar" aria-label="Language">
        {locales.map((loc) => (
          <a
            href={localeHome(loc)}
            aria-current={loc === lang ? 'true' : undefined}
            hreflang={loc}
          >{localeNames[loc]}</a>
        ))}
      </nav>
    </div>
    <div class="wrap hero-grid">
      <div>
        <h1>{s.heroLine1}<br /><span class="accent">{s.heroLine2}</span></h1>
        <p class="lead">{s.lead}</p>
        <div class="paths">
          <a class="path" href="#players"><strong>{s.pathPlayers.label}</strong><span>{s.pathPlayers.sub}</span></a>
          <a class="path" href="#organisers"><strong>{s.pathHosts.label}</strong><span>{s.pathHosts.sub}</span></a>
        </div>
        <div class="cta-row">
          {PLAY_URL && <a class="btn btn-primary" href={PLAY_URL}>{s.ctaPlay}</a>}
          {APP_STORE_URL && <a class="btn btn-ghost" href={APP_STORE_URL}>{s.ctaAppStore}</a>}
        </div>
        <p class="note">{s.note}</p>
      </div>
      <div class="devices">
        <div class="tablet">
          <img src={s.heroBoard.src} alt={s.heroBoard.alt} width="720" height="430" decoding="async" fetchpriority="high" />
        </div>
        <div class="phone">
          <img src={s.heroPhone.src} alt={s.heroPhone.alt} width="540" height="1116" decoding="async" />
        </div>
      </div>
    </div>
  </header>

  <!-- ============ FOR PLAYERS ============ -->
  <section class="audience" id="players">
    <div class="wrap split">
      <div class="shot">
        <div class="phone">
          <img src={s.players.shot.src} alt={s.players.shot.alt} width="508" height="1074" loading="lazy" decoding="async" />
        </div>
      </div>
      <div>
        <span class="kicker">{s.players.kicker}</span>
        <h2>{s.players.head}</h2>
        <p>{s.players.body}</p>
        <p>{s.players.night}</p>
        <div class="callout">
          <strong>{s.players.calloutHead}</strong>
          <p>{s.players.calloutBody}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FOR ORGANISERS ============ -->
  <section class="audience" id="organisers">
    <div class="wrap split flip">
      <div class="shot">
        <div class="phone">
          <img src={s.hosts.shot.src} alt={s.hosts.shot.alt} width="540" height="1116" loading="lazy" decoding="async" />
        </div>
      </div>
      <div>
        <span class="kicker">{s.hosts.kicker}</span>
        <h2>{s.hosts.head}</h2>
        <p>{s.hosts.body}</p>
        <p>{s.hosts.terminal}</p>
        <p>{s.hosts.help} <a href="mailto:clubs@nextfour.app?subject=NextFour%20club%20night">clubs@nextfour.app</a>.</p>
      </div>
    </div>
  </section>

  <!-- ============ ONE NIGHT ============ -->
  <!-- One club night told in three moments, each on the device it happens
       on. The loops are the app's own host intro (racket-manager-app
       assets/onboarding), so the site shows the real product moving. -->
  <section class="story">
    <div class="wrap">
      <div class="section-head">
        <h2>{s.story.head}</h2>
        <p>{s.story.sub}</p>
      </div>
      {s.story.beats.map((beat, i) => (
        <div class:list={['split', 'beat', { flip: i % 2 === 1, wide: beat.device === 'tablet' }]}>
          <div class="shot">
            {beat.device === 'tablet' ? (
              <div class="tablet">
                <img src={beat.shot.src} alt={beat.shot.alt} width="720" height="430" loading="lazy" decoding="async" />
              </div>
            ) : (
              <div class="phone">
                <img src={beat.shot.src} alt={beat.shot.alt} width="540" height="1116" loading="lazy" decoding="async" />
              </div>
            )}
          </div>
          <div>
            <div class="time">{beat.time}</div>
            <h3>{beat.title}</h3>
            <p>{beat.body}</p>
          </div>
        </div>
      ))}
      <p class="ending">{s.story.ending}</p>
    </div>
  </section>

  <!-- ============ PRICING ============ -->
  <section class="pricing">
    <div class="wrap">
      <div class="section-head">
        <h2>{s.pricing.head}</h2>
        <p>{s.pricing.sub}</p>
      </div>
      <div class="plans">
        {s.pricing.plans.map((plan) => (
          <div class="plan">
            <h3>{plan.name}</h3>
            <p>{plan.body}</p>
          </div>
        ))}
      </div>
      <p class="plans-note">{s.pricing.note}</p>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="steps">
    <div class="wrap">
      <div class="section-head">
        <h2>{s.stepsHead}</h2>
        <p>{s.stepsSub}</p>
      </div>
      <ol>
        {s.steps.map((step) => (
          <li><strong>{step.title}</strong><span>{step.body}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ CLOSING CTA ============ -->
  <section class="closing">
    <div class="wrap">
      <h2>{s.closingHead}</h2>
      <p>{s.closingSub}</p>
      <div class="cta-row">
        {PLAY_URL && <a class="btn btn-primary" href={PLAY_URL}>{s.ctaPlay}</a>}
        {APP_STORE_URL && (
          <a class="btn btn-ghost" href={APP_STORE_URL}>{s.ctaAppStore}</a>
        )}
      </div>
      <div class="qr">
        <img src="/get-app-qr.svg" alt={s.qr.alt} width="88" height="88" />
        <div><strong>{s.qr.head}</strong><span>{s.qr.body}</span></div>
      </div>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer>
    <div class="wrap">
      <div class="cols">
        <div class="brand">NextFour</div>
        <nav>
          <a href={getRelativeLocaleUrl(lang, 'how-it-works.html')}>{s.nav.howItWorks}</a>
          <a href={getRelativeLocaleUrl(lang, 'support.html')}>{s.nav.support}</a>
          <a href={getRelativeLocaleUrl(lang, 'privacy.html')}>{s.nav.privacy}</a>
          <a href={getRelativeLocaleUrl(lang, 'terms.html')}>{s.nav.terms}</a>
          <a href={getRelativeLocaleUrl(lang, 'delete-account.html')}>{s.nav.delete}</a>
        </nav>
        <div class="social">
          {INSTAGRAM_URL && (
            <a href={INSTAGRAM_URL} aria-label="Instagram" title="Instagram" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1C2.6 9.9 2.6 10.3 2.6 12s0 2.1.1 3.3c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4C15.5 4 15.1 4 12 4zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8zm0 8.1a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.2-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0z"/></svg>
            </a>
          )}
          {FACEBOOK_URL && (
            <a href={FACEBOOK_URL} aria-label="Facebook" title="Facebook" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>
            </a>
          )}
        </div>
      </div>
      <p class="small">
        {s.questions} <a href="mailto:support@nextfour.app?subject=NextFour">support@nextfour.app</a>.<br />
        {s.copyright}
      </p>
    </div>
  </footer>
</Base>
