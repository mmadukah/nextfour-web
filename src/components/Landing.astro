---
// The home page, rendered from a per-language strings table so the same
// markup serves / (en) and /fr/ (fr). Design: REDESIGN-BRIEF, "Home page",
// in the site's shared header (Directory.astro) with its own footer. The
// words are the table's; the design only adds the short labels marked below.
import Directory from '../layouts/Directory.astro';
import { PLAY_URL, APP_STORE_URL } from '../store-links';
import { INSTAGRAM_URL, FACEBOOK_URL } from '../social-links';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const locales = ['en', 'fr'] as const;
const localeNames: Record<string, string> = { en: 'English', fr: 'Français' };

type Step = { title: string; body: string };
type Shot = { src: string; alt: string };
// One moment of the night, shown on the device it happens on.
// `ways`: the picking methods, a line each, when the moment depends on how the club picks.
type Beat = { time: string; title: string; body: string; ways?: { name: string; body: string }[]; shot: Shot; device: 'tablet' | 'phone' };
type Plan = { name: string; body: string };
type Strings = {
  title: string;
  description: string;
  ogDescription: string;
  /** The live board on a tablet, shown beside the organisers' section. */
  heroBoard: Shot;
  /** The link to the session finder. */
  listed: string;
  ctaPlay: string;
  ctaAppStore: string;
  note: string;
  qr: { head: string; body: string; alt: string };
  players: {
    head: string;
    body: string;
    night: string;
    calloutHead: string;
    /** Link text for the badminton club finder (English-only pages). */
    find: string;
    calloutBody: string;
    shot: Shot;
  };
  hosts: {
    head: string;
    body: string;
    terminal: string;
    /** The organiser's way to their club's listing, in the finder (English-only pages). */
    claim: string;
    help: string;
    shot: Shot;
  };
  story: { head: string; accent: string; sub: string; beats: Beat[]; ending: string };
  pricing: { head: string; sub: string; plans: Plan[]; note: string };
  stepsHead: string;
  stepsSub: string;
  steps: Step[];
  closingHead: string;
  closingSub: string;
  nav: { clubs: string; howItWorks: string; support: string; privacy: string; terms: string; delete: string };
  questions: string;
  copyright: string;
  // Labels the redesign adds.
  sportsLead: string;
  sportsLabel: string;
  sports: string[];
  findPlaceholder: string;
  storyLink: string;
  endingTitle: string;
};

const content: Record<string, Strings> = {
  en: {
    title: 'NextFour: Find a game, run your session',
