---
// The marketing landing page, rendered from a per-language strings table so
// the same markup serves /  (en) and /fr/ (fr).
import Base from '../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { PLAY_URL, APP_STORE_URL } from '../store-links';
import { INSTAGRAM_URL, FACEBOOK_URL } from '../social-links';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const locales = ['en', 'fr'] as const;
const localeNames: Record<string, string> = { en: 'English', fr: 'Français' };

type Step = { title: string; body: string };
type Path = { label: string; sub: string };
type Shot = { src: string; alt: string };
// One moment of the night, shown on the device it happens on.
type Beat = { time: string; title: string; body: string; shot: Shot; device: 'tablet' | 'phone' };
type Plan = { name: string; body: string };
type Strings = {
  title: string;
  description: string;
  ogDescription: string;
  heroLine1: string;
  heroLine2: string;
  lead: string;
  pathPlayers: Path;
  pathHosts: Path;
  heroBoard: Shot;
  heroPhone: Shot;
  ctaPlay: string;
  ctaAppStore: string;
  note: string;
  qr: { head: string; body: string; alt: string };
  players: {
    kicker: string;
    head: string;
    body: string;
    night: string;
    calloutHead: string;
    calloutBody: string;
    shot: Shot;
  };
  hosts: {
    kicker: string;
    head: string;
    body: string;
    terminal: string;
    help: string;
    shot: Shot;
  };
  story: { head: string; sub: string; beats: Beat[]; ending: string };
  pricing: { head: string; sub: string; plans: Plan[]; note: string };
  stepsHead: string;
  stepsSub: string;
  steps: Step[];
  closingHead: string;
  closingSub: string;
  nav: { howItWorks: string; support: string; privacy: string; terms: string; delete: string };
  questions: string;
  copyright: string;
};

const content: Record<string, Strings> = {
