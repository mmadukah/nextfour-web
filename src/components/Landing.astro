    questions: 'Des questions ? Écrivez à',
    copyright: '© 2026 NextFour. Tous droits réservés.',
    sportsLead: 'Gratuit pour commencer. Conçu pour',
    sportsLabel: 'Sports',
    sports: ['Badminton', 'Squash', 'Tennis', 'Padel', 'Tennis de table'],
    findPlaceholder: 'Code postal, ville ou nom du club',
    storyLink: 'Les règles derrière tout ça',
    endingTitle: 'Tout le monde a joué',
    plansKicker: 'Formules',
    setupKicker: 'Pour commencer',
  },
};

const s = content[lang] ?? content.en;
const fr = lang === 'fr';
// Each store's badge in the page's language (Apple's French one is still to come).
const playBadge = fr ? '/badges/google-play-fr.png' : '/badges/google-play.png';
const localeHome = (loc: string) => (loc === 'en' ? '/' : `/${loc}/`);
const languages = locales.map((loc) => ({ lang: loc, label: localeNames[loc], href: localeHome(loc) }));
const site = Astro.site!;

// The players' and organisers' paragraphs as ticked points, sentence by sentence.
const sentences = (t: string) => t.split(/(?<=[.!?])\s+(?=[A-ZÀ-Ý])/);
const playerPoints = [...sentences(s.players.body), s.players.night];
const hostPoints = [s.hosts.body, s.hosts.terminal];
// "10:00pm. Everyone played, …": the time, then the rest.
const [, endTime, endText] = s.story.ending.match(/^(\S+)\.\s+(.*)$/) ?? ['', '', s.story.ending];

// Store links carry the "Get the app" tracking (REDESIGN-BRIEF): src=home.
const appStore = APP_STORE_URL && `${APP_STORE_URL}?ct=home`;
const play = PLAY_URL && `${PLAY_URL}&referrer=${encodeURIComponent('utm_source=nextfour_web&utm_campaign=home')}`;

const qrSvg = (await import('../../public/get-qr.svg?raw')).default;
const TICK = '<path d="m5 12 5 5 9-10"></path>';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NextFour',
  url: new URL('/', site).href,
  logo: new URL('/apple-touch-icon.png', site).href,
  email: 'support@nextfour.app',
  sameAs: [INSTAGRAM_URL, FACEBOOK_URL].filter(Boolean),
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NextFour',
  url: new URL('/', site).href,
  inLanguage: fr ? 'fr' : 'en-GB',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${new URL('/badminton.html', site).href}?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---

<Directory
  title={s.title}
  description={s.description}
  ogDescription={s.ogDescription}
  crumbs={[]}
  jsonLd={[orgLd, siteLd]}
  cta={false}
  lang={fr ? 'fr' : 'en'}
  languages={languages}
  footer="site"
  bare
>
  <section class="hero x">
    <div class="hero-copy">
      <h1>{s.heroLine1}<br /><span class="accent">{s.heroLine2}</span></h1>
      <p class="lead">{s.lead}</p>
      <div class="paths">
        <a class="path primary" href="#players"><span><b>{s.pathPlayers.label}</b><small>{s.pathPlayers.sub}</small></span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg></a>
        <a class="path" href="#organisers"><span><b>{s.pathHosts.label}</b><small>{s.pathHosts.sub}</small></span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg></a>
      </div>
      <div class="stores">
        {appStore && <a href={appStore} aria-label={s.ctaAppStore}><img class="apple" src="/badges/app-store.svg" alt="" width="162" height="54" /></a>}
        {play && <a href={play} aria-label={s.ctaPlay}><img class="google" src={playBadge} alt="" width="207" height="80" /></a>}
      </div>
      <div class="built">
        <p>{s.sportsLead}</p>
        <ul aria-label={s.sportsLabel}>{s.sports.map((sp) => <li>{sp}</li>)}</ul>
      </div>
    </div>
    <div class="hero-art">
      <div class="tablet"><img src={s.heroBoard.src} alt={s.heroBoard.alt} width="720" height="430" fetchpriority="high" /></div>
      <div class="phone overlap"><img src={s.heroPhone.src} alt={s.heroPhone.alt} width="540" height="1116" /></div>
    </div>
  </section>

  <section class="band" id="players" aria-labelledby="pl-h">
    <div class="x split">
      <div class="phones">
        <div class="phone"><img src={s.players.shot.src} alt={s.players.shot.alt} width="508" height="1074" loading="lazy" /></div>
        <div class="phone raised"><img src={s.hosts.shot.src} alt={s.hosts.shot.alt} width="540" height="1116" loading="lazy" /></div>
      </div>
      <div class="copy">
        <p class="eyebrow">{s.players.kicker}</p>
        <h2 id="pl-h">{s.players.head}</h2>
        <ul class="ticks">{playerPoints.map((p) => <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={TICK} /><span>{p}</span></li>)}</ul>
        <form class="find" action="/badminton.html" method="get" role="search">
          <label for="hq">{s.players.calloutHead}</label>
          <div class="find-row">
            <input id="hq" name="q" type="search" placeholder={s.findPlaceholder} autocomplete="off" data-lpignore="true" data-1p-ignore data-form-type="other" />
            <button type="submit">{s.players.find}</button>
          </div>
          <p>{s.players.calloutBody}</p>
        </form>
      </div>
    </div>
  </section>

  <section class="x split org" id="organisers" aria-labelledby="org-h">
    <div class="copy">
      <p class="eyebrow">{s.hosts.kicker}</p>
      <h2 id="org-h">{s.hosts.head}</h2>
      <ul class="ticks">{hostPoints.map((p) => <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={TICK} /><span>{p}</span></li>)}</ul>
      <p class="help">{s.hosts.help} <a href="mailto:support@nextfour.app">support@nextfour.app</a>.</p>
    </div>
    <div class="org-art"><div class="tablet"><img src={s.heroBoard.src} alt={s.heroBoard.alt} width="720" height="430" loading="lazy" /></div></div>
  </section>

  <section class="x night" aria-labelledby="night-h">
    <div class="sec-top">
      <div>
        <p class="eyebrow">{s.story.sub}</p>
        <h2 id="night-h">{s.story.head}</h2>
      </div>
      <a class="arrow" href={fr ? '/fr/how-it-works.html' : '/how-it-works.html'}>{s.storyLink}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
    <ol class="beats">
      {s.story.beats.map((b) => (
        <li>
          <div class="shot">
            {b.device === 'tablet'
              ? <div class="tablet"><img src={b.shot.src} alt={b.shot.alt} width="720" height="430" loading="lazy" /></div>
              : <div class="phone-crop"><div class="phone"><img src={b.shot.src} alt={b.shot.alt} width="540" height="1116" loading="lazy" /></div></div>}
          </div>
          <span class="time">{b.time}</span>
          <h3>{b.title}</h3>
          <p>{b.body}</p>
        </li>
      ))}
      <li class="done">
        <div class="shot" aria-hidden="true"><svg width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path></svg></div>
        <span class="time">{endTime}</span>
        <h3>{s.endingTitle}</h3>
        <p>{endText}</p>
      </li>
    </ol>
  </section>

  <section class="band" aria-labelledby="price-h">
    <div class="x">
      <div class="sec-top">
        <div>
          <p class="eyebrow">{s.plansKicker}</p>
          <h2 id="price-h">{s.pricing.head}</h2>
        </div>
        <p class="side">{s.pricing.sub} {s.pricing.note}</p>
      </div>
      <ul class="plans">
        {s.pricing.plans.map((p) => <li class:list={['plan', { featured: p.name === 'Pro' }]}><b>{p.name}</b><p>{p.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="x setup" aria-labelledby="setup-h">
    <div class="setup-copy">
      <p class="eyebrow">{s.setupKicker}</p>
      <h2 id="setup-h">{s.stepsHead}</h2>
      <p class="sub">{s.stepsSub}</p>
    </div>
    <ol class="steps">
      {s.steps.map((st, i) => <li><span class="n">{i + 1}</span><span><b>{st.title}</b><span>{st.body}</span></span></li>)}
    </ol>
  </section>

