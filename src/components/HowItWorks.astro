---
// The How it works page in either language (REDESIGN-BRIEF, "How it works
// page"). The words are the Markdown's (src/data/how-it-works.ts parses it);
// this only lays each section out. Sections are taken by position, which the
// English and French pages share.
import Directory from '../layouts/Directory.astro';
import AppCta from './directory/AppCta.astro';
import { CONTENT, UI, IDS, FREE, md, lead, withoutPlan, type Lang, type Block } from '../data/how-it-works';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = CONTENT[lang];
const t = UI[lang];
const [checkin, queue, picking, overrides, scores, board, signal, attendance, payments, plans, testing] = c.sections;

const items = (b: Block | undefined) => (b && b.type === 'ul' ? b.items : []);
const text = (b: Block | undefined) => (b && b.type === 'p' ? b.text : '');
const badge = (plan: string) => `badge${FREE.has(plan) ? '' : ' paid'}`;

// Ways of picking: the table's rows become tabs, each opening its ### section.
const table = picking.blocks.find((b) => b.type === 'table') as Extract<Block, { type: 'table' }>;
// Each method has a stable link (#pegboard and so on, the same in both
// languages, in the table's order) that opens its tab.
const SLUGS = ['pegboard', 'manual', 'skill-based', 'king-of-the-court'];
const methods = table.rows.map(([name, who, plan], i) => ({
  id: SLUGS[i] ?? `method-${i}`, name, who, plan, sub: picking.subs.find((s) => s.title === name)!,
}));
// "**Fairness mode** (the organiser picks one):" and its list: one choice, shown as a card.
const CHOICE = /\s*\((the organiser picks one|l’organisateur en choisit un)\)\s*:\s*$/;
type Part = { kind: 'choices'; items: { label: string; list: string[] }[] } | { kind: 'block'; block: Block };
const parts = (blocks: Block[]): Part[] => {
  const out: Part[] = [];
  for (let i = 0; i < blocks.length; i++) {
    const b = blocks[i], next = blocks[i + 1];
    if (b.type === 'p' && CHOICE.test(b.text) && next?.type === 'ul') {
      const choice = { label: b.text.replace(CHOICE, ''), list: next.items };
      const last = out[out.length - 1];
      if (last?.kind === 'choices') last.items.push(choice); else out.push({ kind: 'choices', items: [choice] });
      i++;
    } else out.push({ kind: 'block', block: b });
  }
  return out;
};
const KNOWN_COST = /^\*\*(Known costs|Les coûts connus)/;

// "pair two players so they play together (Pro);": the badge stands in for "(Pro)", after the punctuation.
const proBadge = (item: string) => md(item).replace(/\s*\(Pro\)([;.]?)/, '$1 <span class="badge paid">Pro</span>');
// A rule from a list as a card: sentence case, no trailing ";" or ".".
const asCard = (item: string) => { const s = item.replace(/[;.]\s*$/, ''); return s[0].toUpperCase() + s.slice(1); };

const home = lang === 'fr' ? '/fr/' : '/';
const url = lang === 'fr' ? '/fr/how-it-works.html' : '/how-it-works.html';
const crumbs = [{ name: lang === 'fr' ? 'Accueil' : 'Home', href: home }, { name: t.crumb, href: url }];
const languages = [
  { lang: 'en', label: 'English', href: '/how-it-works.html' },
  { lang: 'fr', label: 'Français', href: '/fr/how-it-works.html' },
];
const title = lang === 'fr' ? `NextFour : ${c.title}` : `NextFour: ${c.title}`;
const heading = c.meta.replace(/\s+(in a NextFour session|d’une session NextFour)\.$/, '');
---

<Directory title={title} description={c.meta} crumbs={crumbs} cta={false} current="how" lang={lang} languages={languages}>
  <style>
    .top { padding: 28px 0 40px; }
    h1 { max-width: 860px; font-size: clamp(38px, 6vw, 72px); line-height: 1; font-stretch: 114%; }
    .intro { max-width: 640px; }
    .flow { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: 10px; }
    .flow li { display: flex; flex-direction: column; gap: 10px; padding: 18px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
    .flow .n { width: 32px; height: 32px; border-radius: 999px; background: var(--hl-bg); color: var(--hl-fg); display: flex; align-items: center; justify-content: center; font-weight: 800; }
    .flow b { font-size: 18px; font-weight: 800; }
    .flow span.text { font-size: 14px; color: var(--body); }

    .layout { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; padding: 8px 0 48px; border-top: 1px solid var(--line); }
    /* The contents: grouped, and on a wide screen it stays in view and marks where you are. */
    .toc { flex: 1 1 220px; min-width: 0; padding-top: 32px; }
    .toc summary { font-size: 15px; font-weight: 800; color: var(--ink); cursor: pointer; min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .toc summary .chev { transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1); }
    .toc details[open] summary .chev { transform: rotate(180deg); }
    .toc-g { margin-top: 14px; }
    .toc-gh { margin: 0 0 6px; font-size: 14px; font-weight: 700; color: var(--muted); }
    .toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; border-left: 2px solid var(--line); }
    .toc ol.sub { border-left: 0; margin: 0 0 4px 14px; }
    .toc a { display: block; padding: 5px 0 5px 14px; margin-left: -2px; border-left: 2px solid transparent; text-decoration: none; font-size: 15px; color: var(--body); }
    .toc ol.sub a { padding: 3px 0 3px 12px; margin-left: 0; font-size: 14px; color: var(--muted); }
    .toc a:hover { border-left-color: var(--line-strong); color: var(--ink); }
    .toc a[aria-current='true'] { border-left-color: var(--eyebrow); color: var(--ink); font-weight: 700; }
    @media (min-width: 900px) {
      .toc { position: sticky; top: 0; align-self: flex-start; max-height: 100vh; overflow-y: auto; padding-bottom: 24px; }
      .toc summary { pointer-events: none; list-style: none; }
      .toc summary .chev { display: none; }
      .toc summary::-webkit-details-marker { display: none; }
    }
    @media (max-width: 899px) {
      .toc { padding: 4px 18px 12px; margin-top: 24px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
    }
    h2, h3 { text-wrap: balance; }
    .card p, .card span, .body-text, .panel-m p, .lead-p { text-wrap: pretty; }
    .content { flex: 999 1 600px; min-width: 0; display: flex; flex-direction: column; }
    .lead-p { margin: 32px 0 0; font-size: 17px; color: var(--body); max-width: 62ch; }

    section.part { padding: 32px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 16px; }
    section.part.last { border-bottom: 0; }
    section.part > h2 { margin: 0 0 16px; font-size: 28px; font-weight: 800; font-stretch: 108%; letter-spacing: -0.01em; }
    .body-text { margin: 0 0 16px; max-width: 64ch; color: var(--body); }
    .rules { margin: 0; padding-left: 20px; max-width: 64ch; display: flex; flex-direction: column; gap: 8px; color: var(--body); text-wrap: pretty; }
    .rules :global(strong), .card :global(strong) { color: var(--ink); }
    .grid { display: grid; gap: 10px; }
    /* Four cards: four across, or two by two on a phone, never three and one. */
    .g170 { grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); }
    /* Four cards sit 2 by 2 in the content column, never 3 and a straggler. */
    .g240 { grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
    .card { padding: 18px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; color: var(--body); font-size: 15px; }
    .card .ttl { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .card .ttl b, .card h3 { margin: 0; font-weight: 800; font-size: 16px; color: var(--ink); }
    .card p { margin: 0; }
    .badge {
      font-size: 11px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px;
      background: var(--tag2-bg); color: var(--tag2-fg); white-space: nowrap;
    }
    .badge.paid, :global(.badge.paid) { background: var(--tag-bg); color: var(--tag-fg); }
    :global(.rules .badge) { font-size: 11px; font-weight: 800; letter-spacing: 0.06em; padding: 1px 7px; border-radius: 999px; }
    .note-warn { margin: 12px 0 0; padding: 12px 14px; border-radius: 12px; background: var(--warn-bg); color: var(--warn-fg); font-size: 14px; }
    .note-warn :global(strong) { color: inherit; }
    .split { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
    figure { flex: 1 1 260px; margin: 0; padding: 16px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
    figcaption { font-size: 13px; font-weight: 700; color: var(--muted); margin-bottom: 10px; }
    .q { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
    .q li { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 10px; background: var(--row); }
    .q li.away .who { color: var(--muted); }
    .q .tag { font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: var(--surface); color: var(--muted); border: 1px solid var(--line); }
    .q .pos { width: 22px; font-size: 13px; font-weight: 800; color: var(--muted); font-variant-numeric: tabular-nums; }
    .q .who { flex: 1 1 auto; font-weight: 700; }
    .q .wait { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
    .split > .rules { flex: 999 1 300px; min-width: 0; }

    .tabs { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-top: 4px; }
    .tabs button {
      text-align: left; padding: 14px 16px; border-radius: 14px; cursor: pointer; display: flex; flex-direction: column; gap: 6px;
      border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--ink); min-height: 44px;
    }
    .tabs button[aria-selected='true'] { border-color: var(--sel-bg); background: var(--sel-bg); color: var(--sel-fg); }
    .tabs .ttl { display: flex; justify-content: space-between; align-items: center; gap: 6px; width: 100%; }
    .tabs .ttl b { font-weight: 800; font-size: 16px; }
    .tabs .who { font-size: 13px; opacity: 0.85; }
    .panel-m { margin-top: 12px; padding: 22px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
    .panel-m[hidden] { display: none; }
    .panel-m h3 { margin: 0 0 12px; font-size: 20px; font-weight: 800; }
    .panel-m p { margin: 0 0 10px; color: var(--body); }
    .panel-m p.in-short { font-size: 17px; font-weight: 600; color: var(--ink); }
    .with-shot { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
    .with-shot > div { flex: 999 1 340px; min-width: 0; }
    .with-shot .shot { flex: 0 1 180px; margin: 0; padding: 0; border: 0; background: none; }
    .with-shot .shot img { display: block; width: 100%; height: auto; border-radius: 22px; border: 6px solid #0B0F14; box-sizing: border-box; }
    .choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 10px; margin: 4px 0 16px; }
    .choice { padding: 14px 16px; border-radius: 14px; background: var(--row); }
    .choice b { display: block; margin-bottom: 8px; color: var(--ink); }
    .choice .rules { padding-left: 18px; }
    .panel-m > .rules { margin-bottom: 14px; }
    .panel-m > .rules:last-child { margin-bottom: 0; }

    .refuse { background: var(--row); border-style: dashed; border-color: var(--line-strong); }
    /* The organisers' sections are quieter: smaller headings, plain lists. */
    section.part.org > h2 { font-size: 22px; }
    .note-small { margin: 12px 0 0; font-size: 14px; color: var(--muted); }
    /* The four rules that hold in every run: the page's proof, two by two. */
    .holds { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 10px; }
    .holds li { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); font-size: 15px; font-weight: 600; color: var(--ink); }
    .holds svg { flex: 0 0 auto; margin-top: 1px; color: var(--eyebrow); }
    .content h3.small-h { margin: 8px 0 10px; font-size: 16px; font-weight: 800; }
    .questions { margin: 16px 0 0; color: var(--body); }
    .cta-slot { margin-top: 8px; }
    .cta-slot :global(.cta) { margin-bottom: 0; }
  </style>

  <section class="top">
    <h1>{heading}</h1>
    <p class="intro" set:html={md(text(c.intro[0]))} />
    <ol class="flow" aria-label={t.stepsLabel}>
      {t.steps.map((s, i) => (
        <li>
          <span class="n">{i + 1}</span>
          <b>{s.title}</b>
          <span class="text">{s.text}</span>
        </li>
      ))}
    </ol>
  </section>

  <div class="layout">
    <nav class="toc" aria-label={t.onThisPage}>
      <details open>
        <summary>{t.onThisPage}<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
        {t.groups.map(([name, idx]) => (
          <div class="toc-g">
            {name && <p class="toc-gh">{name}</p>}
            <ol>
              {idx.map((i) => (
                <li>
                  <a href={`#${IDS[i]}`}>{c.sections[i].title}</a>
                  {i === 2 && <ol class="sub">{methods.map((m) => <li><a href={`#${m.id}`}>{m.name}</a></li>)}</ol>}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </details>
    </nav>

    <div class="content">
      {c.intro.slice(1).map((b) => <p class="lead-p" set:html={md(text(b))} />)}

      <section class="part" id={IDS[0]} aria-labelledby={`${IDS[0]}-h`}>
        <h2 id={`${IDS[0]}-h`}>{checkin.title}</h2>
        <div class="grid g170" style="margin-bottom: 18px">
          {t.checkin.map((m) => (
            <div class="card">
              <span class="ttl"><b>{m.title}</b><span class={badge(m.plan)}>{m.plan}</span></span>
              <span>{m.text}</span>
            </div>
          ))}
        </div>
        <ul class="rules">
          {items(checkin.blocks[0]).slice(1).map((it) => <li set:html={md(it)} />)}
        </ul>
      </section>

      <section class="part" id={IDS[1]} aria-labelledby={`${IDS[1]}-h`}>
        <h2 id={`${IDS[1]}-h`}>{queue.title}</h2>
        <div class="split">
          <figure>
            <figcaption>{t.exampleQueue}</figcaption>
            <ol class="q">
              {[14, 11, 9, 6].map((wait, i) => (
                <li><span class="pos">{i + 1}</span><span class="who">{t.player} {'ABCD'[i]}</span><span class="wait">{wait} {t.min}</span></li>
              ))}
              <li class="away"><span class="pos"></span><span class="who">{t.player} E</span><span class="tag">{t.away}</span></li>
            </ol>
          </figure>
          <ul class="rules">
            {items(queue.blocks[0]).map((it) => <li set:html={md(it)} />)}
          </ul>
        </div>
      </section>

      <section class="part" id={IDS[2]} aria-labelledby={`${IDS[2]}-h`}>
        <h2 id={`${IDS[2]}-h`}>{picking.title}</h2>
        <p class="body-text" set:html={md(text(picking.blocks[0]))} />
        <div class="tabs" role="tablist" aria-label={t.methodsLabel}>
          {methods.map((m, i) => (
            <button type="button" role="tab" id={`${m.id}-tab`} aria-controls={m.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="ttl"><b>{m.name}</b><span class={badge(m.plan)}>{m.plan}</span></span>
              <span class="who">{m.who}</span>
            </button>
          ))}
        </div>
        {methods.map((m) => (
          <div class="panel-m" role="tabpanel" id={m.id} aria-labelledby={`${m.id}-tab`}>
            <h3>{m.name}</h3>
            <div class={m.id === 'pegboard' ? 'with-shot' : undefined}>
              <div>
                {parts(m.sub.blocks).map((part, pi) =>
                  part.kind === 'choices'
                    ? <div class="choices">{part.items.map((ch) => <div class="choice"><b set:html={md(ch.label)} /><ul class="rules">{ch.list.map((it) => <li set:html={md(it)} />)}</ul></div>)}</div>
                    : part.block.type === 'ul' ? <ul class="rules">{part.block.items.map((it) => <li set:html={md(it)} />)}</ul>
                    : part.block.type === 'p' && KNOWN_COST.test(part.block.text) ? <p class="note-warn" set:html={md(part.block.text)} />
                    : part.block.type === 'p' ? <p class={pi === 0 ? 'in-short' : undefined} set:html={md(part.block.text)} />
                    : null)}
              </div>
              {m.id === 'pegboard' && <figure class="shot"><img src={t.pickShot.src} alt={t.pickShot.alt} width="540" height="1116" loading="lazy" /></figure>}
            </div>
          </div>
        ))}
      </section>

      <section class="part" id={IDS[3]} aria-labelledby={`${IDS[3]}-h`}>
        <h2 id={`${IDS[3]}-h`}>{overrides.title}</h2>
        <div class="split" style="gap: 12px">
          <div class="card" style="flex: 1 1 300px">
            <h3 set:html={md(text(overrides.blocks[0]))} />
            <ul class="rules" style="gap: 6px">
              {items(overrides.blocks[1]).map((it) => <li set:html={proBadge(it)} />)}
            </ul>
          </div>
          <div class="card refuse" style="flex: 1 1 300px">
            <h3>{t.refusesHeading}</h3>
            <ul class="rules" style="gap: 6px">
              {t.refuses.map((r) => <li>{r}</li>)}
            </ul>
            <p style="margin-top: 6px">{t.refusesAfter}</p>
          </div>
        </div>
      </section>

      <section class="part" id={IDS[6]} aria-labelledby={`${IDS[6]}-h`}>
        <h2 id={`${IDS[6]}-h`}>{signal.title}</h2>
        <p class="body-text" set:html={md(text(signal.blocks[0]))} />
        <ul class="rules">
          {items(signal.blocks[1]).map((it) => <li set:html={md(asCard(it))} />)}
        </ul>
        <p class="note-warn"><strong set:html={md(text(signal.blocks[2]))} /></p>
      </section>

      <section class="part" id={IDS[4]} aria-labelledby={`${IDS[4]}-h`}>
        <h2 id={`${IDS[4]}-h`}>{scores.title}</h2>
        <ul class="rules">
          {items(scores.blocks[0]).map((it) => <li set:html={md(it)} />)}
        </ul>
      </section>

      <section class="part" id={IDS[5]} aria-labelledby={`${IDS[5]}-h`}>
        <h2 id={`${IDS[5]}-h`}>{board.title}</h2>
        <div class="grid g240" style="gap: 12px">
          {items(board.blocks[0]).map((it, i) => {
            const { title: cardTitle, rest } = lead(it);
            return (
              <div class="card">
                <span class="ttl"><b>{withoutPlan(cardTitle)}</b><span class={badge(t.boardPlans[i])}>{t.boardPlans[i]}</span></span>
                <span set:html={md(rest)} />
              </div>
            );
          })}
        </div>
      </section>

      <section class="part org" id={IDS[7]} aria-labelledby={`${IDS[7]}-h`}>
        <h2 id={`${IDS[7]}-h`}>{attendance.title}</h2>
        <ul class="rules">
          {items(attendance.blocks[0]).map((it) => <li set:html={md(it)} />)}
        </ul>
      </section>

      <section class="part org" id={IDS[8]} aria-labelledby={`${IDS[8]}-h`}>
        <h2 id={`${IDS[8]}-h`} style="margin-bottom: 12px">{payments.title}</h2>
        <p class="body-text" style="margin: 0" set:html={md(text(payments.blocks[0]))} />
      </section>

      <section class="part org" id={IDS[9]} aria-labelledby={`${IDS[9]}-h`}>
        <h2 id={`${IDS[9]}-h`}>{plans.title}</h2>
        <ul class="rules">
          {items(plans.blocks[0]).map((it) => <li set:html={md(it)} />)}
        </ul>
        <p class="note-small" set:html={md(text(plans.blocks[1]))} />
      </section>

      <section class="part last" id={IDS[10]} aria-labelledby={`${IDS[10]}-h`}>
        <h2 id={`${IDS[10]}-h`} style="margin-bottom: 12px">{testing.title}</h2>
        <p class="body-text" set:html={md(text(testing.blocks[0]))} />
        <h3 class="small-h">{t.rulesHold}</h3>
        <ul class="holds">
          {items(testing.blocks[1]).map((it) => <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg><span set:html={md(asCard(it))} /></li>)}
        </ul>
        <p class="questions" set:html={md(text(testing.blocks[2]))} />
      </section>

      <div class="cta-slot">
        <AppCta quiet heading={t.cta.heading} text={t.cta.text} getLabel={t.cta.get} secondLabel={t.cta.second} src="how-it-works" />
      </div>
    </div>
  </div>

  <script>
    // Picking methods: tabs with arrow keys, Home and End. Every panel is in the
    // HTML; the script hides all but the chosen one. Each has its own link
    // (#pegboard and so on), which opens its tab, and choosing a tab updates it.
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panelOf = (t: HTMLButtonElement) => document.getElementById(t.getAttribute('aria-controls')!)!;
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panelOf(t).hidden = !on;
      }
    };
    const byHash = () => tabs.find((t) => `#${t.getAttribute('aria-controls')}` === location.hash);
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        select(tab);
        history.replaceState(null, '', `#${tab.getAttribute('aria-controls')}`);
      });
      tab.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const to = e.key === 'ArrowRight' ? (i + 1) % n : e.key === 'ArrowLeft' ? (i - 1 + n) % n
          : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1;
        if (to < 0) return;
        e.preventDefault();
        tabs[to].click();
        tabs[to].focus();
      });
    });
    const openFromHash = () => {
      const tab = byHash();
      if (!tab) return;
      select(tab);
      panelOf(tab).closest('section')!.scrollIntoView();
    };
    if (tabs.length) select(byHash() ?? tabs[0]);
    if (byHash()) requestAnimationFrame(openFromHash);
    addEventListener('hashchange', openFromHash);

    // The contents: closed on a narrow screen, and the section you are reading marked.
    const toc = document.querySelector<HTMLDetailsElement>('.toc details');
    if (toc && !matchMedia('(min-width: 900px)').matches) toc.open = false;
    const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc-g > ol > li > a')].map((a) => [a.hash.slice(1), a]));
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const a of links.values()) a.removeAttribute('aria-current');
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '-15% 0px -75% 0px' });
    document.querySelectorAll('section.part').forEach((sec) => spy.observe(sec));
  </script>
</Directory>
