---
// The one footer every page shares (through layouts/Directory.astro): the
// links, the support email and copyright, the social buttons, and a language
// menu on pages that have other language versions. A page adds notes of its
// own through the slot (the directory's data and licence lines).
//
// The language menu is a <details> disclosure of plain links, so it works
// without script and grows to any number of languages; a little script only
// closes it on an outside click or Escape.
import { INSTAGRAM_URL, FACEBOOK_URL } from '../social-links';

interface Props {
  lang?: 'en' | 'fr';
  /** Language versions of this page; the menu shows when there is more than one. */
  languages?: { lang: string; label: string; href: string }[];
}
const { lang = 'en', languages = [] } = Astro.props;

const WORDS = {
  en: {
    label: 'Footer', language: 'Language', choose: 'Choose a language', questions: 'Questions? Email', copyright: '© 2026 NextFour. All rights reserved.',
    links: [['Home', '/'], ['Badminton clubs', '/badminton.html'], ['How it works', '/how-it-works.html'], ['Support', '/support.html'],
      ['Privacy', '/privacy.html'], ['Terms', '/terms.html'], ['Account and data deletion', '/delete-account.html']],
  },
  fr: {
    label: 'Pied de page', language: 'Langue', choose: 'Choisir une langue', questions: 'Des questions ? Écrivez à', copyright: '© 2026 NextFour. Tous droits réservés.',
    links: [['Accueil', '/fr/'], ['Clubs de badminton', '/badminton.html'], ['Comment ça marche', '/fr/how-it-works.html'], ['Assistance', '/fr/support.html'],
      ['Confidentialité', '/fr/privacy.html'], ['Conditions', '/fr/terms.html'], ['Suppression du compte et des données', '/fr/delete-account.html']],
  },
}[lang];
const current = languages.find((l) => l.lang === lang) ?? languages[0];
---

<footer class="foot">
  <div class="wrap foot-row">
    <div class="foot-left">
      <nav aria-label={WORDS.label}>
        {WORDS.links.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      <slot />
      <p>{WORDS.questions} <a href="mailto:support@nextfour.app">support@nextfour.app</a>. {WORDS.copyright}</p>
    </div>
    <div class="foot-right">
      {INSTAGRAM_URL && (
        <a class="social" href={INSTAGRAM_URL} rel="noopener" aria-label="NextFour on Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
        </a>
      )}
      {FACEBOOK_URL && (
        <a class="social" href={FACEBOOK_URL} rel="noopener" aria-label="NextFour on Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.3c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.2H8v3.6h2.6V22h3.4V12.1h2.6l.4-3.6z"></path></svg>
        </a>
      )}
      {languages.length > 1 && (
        <details class="lang-menu">
          <summary aria-label={`${WORDS.choose}: ${current.label}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
            <span>{current.label}</span>
            <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"></path></svg>
          </summary>
          <ul aria-label={WORDS.language}>
            {languages.map((l) => (
              <li><a href={l.href} lang={l.lang} hreflang={l.lang} aria-current={l.lang === lang ? 'true' : undefined}>
                {l.label}
                {l.lang === lang && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>}
              </a></li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--line); }
  .foot-row { padding-top: 32px; padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 20px 40px; justify-content: space-between; align-items: flex-start; }
  .foot-left { display: flex; flex-direction: column; gap: 14px; flex: 999 1 420px; min-width: 0; font-size: 13px; color: var(--muted); }
  .foot-left nav { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 14px; font-weight: 600; }
  .foot-left nav a { color: var(--body); text-decoration: none; }
  .foot-left nav a:hover { color: var(--link-hover); }
  .foot-left :global(p) { margin: 0; max-width: 760px; }
  .foot-left :global(p a) { color: var(--muted); }
  .foot-right { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .social { width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--line-strong); display: flex; align-items: center; justify-content: center; color: var(--ink); }
  .social:hover { border-color: var(--muted); color: var(--ink); }
  .lang-menu { position: relative; margin-left: 8px; }
  .lang-menu summary {
    list-style: none; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    border-radius: 999px; border: 1px solid var(--line-strong); color: var(--ink); font-size: 14px; font-weight: 700; cursor: pointer;
  }
  .lang-menu summary::-webkit-details-marker { display: none; }
  .lang-menu summary:hover { border-color: var(--muted); }
  .lang-menu summary:focus-visible { outline: 2px solid var(--eyebrow); outline-offset: 2px; }
  .lang-menu .chev { transition: transform 0.15s; transform: rotate(180deg); }
  .lang-menu[open] .chev { transform: none; }
  /* Opens upwards: the footer is the bottom of the page. */
  .lang-menu ul {
    position: absolute; right: 0; bottom: calc(100% + 8px); z-index: 10; min-width: 180px; margin: 0; padding: 6px; list-style: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.35);
  }
  .lang-menu a {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 0 12px;
    border-radius: 10px; color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 600;
  }
  .lang-menu a:hover { background: var(--row); color: var(--ink); }
  .lang-menu a[aria-current='true'] { color: var(--eyebrow); }
</style>

<script is:inline>
  // Close the language menu on a click elsewhere, or on Escape.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.lang-menu[open]').forEach((m) => { if (!m.contains(e.target)) m.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('.lang-menu[open]').forEach((m) => { m.open = false; m.querySelector('summary').focus(); });
  });
</script>
