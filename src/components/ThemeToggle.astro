---
// Auto, light or dark, on every page. Each press moves on one: Auto (follow
// the device), Light, Dark, then Auto again. Light and dark are kept in
// localStorage and applied before first paint by ThemeHead (rendered in
// Base); Auto clears the choice. The icon shows the current setting: a
// half-filled circle for Auto, a sun for Light, a moon for Dark. A page's own
// stylesheet defines its dark colours twice: under prefers-color-scheme (when
// no choice was made) and under :root[data-theme='dark'].
---

<button type="button" class="theme-toggle" aria-label="Theme: automatic. Switch to light mode" title="Theme: automatic">
  <svg class="auto" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg>
  <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const buttons = document.querySelectorAll('.theme-toggle');
    const fr = root.lang === 'fr';
    const NEXT = { auto: 'light', light: 'dark', dark: 'auto' };
    const NAME = fr
      ? { auto: 'automatique', light: 'clair', dark: 'sombre' }
      : { auto: 'automatic', light: 'light', dark: 'dark' };
    const mode = () => root.dataset.theme || 'auto';
    const label = () => buttons.forEach((b) => {
      const now = mode();
      const next = NEXT[now];
      const title = fr ? `Thème : ${NAME[now]}` : `Theme: ${NAME[now]}`;
      const then = next === 'auto'
        ? (fr ? 'Suivre l’appareil' : 'Follow your device')
        : (fr ? `Passer en mode ${NAME[next]}` : `Switch to ${NAME[next]} mode`);
      b.title = title;
      b.setAttribute('aria-label', `${title}. ${then}`);
    });
    buttons.forEach((b) => b.addEventListener('click', () => {
      const next = NEXT[mode()];
      if (next === 'auto') delete root.dataset.theme; else root.dataset.theme = next;
      try {
        if (next === 'auto') localStorage.removeItem('theme'); else localStorage.setItem('theme', next);
      } catch {}
      label();
    }));
    label();
  })();
</script>

<style is:global>
  /* 44px target (REDESIGN-BRIEF). Pages without the directory tokens fall
     back to their own --card/--border. */
  .theme-toggle {
    display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 999px;
    cursor: pointer; padding: 0; flex: none; color: inherit;
    background: var(--surface, var(--card, transparent)); border: 1px solid var(--line-strong, var(--border));
  }
  .theme-toggle:hover { border-color: var(--muted); }
  /* The icon follows the setting from first paint, before the script runs. */
  .theme-toggle .sun, .theme-toggle .moon { display: none; }
  :root[data-theme='light'] .theme-toggle .auto, :root[data-theme='dark'] .theme-toggle .auto { display: none; }
  :root[data-theme='light'] .theme-toggle .sun, :root[data-theme='dark'] .theme-toggle .moon { display: block; }
</style>
