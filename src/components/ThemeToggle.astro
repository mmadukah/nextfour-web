---
// Light or dark, on every page. The site follows the visitor's system
// setting until they press this; their choice is kept in localStorage and
// applied before first paint by ThemeHead (rendered in Base). The icon
// shows the theme a press switches to: a moon on light, a sun on dark. A page's own stylesheet defines
// its dark colours twice: under prefers-color-scheme (when no choice was
// made) and under :root[data-theme='dark'].
---

<button type="button" class="theme-toggle" aria-label="Switch to dark mode">
  <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const buttons = document.querySelectorAll('.theme-toggle');
    const fr = root.lang === 'fr';
    const label = () => buttons.forEach((b) => b.setAttribute('aria-label', isDark()
      ? (fr ? 'Passer en mode clair' : 'Switch to light mode')
      : (fr ? 'Passer en mode sombre' : 'Switch to dark mode')));
    buttons.forEach((b) => b.addEventListener('click', () => {
      root.dataset.theme = isDark() ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      label();
    }));
    label();
  })();
</script>

<style is:global>
  /* 44px target (REDESIGN-BRIEF). Pages without the directory tokens fall
     back to their own --card/--border. */
  .theme-toggle {
    display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 999px;
    cursor: pointer; padding: 0; flex: none; color: inherit;
    background: var(--surface, var(--card, transparent)); border: 1px solid var(--line-strong, var(--border));
  }
  .theme-toggle:hover { border-color: var(--muted); }
  .theme-toggle .sun, :root[data-theme='dark'] .theme-toggle .moon { display: none; }
  :root[data-theme='dark'] .theme-toggle .sun { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .moon { display: none; }
    :root:not([data-theme='light']) .theme-toggle .sun { display: block; }
  }
</style>
