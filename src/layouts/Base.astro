---
import ThemeHead from '../components/ThemeHead.astro';
import { GOATCOUNTER_CODE } from '../analytics';

// Minimal HTML shell shared by every page. Page-specific <style> blocks and
// extra <head> tags are supplied via the `head` slot.
//
// Social metadata lives here rather than in each page so that every route gets
// a link preview by default. Before this, only the homepage carried any Open
// Graph tags and none of them referenced an image, so an invite link pasted
// into a group chat rendered as a bare URL.
interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** Overrides `description` for the social preview when a shorter line reads better. */
  ogDescription?: string;
  /** Root-relative path to the preview image in public/. */
  image?: string;
  ogType?: string;
  /** Escape hatch for a route whose public URL is not derivable from the path. */
  canonicalPath?: string;
  /** False for a page that should not follow the light and dark setting (none at present). */
  themed?: boolean;
  /** Other language versions, as hreflang links (absolute URLs). */
  alternates?: { hreflang: string; href: string }[];
}
const {
  title,
  description,
  lang = 'en',
  ogDescription,
  image = '/og.png',
  ogType = 'website',
  canonicalPath,
  themed = true,
  alternates = [],
} = Astro.props;

const ogLocales: Record<string, string> = { en: 'en_GB', fr: 'fr_FR' };

// `build.format: 'preserve'` emits flat files for everything except the locale
// homepages, so /privacy.html is a real URL and /privacy/ is a 404. Astro.url
// always reports the directory form, so it has to be converted back or the
// canonical and og:url point at pages that do not exist.
const isLocaleRoot = (p: string) =>
  p === '/' || Object.keys(ogLocales).some((loc) => p === `/${loc}/`);

const path = Astro.url.pathname;
const publicPath = canonicalPath
  ?? (isLocaleRoot(path) ? path : `${path.replace(/\/$/, '')}.html`);

// Absolute URLs: the scrapers behind WhatsApp, Facebook, iMessage and Slack
// will not resolve a root-relative og:image.
const canonical = new URL(publicPath, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const social = ogDescription ?? description;
const countUrl = GOATCOUNTER_CODE && `https://${GOATCOUNTER_CODE}.goatcounter.com/count`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="NextFour" />
    <meta property="og:title" content={title} />
    {social && <meta property="og:description" content={social} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang] ?? 'en_GB'} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NextFour, the racket sport club manager" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {social && <meta name="twitter:description" content={social} />}
    <meta name="twitter:image" content={imageUrl} />

    {themed && <ThemeHead light="#f3f5ee" dark="#0f1923" />}
    {countUrl && (
      <script is:inline define:vars={{ countUrl }}>
        // Counts this visit and the clicks that lead towards the app (see
        // src/analytics.ts). window.nfCount(name) counts one more event, for
        // pages that leave by script (the /get redirect).
        (() => {
          const off = navigator.webdriver || /^(localhost|127\.|\[::1\])/.test(location.hostname);
          const send = (q) => {
            if (off) return;
            const url = countUrl + '?' + new URLSearchParams({ ...q, rnd: String(Math.random()).slice(2, 8) });
            try { fetch(url, { keepalive: true, mode: 'no-cors', credentials: 'omit' }); }
            catch (_) { new Image().src = url; }
          };
          const clean = (v) => (v || '').replace(/[^a-z0-9-]/gi, '').slice(0, 40);
          window.nfCount = (name) => send({ p: name, t: name, e: 'true' });

          const params = new URLSearchParams(location.search);
          const src = clean(params.get('src'));
          // A link shared from a club page comes back with ?via=share.
          const via = clean(params.get('via'));
          send({
            p: location.pathname + (src ? '?src=' + src : ''),
            t: document.title,
            r: via ? via + '-share' : document.referrer,
            s: String(screen.width),
          });

          // The clicks on the way to the app, named by where they go and the
          // button's ?src= (or the store's campaign).
          const nameOf = (a) => {
            let u;
            try { u = new URL(a.href, location.href); } catch (_) { return null; }
            const q = u.searchParams;
            if (u.hostname === 'apps.apple.com') return 'store-ios-' + (clean(q.get('ct')) || 'none');
            if (u.hostname === 'play.google.com') {
              const ref = new URLSearchParams(q.get('referrer') || '');
              return 'store-android-' + (clean(ref.get('utm_campaign')) || (ref.get('claim') ? 'claim-code' : 'none'));
            }
            if (u.hostname === 'wa.me') return 'share-whatsapp';
            if (u.origin !== location.origin) return null;
            if (u.pathname === '/get.html' || u.pathname === '/get') return 'get-' + (clean(q.get('src')) || 'none');
            if (u.pathname === '/open' || u.pathname === '/open.html') return 'open-' + (clean(q.get('src')) || 'none');
            return null;
          };
          document.addEventListener('click', (ev) => {
            const a = ev.target instanceof Element && ev.target.closest('a[href]');
            const name = a && (a.protocol === 'app.nextfour.mobile:' ? 'open-app' : nameOf(a));
            if (name) window.nfCount(name);
          }, { capture: true });
        })();
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
