---
// Minimal HTML shell shared by every page. Page-specific <style> blocks and
// extra <head> tags are supplied via the `head` slot.
interface Props {
  title: string;
  description?: string;
  lang?: string;
}
const { title, description, lang = 'en' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
