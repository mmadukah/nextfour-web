---
// Layout for the prose pages (privacy, terms, support, account deletion), in
// English and French: a Markdown content entry in the site's shared frame
// (Directory.astro: header, breadcrumb with the language pills, footer), set
// in a readable column. The Markdown is the page's words; nothing here adds
// to them.
import Directory from './Directory.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title: string;
  meta: string;
  description?: string;
  lang: string;
  slug: string;
}
const { title, meta, description, lang, slug } = Astro.props;
const fr = lang === 'fr';
const fullTitle = fr ? `NextFour : ${title}` : `NextFour: ${title}`;

const crumbs = [
  { name: fr ? 'Accueil' : 'Home', href: fr ? '/fr/' : '/' },
  { name: title, href: getRelativeLocaleUrl(lang, `${slug}.html`) },
];
const languages = [
  { lang: 'en', label: 'English', href: getRelativeLocaleUrl('en', `${slug}.html`) },
  { lang: 'fr', label: 'Français', href: getRelativeLocaleUrl('fr', `${slug}.html`) },
];
---

<Directory title={fullTitle} description={description} crumbs={crumbs} cta={false} lang={fr ? 'fr' : 'en'} footer="site" languages={languages}>
  <style>
    .page { padding: 28px 0 56px; max-width: 720px; }
    .page .eyebrow { margin: 0 0 10px; }
    h1 { font-size: clamp(34px, 5vw, 52px); line-height: 1.05; font-stretch: 112%; }
    .meta { margin: 14px 0 0; font-size: 14px; color: var(--muted); }
    /* The Markdown's own elements. */
    .prose { margin-top: 32px; font-size: 16px; line-height: 1.65; color: var(--body); }
    .prose :global(h2) { margin: 40px 0 12px; font-size: 24px; line-height: 1.2; font-weight: 800; font-stretch: 106%; letter-spacing: -0.01em; color: var(--ink); }
    .prose :global(h3) { margin: 28px 0 8px; font-size: 18px; font-weight: 800; color: var(--ink); }
    .prose :global(p) { margin: 0 0 14px; }
    .prose :global(ul), .prose :global(ol) { margin: 0 0 14px; padding-left: 22px; }
    .prose :global(li) { margin: 0 0 6px; }
    .prose :global(strong) { color: var(--ink); }
    .prose :global(a) { color: var(--ink); text-decoration-color: var(--eyebrow); text-underline-offset: 2px; }
    .prose :global(a:hover) { color: var(--link-hover); }
    .prose :global(code) { background: var(--row); padding: 1px 5px; border-radius: 4px; font-size: 0.92em; }
    .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: 15px; }
    .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .prose :global(th) { color: var(--ink); font-weight: 700; }
    /* Callouts and question lists that support and account deletion write as HTML. */
    .prose :global(.box) { margin: 24px 0; padding: 18px 20px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
    .prose :global(.box) :global(> :last-child) { margin-bottom: 0; }
    .prose :global(.faq dt) { margin-top: 20px; font-weight: 700; color: var(--ink); }
    .prose :global(.faq dd) { margin: 4px 0 0; padding: 0; }
  </style>

  <article class="page">
    <p class="eyebrow">NextFour</p>
    <h1>{title}</h1>
    <p class="meta">{meta}</p>
    <div class="prose">
      <slot />
    </div>
  </article>
</Directory>
