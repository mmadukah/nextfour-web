---
// Layout for the prose / legal pages (privacy, terms, support, account
// deletion). Renders a Markdown content entry inside the simple 720px column
// styling these pages have always used.
import Base from './Base.astro';

interface Props {
  title: string;
  meta: string;
}
const { title, meta } = Astro.props;
const fullTitle = `NextFour — ${title}`;
---

<Base title={fullTitle}>
  <style slot="head" is:global>
    :root { color-scheme: light dark; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      max-width: 720px;
      margin: 2rem auto;
      padding: 0 1.25rem;
      line-height: 1.6;
      color: #1a1a1a;
      background: #fff;
    }
    @media (prefers-color-scheme: dark) {
      body { background: #111; color: #eee; }
      a { color: #79b8ff; }
    }
    h1 { font-size: 1.75rem; margin-bottom: 0.25rem; }
    h2 { font-size: 1.2rem; margin-top: 2rem; }
    .meta { color: #666; font-size: 0.9rem; margin-bottom: 2rem; }
    ol, ul { padding-left: 1.25rem; }
    code { background: rgba(127,127,127,0.15); padding: 0 0.25rem; border-radius: 3px; }
    .box {
      border: 1px solid rgba(127,127,127,0.3);
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
      background: rgba(127,127,127,0.06);
    }
    .faq dt { font-weight: 600; margin-top: 1.25rem; }
    .faq dd { margin: 0.25rem 0 0; padding-left: 0; }
    nav.crumbs { margin-top: 2.5rem; font-size: 0.9rem; }
    nav.crumbs a { margin-right: 1rem; }
    footer { margin-top: 3rem; font-size: 0.85rem; color: #666; }
  </style>

  <h1>{fullTitle}</h1>
  <p class="meta">{meta}</p>

  <slot />

  <nav class="crumbs">
    <a href="/index.html">Home</a>
    <a href="/privacy.html">Privacy Policy</a>
    <a href="/terms.html">Terms &amp; Conditions</a>
    <a href="/support.html">Support</a>
    <a href="/delete-account.html">Account &amp; Data Deletion</a>
  </nav>

  <footer>&copy; 2026 NextFour. All rights reserved.</footer>
</Base>
