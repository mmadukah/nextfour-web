---
// Layout for the club directory (/badminton.html and everything under
// /badminton/). The landing page's brand kit: lime, Montserrat headings,
// Nunito Sans body, both self-hosted. Light or dark follows the visitor's
// system setting; every colour is a token below, set for each.
//
// Every page passes its breadcrumb trail; it is drawn at the top and emitted
// as schema.org BreadcrumbList, next to whatever JSON-LD the page supplies.
import Base from './Base.astro';
import AppCta from '../components/directory/AppCta.astro';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  crumbs: Crumb[];
  jsonLd?: object[];
  /** The closing "get the app" panel; pages with their own app section turn it off. */
  cta?: boolean;
}
const { title, description, crumbs, jsonLd = [], cta = true } = Astro.props;

const site = Astro.site!;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, site).href,
  })),
};
const ld = [breadcrumbLd, ...jsonLd];
---

<Base title={title} description={description}>
  {ld.map((obj) => (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))}
  <script slot="head" is:inline>
    try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
  </script>
  <meta slot="head" name="color-scheme" content="light dark" />
  <meta slot="head" name="theme-color" content="#f3f5ee" media="(prefers-color-scheme: light)" />
  <meta slot="head" name="theme-color" content="#0f1923" media="(prefers-color-scheme: dark)" />
  <style slot="head" is:global>
    @font-face {
      font-family: 'Montserrat';
      font-style: normal;
      font-weight: 800 900;
      font-display: swap;
      src: url(/fonts/montserrat-latin.woff2) format('woff2');
    }
    @font-face {
      font-family: 'Nunito Sans';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url(/fonts/nunito-sans-latin.woff2) format('woff2');
    }
    :root {
      color-scheme: light;
      --bg: #f3f5ee;
      --card: #ffffff;
      --row: #f2f4ee;
      --ink: #13221a;
      --muted: #5b675e;
      --border: #e1e6da;
      --accent: #c8f135;
      --on-accent: #13221a;
      /* Lime is a fill only on light; text and marks in the accent use this. */
      --accent-ink: #3d6b1f;
      --strong: #13221a;
      --on-strong: #ffffff;
      /* Chosen things: the header button, a picked night. */
      --pick: #13221a;
      --on-pick: #ffffff;
      --bar-on: #3f7a2a;
      --bar-off: #d9ddd3;
      --tag-bg: #e8f7c0;
      --tag-ink: #33520f;
      --plain-bg: #eceee8;
      --warn-bg: #fde6e1;
      --warn-ink: #9a3324;
      --panel: #13221a;
      --panel-head: #c8f135;
      --panel-ink: #f3f5ee;
      --panel-muted: #b9c4bb;
      --panel-btn: #c8f135;
      --panel-btn-ink: #13221a;
      --head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --body: 'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    /* Dark: the system setting unless the visitor chose light, or the toggle. */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) {
        color-scheme: dark;
        --bg: #0f151c;
        --card: #171e27;
        --row: #1f2832;
        --ink: #f2f5f7;
        --muted: #98a3b0;
        --border: #283340;
        --on-accent: #0f151c;
        --accent-ink: #c8f135;
        --strong: #2b3542;
        --on-strong: #f2f5f7;
        --pick: #c8f135;
        --on-pick: #0f151c;
        --bar-on: #c8f135;
        --bar-off: #34404e;
        --tag-bg: rgba(200, 241, 53, 0.14);
        --tag-ink: #d9f77a;
        --plain-bg: #252f3b;
        --warn-bg: rgba(255, 120, 100, 0.14);
        --warn-ink: #ffb4a8;
        --panel: #c8f135;
        --panel-head: #0f151c;
        --panel-ink: #0f151c;
        --panel-muted: #34440f;
        --panel-btn: #0f151c;
        --panel-btn-ink: #c8f135;
      }
    }
    :root[data-theme='dark'] {
      color-scheme: dark;
      --bg: #0f151c;
      --card: #171e27;
      --row: #1f2832;
      --ink: #f2f5f7;
      --muted: #98a3b0;
      --border: #283340;
      --on-accent: #0f151c;
      --accent-ink: #c8f135;
      --strong: #2b3542;
      --on-strong: #f2f5f7;
      --pick: #c8f135;
      --on-pick: #0f151c;
      --bar-on: #c8f135;
      --bar-off: #34404e;
      --tag-bg: rgba(200, 241, 53, 0.14);
      --tag-ink: #d9f77a;
      --plain-bg: #252f3b;
      --warn-bg: rgba(255, 120, 100, 0.14);
      --warn-ink: #ffb4a8;
      --panel: #c8f135;
      --panel-head: #0f151c;
      --panel-ink: #0f151c;
      --panel-muted: #34440f;
      --panel-btn: #0f151c;
      --panel-btn-ink: #c8f135;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--body);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--ink); }
    .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }

    header.top { border-bottom: 1px solid var(--border); }
    header.top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 68px; }
    .brand {
      display: inline-flex; align-items: center; gap: 10px;
      font-family: var(--head); font-weight: 900; font-size: 1.15rem;
      color: var(--ink); text-decoration: none; letter-spacing: -0.01em;
    }
    .brand img { width: 30px; height: 30px; border-radius: 8px; box-shadow: 0 0 0 1px var(--border); }
    header.top nav { display: flex; align-items: center; gap: 22px; }
    header.top nav a { color: var(--ink); text-decoration: none; font-weight: 700; font-size: 0.95rem; white-space: nowrap; }
    .theme {
      display: grid; place-items: center; width: 38px; height: 38px; border-radius: 999px; cursor: pointer;
      background: transparent; color: var(--ink); border: 1px solid var(--border); padding: 0;
    }
    .theme:hover { border-color: var(--muted); }
    .theme .moon, :root[data-theme='dark'] .theme .sun { display: none; }
    :root[data-theme='dark'] .theme .moon { display: block; }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) .theme .sun { display: none; }
      :root:not([data-theme='light']) .theme .moon { display: block; }
    }
    header.top nav a:hover { text-decoration: underline; }
    header.top nav a.pill { background: var(--pick); color: var(--on-pick); border-radius: 999px; padding: 9px 18px; }
    header.top nav a.pill:hover { text-decoration: none; opacity: 0.9; }

    nav.crumbs { font-size: 0.85rem; color: var(--muted); margin: 24px 0 18px; }
    nav.crumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
    nav.crumbs li:not(:last-child)::after { content: '/'; margin-left: 8px; color: var(--muted); }
    nav.crumbs a { color: var(--muted); }
    nav.crumbs a:hover { color: var(--ink); }

    .eyebrow {
      margin: 0 0 6px; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--accent-ink);
    }
    h1 {
      font-family: var(--head); font-weight: 900; line-height: 1.02;
      font-size: clamp(2.4rem, 8vw, 4.4rem); margin: 0 0 14px; letter-spacing: -0.035em;
    }
    h1.long { font-size: clamp(2rem, 6vw, 3.4rem); }
    h2 { font-family: var(--head); font-weight: 800; font-size: 1.4rem; margin: 44px 0 16px; letter-spacing: -0.01em; }
    .lead { color: var(--muted); font-size: 1.06rem; max-width: 34rem; margin: 0; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 18px 20px; }
    .muted { color: var(--muted); }
    .small { font-size: 0.88rem; }

    .tag {
      display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
      font-size: 0.78rem; font-weight: 700; border-radius: 999px; padding: 3px 10px;
      background: var(--plain-bg); color: var(--muted);
    }
    .tag.ok { background: var(--tag-bg); color: var(--tag-ink); }
    .tag.lime { background: var(--accent); color: var(--on-accent); }
    .tag.warn { background: var(--warn-bg); color: var(--warn-ink); }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      text-decoration: none; font-weight: 800; border-radius: 999px; padding: 11px 20px;
      border: 1px solid var(--border); color: var(--ink); background: var(--card); cursor: pointer; font-size: 0.95rem;
    }
    .btn.dark { background: var(--strong); color: var(--on-strong); border-color: var(--strong); }
    .btn.lime { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }

    /* Hero: title on the left, the stat box on the right. */
    .hero { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; }
    .hero > div:first-child { flex: 1 1 420px; min-width: 0; }
    .stats {
      display: flex; background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden;
    }
    .stats div { padding: 14px 18px; min-width: 92px; }
    .stats div + div { border-left: 1px solid var(--border); }
    .stats span { display: block; font-size: 0.8rem; color: var(--muted); }
    .stats b { display: block; font-family: var(--head); font-weight: 900; font-size: 1.5rem; line-height: 1.2; margin-top: 4px; }
    .stats b.text { font-size: 1rem; line-height: 1.3; }

    /* Link cards: nearby areas, nearby clubs, the finder's area lists. */
    .links { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
    .links a {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px;
      text-decoration: none; color: var(--ink); font-weight: 800; line-height: 1.3;
    }
    .links a:hover { border-color: var(--accent-ink); }
    .links a small { display: block; font-weight: 400; color: var(--muted); font-size: 0.82rem; }
    .links a::after { content: '→'; flex: none; font-weight: 400; }

    .note { display: flex; gap: 8px; align-items: flex-start; color: var(--muted); font-size: 0.85rem; margin: 14px 0 0; }

    footer.foot { border-top: 1px solid var(--border); margin-top: 56px; padding: 28px 0 44px; color: var(--muted); font-size: 0.85rem; }
    footer.foot nav { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-bottom: 14px; }
    footer.foot nav a { color: var(--ink); font-weight: 700; text-decoration: none; }
    footer.foot nav a:hover { text-decoration: underline; }
    footer.foot a { color: var(--muted); }
    footer.foot p { margin: 10px 0 0; max-width: 46rem; }

    @media (max-width: 640px) {
      header.top nav { gap: 10px; }
      header.top nav a { font-size: 0.88rem; }
      header.top nav a.pill { padding: 8px 14px; }
      .theme { width: 34px; height: 34px; }
    }
    @media (max-width: 420px) {
      .brand span { display: none; }
      header.top nav a.hide-sm { display: none; }
      .stats { width: 100%; }
      .stats div { flex: 1; min-width: 0; padding: 12px 14px; }
    }
  </style>

  <header class="top">
    <div class="wrap">
      <a class="brand" href="/" aria-label="NextFour home"><img src="/favicon.svg" alt="" width="30" height="30" /><span>NextFour</span></a>
      <nav aria-label="Main">
        <a href="/badminton.html">Find badminton</a>
        <a class="hide-sm" href="/how-it-works.html">How it works</a>
        <button type="button" class="theme" id="theme" aria-label="Switch between light and dark">
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        </button>
        <a class="pill" href="/get.html">Get the app</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c, i) => (
          <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
        ))}
      </ol>
    </nav>
    <slot />
    {cta && <AppCta />}
  </main>

  <footer class="foot">
    <div class="wrap">
      <nav aria-label="Footer">
        <a href="/">Home</a>
        <a href="/badminton.html">Badminton clubs</a>
        <a href="/how-it-works.html">How it works</a>
        <a href="/privacy.html">Privacy</a>
        <a href="/terms.html">Terms</a>
        <a href="/support.html">Support</a>
      </nav>
      <p>
        Club times come from published information and every page says when it was last checked.
        Spotted something wrong? Email <a href="mailto:clubs@nextfour.app">clubs@nextfour.app</a>.
        Clubs can ask for their page to be corrected or removed at the same address.
      </p>
      <p>Council areas and postcode districts: contains OS data © Crown copyright and database right 2024; contains Royal Mail data © Royal Mail copyright and database right 2024; source: Office for National Statistics, licensed under the Open Government Licence v3.0.</p>
      <p>&copy; 2026 NextFour</p>
    </div>
  </footer>
  <script is:inline>
    document.getElementById('theme').addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    });
  </script>
</Base>
