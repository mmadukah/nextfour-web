---
// Layout for the club directory (/badminton.html and everything under
// /badminton/). Design: REDESIGN-BRIEF (Archivo, the lime brand accent).
// Light or dark follows the visitor's system setting until they press the
// toggle (ThemeToggle, kept in localStorage; Base applies it before paint).
// Every colour is a token below, set for each theme.
//
// Every page passes its breadcrumb trail; it is drawn at the top and emitted
// as schema.org BreadcrumbList, next to whatever JSON-LD the page supplies.
//
// Also the frame for How it works (en and fr): `lang` switches the chrome's
// words, `footer: 'site'` keeps that page's own footer (with the account
// deletion link) instead of the directory's data notes, and `languages` puts
// the English/Français pills beside the breadcrumb.
import Base from './Base.astro';
import AppFeatures from '../components/directory/AppFeatures.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LogoMark from '../components/LogoMark.astro';
import '../styles/club-card.css';
import { getDirectory } from '../data/directory';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  crumbs: Crumb[];
  jsonLd?: object[];
  /** The closing app block (AppFeatures, players' banner); pages with their own turn it off. */
  cta?: boolean;
  /** The header link marked as the current page. */
  current?: 'finder' | 'how';
  lang?: 'en' | 'fr';
  footer?: 'directory' | 'site';
  /** Language versions of this page, for the pills and hreflang links. */
  languages?: { lang: string; label: string; href: string }[];
  /** A shorter line for link previews (Base's og:description). */
  ogDescription?: string;
}
const {
  title, description, crumbs, jsonLd = [], cta = true, current, lang = 'en', footer = 'directory', languages = [], ogDescription,
} = Astro.props;

const WORDS = {
  en: {
    home: 'NextFour home', main: 'Main', crumbs: 'Breadcrumb', foot: 'Footer', language: 'Language',
    find: 'Find badminton', how: 'How it works', get: 'Get the app',
    links: [['Home', '/'], ['Badminton clubs', '/badminton.html'], ['How it works', '/how-it-works.html'],
      ['Privacy', '/privacy.html'], ['Terms', '/terms.html'], ['Support', '/support.html']],
    deletion: ['Account and data deletion', '/delete-account.html'],
  },
  fr: {
    home: 'Accueil NextFour', main: 'Principal', crumbs: 'Fil d’Ariane', foot: 'Pied de page', language: 'Langue',
    // Short, so the header stays on one line on a phone.
    find: 'Trouver un club', how: 'Comment ça marche', get: 'Télécharger',
    links: [['Accueil', '/fr/'], ['Clubs de badminton', '/badminton.html'], ['Comment ça marche', '/fr/how-it-works.html'],
      ['Politique de confidentialité', '/fr/privacy.html'], ['Conditions générales', '/fr/terms.html'], ['Assistance', '/fr/support.html']],
    deletion: ['Suppression du compte et des données', '/fr/delete-account.html'],
  },
}[lang];
// Drop-in data is the operators' OpenActive feeds, under CC BY 4.0: the footer
// credits each one, links the licence and says what was changed.
const operators = footer === 'directory' ? (await getDirectory()).operators : [];
const footerLinks = footer === 'site' ? [...WORDS.links, WORDS.deletion] : WORDS.links;

const site = Astro.site!;
const alternates = languages.length
  ? [...languages.map((l) => ({ hreflang: l.lang, href: new URL(l.href, site).href })),
    { hreflang: 'x-default', href: new URL(languages[0].href, site).href }]
  : [];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, site).href,
  })),
};
const ld = [breadcrumbLd, ...jsonLd];
---

<Base title={title} description={description} lang={lang} alternates={alternates} ogDescription={ogDescription}>
  {ld.map((obj) => (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))}
  <style slot="head" is:global>
    @font-face {
      font-family: 'Archivo';
      font-style: normal;
      font-weight: 400 800;
      font-stretch: 62% 125%;
      font-display: swap;
      src: url(/fonts/archivo-latin.woff2) format('woff2');
    }
    :root {
      color-scheme: light;
      --bg: #F3F5EF; --surface: #FFFFFF; --row: #F3F5EF; --line: #DCE2D8; --line-strong: #B9C4B4;
      --ink: #12261C; --muted: #50605A; --body: #33443B; --eyebrow: #3B6B2E; --link-hover: #3B6B2E;
      --sel-bg: #12261C; --sel-fg: #C8F135; --chip-bg: #12261C; --chip-fg: #F3F5EF; --hl-bg: #C8F135; --hl-fg: #12261C;
      --seg-on: #3B6B2E; --seg-off: #D3DACF; --tag-bg: #E9F7C2; --tag-fg: #2C4A12; --tag2-bg: #ECEFEA; --tag2-fg: #50605A;
      --alert-bg: #FDE6E1; --alert-fg: #9A3324; --warn-bg: #FFF4D6; --warn-fg: #6A4A00;
      --btn-bg: #12261C; --btn-fg: #F3F5EF; --logo-bg: #12261C; --logo-fg: #C8F135; --empty-day: #5D6B64;
      --cta-bg: #12261C; --cta-head: #C8F135; --cta-body: #D5DDD3; --cta-btn-bg: #C8F135; --cta-btn-fg: #12261C; --cta-btn2: #F3F5EF;
      --font: 'Archivo', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      --pad: clamp(16px, 4vw, 40px);
    }
    /* Dark: the system setting unless the visitor chose light, or the toggle. */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) {
        color-scheme: dark;
        --bg: #0F1720; --surface: #18212B; --row: #1F2934; --line: #2A3644; --line-strong: #3E4D5E;
        --ink: #EEF2F5; --muted: #9EABB8; --body: #C6CFD8; --eyebrow: #C8F135; --link-hover: #C8F135;
        --sel-bg: #C8F135; --sel-fg: #0F1720; --chip-bg: #2C3947; --chip-fg: #EEF2F5; --hl-bg: #C8F135; --hl-fg: #0F1720;
        --seg-on: #A8D84A; --seg-off: #34404D; --tag-bg: #26340F; --tag-fg: #D4F27A; --tag2-bg: #232D38; --tag2-fg: #9EABB8;
        --alert-bg: #3A1F1C; --alert-fg: #FFB4A8; --warn-bg: #3A2F12; --warn-fg: #F2D589;
        --btn-bg: #C8F135; --btn-fg: #0F1720; --logo-bg: #C8F135; --logo-fg: #0F1720; --empty-day: #7F8C99;
        --cta-bg: #C8F135; --cta-head: #0F1720; --cta-body: #2A3A1A; --cta-btn-bg: #0F1720; --cta-btn-fg: #C8F135; --cta-btn2: #0F1720;
      }
    }
    :root[data-theme='dark'] {
      color-scheme: dark;
      --bg: #0F1720; --surface: #18212B; --row: #1F2934; --line: #2A3644; --line-strong: #3E4D5E;
      --ink: #EEF2F5; --muted: #9EABB8; --body: #C6CFD8; --eyebrow: #C8F135; --link-hover: #C8F135;
      --sel-bg: #C8F135; --sel-fg: #0F1720; --chip-bg: #2C3947; --chip-fg: #EEF2F5; --hl-bg: #C8F135; --hl-fg: #0F1720;
      --seg-on: #A8D84A; --seg-off: #34404D; --tag-bg: #26340F; --tag-fg: #D4F27A; --tag2-bg: #232D38; --tag2-fg: #9EABB8;
      --alert-bg: #3A1F1C; --alert-fg: #FFB4A8; --warn-bg: #3A2F12; --warn-fg: #F2D589;
      --btn-bg: #C8F135; --btn-fg: #0F1720; --logo-bg: #C8F135; --logo-fg: #0F1720; --empty-day: #7F8C99;
      --cta-bg: #C8F135; --cta-head: #0F1720; --cta-body: #2A3A1A; --cta-btn-bg: #0F1720; --cta-btn-fg: #C8F135; --cta-btn2: #0F1720;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--bg); color: var(--ink);
      font-family: var(--font); font-size: 16px; line-height: 1.5;
      -webkit-font-smoothing: antialiased; transition: background 0.2s, color 0.2s;
    }
    button, input, select { font-family: inherit; }
    a { color: var(--ink); }
    a:hover { color: var(--link-hover); }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 var(--pad); }

    header.top { border-bottom: 1px solid var(--line); }
    header.top .wrap {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
      padding-top: 18px; padding-bottom: 18px;
    }
    .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .brand .tile {
      width: 32px; height: 32px; border-radius: 8px; background: var(--logo-bg); color: var(--logo-fg);
      display: flex; align-items: center; justify-content: center;
    }
    .brand .word { font-weight: 800; font-size: 20px; font-stretch: 112%; letter-spacing: -0.01em; }
    header.top nav { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; font-weight: 600; font-size: 15px; }
    header.top nav a { text-decoration: none; white-space: nowrap; }
    header.top nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
    header.top nav a.pill { background: var(--btn-bg); color: var(--btn-fg); padding: 10px 18px; border-radius: 999px; }
    header.top nav a.pill:hover { opacity: 0.9; }

    nav.crumbs { padding-top: 28px; font-size: 14px; color: var(--muted); }
    nav.crumbs a { color: var(--muted); }
    nav.crumbs a:hover { color: var(--link-hover); }
    nav.crumbs .sep { margin: 0 8px; }
    .crumb-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; }
    .langs { display: flex; gap: 6px; padding-top: 28px; font-size: 14px; }
    .langs a { padding: 2px 10px; border-radius: 999px; border: 1px solid var(--line-strong); text-decoration: none; color: var(--muted); }
    .langs a[aria-current='true'] { background: var(--chip-bg); color: var(--chip-fg); border-color: var(--chip-bg); font-weight: 700; }

    .eyebrow { margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--eyebrow); }
    h1 { margin: 0; font-weight: 800; letter-spacing: -0.03em; }
    .intro { margin: 20px 0 0; max-width: 560px; font-size: 18px; color: var(--body); }
    .h-section { margin: 0 0 16px; font-size: 22px; font-weight: 800; font-stretch: 106%; }
    .h-results { margin: 0; font-size: 28px; font-weight: 800; font-stretch: 108%; letter-spacing: -0.01em; }
    .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 20px; }
    .muted { color: var(--muted); }

    .tag { font-size: 13px; font-weight: 600; padding: 5px 10px; border-radius: 999px; background: var(--tag2-bg); color: var(--tag2-fg); white-space: nowrap; }
    .tag.ok { background: var(--tag-bg); color: var(--tag-fg); }
    .tag.lime { background: var(--hl-bg); color: var(--hl-fg); }
    .tag.alert { background: var(--alert-bg); color: var(--alert-fg); }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 20px;
      border-radius: 999px; border: 1.5px solid var(--ink); background: transparent; color: var(--ink);
      font-weight: 700; font-size: 15px; text-decoration: none; cursor: pointer;
    }

    /* Hero: title, then the stat card, which wraps under it on a phone. */
    .hero { padding: 28px 0 40px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px; }
    .hero > div { flex: 999 1 520px; min-width: 0; }
    .stats {
      /* About 105px a cell (--cells, set by the page when it isn't 3), so a fourth cell widens the card. */
      flex: 1 1 calc(var(--cells, 3) * 105px); margin: 0; display: grid; grid-auto-columns: minmax(0, 1fr); grid-auto-flow: column;
      border: 1px solid var(--line); border-radius: 16px; background: var(--surface); overflow: hidden;
    }
    .stats > div { padding: 18px 18px 16px; }
    .stats > div + div { border-left: 1px solid var(--line); }
    .stats dt { font-size: 13px; color: var(--muted); white-space: nowrap; }
    .stats dd { margin: 4px 0 0; font-size: 32px; font-weight: 800; font-stretch: 112%; line-height: 1; }
    .stats dd.date { margin-top: 6px; font-size: 17px; font-weight: 700; line-height: 1.2; white-space: nowrap; }

    /* Link cards: nearby areas and clubs. */
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
    .cards a {
      display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px;
      background: var(--surface); border: 1px solid var(--line); border-radius: 12px; text-decoration: none; font-weight: 600;
    }
    .cards a small { display: block; font-weight: 400; font-size: 13px; color: var(--muted); }
    section.near { padding: 32px 0 48px; border-top: 1px solid var(--line); }

    .note { margin: 20px 0 0; display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); }

    footer.foot { border-top: 1px solid var(--line); }
    footer.foot .wrap { padding-top: 32px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 16px; font-size: 13px; color: var(--muted); }
    footer.foot nav { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 14px; font-weight: 600; }
    footer.foot nav a { color: var(--body); text-decoration: none; }
    footer.foot p { margin: 0; max-width: 760px; }
    footer.foot p a { color: var(--muted); }

    @media (max-width: 640px) {
      .stats > div { padding: 14px 12px 12px; }
      header.top nav { gap: 8px 14px; }
      header.top nav .hide-sm { display: none; }
    }
    @media (max-width: 400px) {
      .brand .word { display: none; }
    }
  </style>

  <header class="top">
    <div class="wrap">
      <a class="brand" href={lang === 'fr' ? '/fr/' : '/'} aria-label={WORDS.home}>
        <span class="tile" aria-hidden="true">
          <LogoMark size={22} />
        </span>
        <span class="word">NextFour</span>
      </a>
      <nav aria-label={WORDS.main}>
        <a href="/badminton.html" aria-current={current === 'finder' ? 'page' : undefined}>{WORDS.find}</a>
        <a class="hide-sm" href={lang === 'fr' ? '/fr/how-it-works.html' : '/how-it-works.html'} aria-current={current === 'how' ? 'page' : undefined}>{WORDS.how}</a>
        <ThemeToggle />
        <a class="pill" href="/get.html?src=header">{WORDS.get}</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <div class="crumb-row">
      <nav class="crumbs" aria-label={WORDS.crumbs}>
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">/</span>}
            {i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          </>
        ))}
      </nav>
      {languages.length > 0 && (
        <nav class="langs" aria-label={WORDS.language}>
          {languages.map((l) => <a href={l.href} lang={l.lang} hreflang={l.lang} aria-current={l.lang === lang ? 'true' : undefined}>{l.label}</a>)}
        </nav>
      )}
    </div>
    <slot />
    {cta && <AppFeatures />}
  </main>

  <footer class="foot">
    <div class="wrap">
      <nav aria-label={WORDS.foot}>
        {footerLinks.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      {footer === 'directory' ? (
      <>
      <p>
        Club times come from published information and every page says when it was last checked.
        Spotted something wrong? Email <a href="mailto:clubs@nextfour.app">clubs@nextfour.app</a>.
        Clubs can ask for their page to be corrected or removed at the same address.
      </p>
      {operators.length > 0 && (
        <p>
          Drop-in sessions: data from {operators.join(', ')}, published through OpenActive and licensed under
          {' '}<a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener">CC BY 4.0</a>.
          Session titles are shortened and sessions grouped by venue.
        </p>
      )}
      <p>Council areas and postcode districts: contains OS data © Crown copyright and database right 2024; contains Royal Mail data © Royal Mail copyright and database right 2024; source: Office for National Statistics, licensed under the Open Government Licence v3.0.</p>
      <p>&copy; 2026 NextFour</p>
      </>
      ) : (
        <p>&copy; 2026 NextFour. All rights reserved.</p>
      )}
    </div>
  </footer>
</Base>
